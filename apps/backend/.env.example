# --- Database (BunnyDB / libsql) ---
BUNNY_DATABASE_URL="libsql://..."
BUNNY_DATABASE_AUTH_TOKEN="..."
# optional read-only token
BUNNY_DATABASE_READ_ONLY_AUTH_TOKEN=""

# --- Auth ---
# Long random secret. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET="change-me"
# Public URL of the backend (in prod: the Magic Container URL).
PUBLIC_BACKEND_URL="http://localhost:3000"
# Public URL of the frontend (trusted origin).
PUBLIC_FRONTEND_URL="http://localhost:4321"

# --- SMTP (one-time-code email delivery) ---
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Quietjar <no-reply@example.com>"

# --- Server ---
PORT="3000"
