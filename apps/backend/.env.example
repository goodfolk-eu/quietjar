# Copy to apps/backend/.env.development for local work.

# Any libsql URL. A local file works for development.
BUNNY_DATABASE_URL="file:local.db"
BUNNY_DATABASE_AUTH_TOKEN=""

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=""

PUBLIC_BACKEND_URL="http://localhost:4321"
PUBLIC_FRONTEND_URL="http://localhost:4321"
TRUSTED_ORIGINS="http://localhost:4321"

# Stripe test-mode keys from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Optional. Without these, sign-in codes are printed to the console.
SCALEWAY_ACCESS_KEY=""
SCALEWAY_SECRET_KEY=""
SCALEWAY_PROJECT_ID=""
SMTP_FROM=""
