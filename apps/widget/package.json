{
  "name": "@quietjar/widget",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "scripts": {
    "dev": "bun dev.ts",
    "typecheck": "tsc --noEmit",
    "bundle": "bun build src/index.ts --target=browser --format=iife --minify",
    "build": "bun run typecheck && bun run bundle -- --outfile=dist/quietjar.js",
    "test": "bun test"
  },
  "exports": {
    ".": "./src/index.ts",
    "./embed": "./src/mount.ts",
    "./goal": "./src/goal.ts",
    "./config": "./src/config.ts"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.11.15",
    "bun-types": "latest"
  }
}
