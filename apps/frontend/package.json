{
  "name": "@quietjar/frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "typecheck": "astro check && tsc --noEmit",
    "build:embed": "cd ../widget && bun run typecheck && bun run bundle -- --outfile=../frontend/public/js/latest/widget.js",
    "build": "bun run build:embed && bun run typecheck && astro build",
    "deploy": "bun deploy.ts",
    "preview": "astro preview",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "@elysiajs/eden": "^1.4.9",
    "@fontsource-variable/bricolage-grotesque": "^5.2.5",
    "@fontsource-variable/inter": "^5.2.5",
    "@iconify-json/bx": "^1.2.2",
    "@iconify-json/simple-icons": "^1.2.28",
    "@quietjar/backend": "workspace:*",
    "@quietjar/widget": "workspace:*",
    "@tailwindcss/typography": "^0.5.16",
    "@tailwindcss/vite": "^4.1.0",
    "apexcharts": "7",
    "astro": "^7.2.4",
    "astro-icon": "^1.1.5",
    "astro-robots-txt": "^1.0.0",
    "better-auth": "^1.7.1",
    "node-html-parser": "^9.0.1",
    "preline": "5",
    "tailwindcss": "^4.1.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/bun": "^1.4.0"
  }
}
