---
const faqs = [
  {
    q: "What is QuietJar?",
    a: "A small, polished donate button you drop onto your own website, so your supporters can pay without leaving your page.",
  },
  {
    q: "Do I need a separate account or page for my visitors?",
    a: "No. The button works right on your site. There is an optional hosted page for people who prefer one, but you do not need it.",
  },
  {
    q: "How is this different from the donation tools I already know?",
    a: "Most tools send your visitors over to someone else's page. QuietJar keeps them on yours. Fewer steps, no drop-off, more of them actually follow through.",
  },
  {
    q: "Will it slow down my site?",
    a: "No. QuietJar is built to be fast. It loads lightly and does not weigh your page down.",
  },
  {
    q: "What does it cost?",
    a: "There is no monthly fee and no plans to compare. QuietJar takes a small share of what you actually receive, so it costs you nothing until it earns you something.",
  },
  {
    q: "What payment methods can my supporters use?",
    a: "The ones people actually reach for. Apple Pay, cards, and other common options, right where they already pay. Paying feels effortless.",
  },
  {
    q: "What happens after someone supports me?",
    a: "QuietJar steps back. It stops pestering people who have already given, so your biggest supporters get thanked instead of nagged.",
  },
  {
    q: "How do I add it to my site?",
    a: "Paste a small piece of code, pick your design, and it is live. It takes minutes, and it fits the look of your page.",
  },
];
---

<section id="faq" class="mt-24 md:mt-32 scroll-mt-24">
  <div class="max-w-3xl mx-auto text-center">
    <p class="text-sm font-semibold tracking-wide text-slate-400 uppercase">FAQ</p>
    <h2 class="mt-3 text-4xl lg:text-5xl font-bold lg:tracking-tight">
      Questions, answered.
    </h2>
  </div>

  <div class="mt-12 grid md:grid-cols-2 gap-x-10 gap-y-8 max-w-4xl mx-auto">
    {
      faqs.map((item) => (
        <div>
          <h3 class="font-semibold text-lg">{item.q}</h3>
          <p class="text-slate-500 mt-2 leading-relaxed">{item.a}</p>
        </div>
      ))
    }
  </div>
</section>
