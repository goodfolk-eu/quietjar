---
import { dictionary } from "@/i18n/t";

const copy = dictionary(Astro.currentLocale ?? "en");
const faq = copy.faq;
const faqs = faq.items;
---

<section id="faq" class="border-y border-qj-line bg-qj-surface">
  <div class="mx-auto grid max-w-[1200px] grid-cols-1 items-start gap-18 px-10 pb-24 pt-[88px] lg:grid-cols-[minmax(0,0.62fr)_minmax(0,1fr)]">
    <div class="flex flex-col gap-3.5 lg:sticky lg:top-[104px]">
      <span class="text-[13.5px] font-medium text-qj-green">{faq.eyebrow}</span>
      <h2 class="text-balance font-display text-[44px] font-bold leading-[1.05] tracking-[-0.03em] text-qj-ink">
        {faq.title}
      </h2>
    </div>

    <div>
      {
        faqs.map((item) => (
          <div class="border-t border-qj-line-3 py-6 last:border-b last:border-qj-line-3">
            <div class="flex flex-col gap-2">
              <span class="font-display text-[19px] font-bold tracking-[-0.02em] text-qj-ink">{item.q}</span>
              <span class="text-pretty text-[15.5px] leading-[1.62] text-qj-ink-2">{item.a}</span>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>