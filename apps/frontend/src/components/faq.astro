---
import { dictionary } from "@/i18n/t";

const copy = dictionary(Astro.currentLocale ?? "en");
const faq = copy.faq;
const faqs = faq.items;
---

<section id="faq" class="mt-24 md:mt-32 scroll-mt-24">
  <div class="max-w-3xl mx-auto text-center">
    <p class="text-sm font-semibold tracking-wide text-slate-600 uppercase">{faq.eyebrow}</p>
    <h2 class="mt-3 text-4xl lg:text-5xl font-bold lg:tracking-tight">
      {faq.title}
    </h2>
  </div>

  <div class="mt-12 grid md:grid-cols-2 gap-x-10 gap-y-8 max-w-4xl mx-auto">
    {
      faqs.map((item) => (
        <div>
          <h3 class="font-semibold text-lg">{item.q}</h3>
          <p class="text-slate-600 mt-2 leading-relaxed">{item.a}</p>
        </div>
      ))
    }
  </div>
</section>
