---
interface FaqItem {
  "@type": string;
  name: string;
  acceptedAnswer: { "@type": string; text: string };
  linkLabel?: string;
  linkHref?: string;
}

interface Props {
  eyebrow?: string;
  title: string;
  items: FaqItem[];
  gridClass?: string;
  titleClass?: string;
}

const {
  eyebrow,
  title,
  items,
  gridClass = "mx-auto grid max-w-[1180px] grid-cols-1 items-start gap-[72px] border-t border-qj-line px-10 pt-[clamp(72px,9vw,120px)] pb-[clamp(72px,9vw,120px)] lg:grid-cols-[minmax(0,0.62fr)_minmax(0,1fr)]",
  titleClass = "text-balance font-display text-[clamp(28px,3.4vw,44px)] font-bold leading-[1.05] tracking-[-0.028em] text-qj-ink",
} = Astro.props;
---

<section id="faq">
  <div class:list={[gridClass]}>
    {
      eyebrow ? (
        <div class="flex flex-col gap-3.5 lg:sticky lg:top-[104px]">
          <span class="text-[13.5px] font-semibold tracking-[-0.005em] text-qj-accent">{eyebrow}</span>
          <h2 class:list={[titleClass]}>{title}</h2>
        </div>
      ) : (
        <h2 class:list={[titleClass]}>{title}</h2>
      )
    }

    <div>
      {
        items.map((item) => (
          <details class="group border-t border-qj-line-soft py-6 last:border-b last:border-qj-line-soft">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-display text-[19px] font-bold tracking-[-0.022em] text-qj-ink [&::-webkit-details-marker]:hidden">
              {item.name}
              <span
                class="shrink-0 text-[22px] font-normal leading-none text-qj-body transition-transform duration-200 group-open:rotate-45"
                aria-hidden="true">
                +
              </span>
            </summary>
            <div class="flex flex-col gap-2 pt-3">
              <span class="text-pretty text-[15.5px] leading-[1.62] text-qj-body">{item.acceptedAnswer.text}</span>
              {item.linkLabel && item.linkHref && (
                <a href={item.linkHref} class="self-start text-[14px] font-semibold text-qj-accent transition hover:text-qj-ink">
                  {item.linkLabel}
                </a>
              )}
            </div>
          </details>
        ))
      }
    </div>
  </div>
</section>
