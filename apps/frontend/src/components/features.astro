---
import { dictionary } from "@/i18n/t";

const copy = dictionary(Astro.currentLocale ?? "en");
const features = copy.features;
---

<section class="pt-24 md:pt-32" id="features">
  <div class="text-center max-w-3xl mx-auto">
    <p class="text-sm font-semibold tracking-wide text-slate-600 uppercase">{features.eyebrow}</p>
    <h2 class="mt-3 text-4xl lg:text-5xl font-bold lg:tracking-tight">
      {features.title}
    </h2>
  </div>

  <div class="mt-14 grid lg:grid-cols-2 gap-10 items-stretch">
    <!-- Before: leaky redirect -->
    <div class="rounded-lg border border-slate-200 bg-white p-8 opacity-80">
      <h3 class="font-semibold text-slate-900">{features.oldWayTitle}</h3>
      <p class="text-slate-600 text-sm mt-1">{features.oldWaySubtitle}</p>
      <ol class="mt-6 space-y-3">
        <li class="rounded-md border border-slate-200 px-4 py-3 text-sm text-slate-600">{features.oldWaySteps[0]}</li>
        <li aria-hidden="true" class="text-center text-slate-600 text-xs">&#8595;</li>
        <li class="rounded-md border border-slate-200 px-4 py-3 text-sm text-slate-600">{features.oldWaySteps[1]}</li>
        <li aria-hidden="true" class="text-center text-slate-600 text-xs">&#8595; &#8595;</li>
        <li class="rounded-md border border-slate-200 px-4 py-3 text-sm text-slate-600">{features.oldWaySteps[2]}</li>
        <li aria-hidden="true" class="text-center text-slate-600 text-xs">&#8595;</li>
        <li class="rounded-md border border-dashed border-red-300 bg-red-50 px-4 py-3 text-sm text-red-700">{features.oldWaySteps[3]}</li>
        <li aria-hidden="true" class="text-center text-slate-600 text-xs">&#8595;</li>
        <li class="rounded-md border border-slate-200 px-4 py-3 text-sm text-slate-600 line-through">{features.oldWaySteps[4]}</li>
      </ol>
    </div>

    <!-- After: on-page flow -->
    <div class="rounded-lg border-2 border-black bg-white p-8">
      <h3 class="font-semibold text-black">{features.withTitle}</h3>
      <p class="text-slate-600 text-sm mt-1">{features.withSubtitle}</p>
      <ol class="mt-6 space-y-3">
        <li class="rounded-md border border-slate-200 px-4 py-3 text-sm text-slate-600">{features.withSteps[0]}</li>
        <li aria-hidden="true" class="text-center text-slate-600 text-xs">&#8595; in two taps</li>
        <li class="rounded-md border-2 border-black bg-black px-4 py-3 text-sm text-white">{features.withSteps[1]}</li>
        <li aria-hidden="true" class="text-center text-slate-600 text-xs">&#8595;</li>
        <li class="rounded-md border border-green-300 bg-green-50 px-4 py-3 text-sm text-green-700">{features.withSteps[2]}</li>
      </ol>
    </div>
  </div>

  <div class="mt-12 max-w-3xl mx-auto text-center">
    <p class="text-lg text-slate-600">
      {features.closing}
    </p>
  </div>
</section>
