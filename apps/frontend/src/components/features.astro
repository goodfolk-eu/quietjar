---
import GoalScene from "@/components/scenes/goalscene.astro";
import OldWayScene from "@/components/scenes/oldwayscene.astro";
import { dictionary } from "@/i18n/t";

const copy = dictionary(Astro.currentLocale ?? "en");
const features = copy.features;
const logos = copy.logos;
---

<section id="how">
  <div class="mx-auto flex max-w-[1180px] flex-col gap-[44px] px-10 pt-[clamp(72px,9vw,120px)] pb-[clamp(72px,9vw,120px)]">
    <div class="flex flex-col gap-3.5">
      <span class="text-[13.5px] font-semibold tracking-[-0.005em] text-qj-accent">{features.eyebrow}</span>
      <h2 class="text-balance font-display text-[clamp(28px,3.4vw,44px)] font-bold leading-[1.05] tracking-[-0.028em] text-qj-ink">
        {features.title}
      </h2>
    </div>

    <div class="grid gap-x-10 gap-y-14 lg:grid-cols-2">
      <div class="flex flex-col gap-7">
        <div class="flex flex-col gap-1.5">
          <span class="font-mono text-[11.5px] uppercase tracking-[0.08em] text-qj-body">{features.oldWay.label}</span>
          <span class="font-display text-[22px] font-bold tracking-[-0.022em] text-qj-ink">{features.oldWay.caption}</span>
        </div>
        <OldWayScene />
      </div>

      <div class="flex flex-col gap-7">
        <div class="flex flex-col gap-1.5">
          <span class="font-mono text-[11.5px] uppercase tracking-[0.08em] text-qj-accent">{features.withGoal.label}</span>
          <span class="font-display text-[22px] font-bold tracking-[-0.022em] text-qj-ink">{features.withGoal.caption}</span>
        </div>
        <GoalScene />
      </div>
    </div>

    <div class="flex flex-wrap items-center justify-between gap-8 lg:flex-nowrap">
      <span class="max-w-[52ch] shrink text-[15px] leading-[1.5] text-qj-body">{logos.text}</span>
      <div class="flex flex-wrap items-center gap-2.5 font-mono text-[12px] text-qj-body lg:shrink-0">
        {logos.methods.map((method) => (
          <span class="rounded-sm border border-qj-line-card px-3 py-[7px]">{method}</span>
        ))}
        <span class="rounded-sm border border-qj-line-card px-3 py-[7px] text-qj-accent">{logos.moreLabel}</span>
      </div>
    </div>
  </div>
</section>
