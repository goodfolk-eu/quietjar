---
import { dictionary } from "@/i18n/t";
import Scene from "./scene.astro";
import SceneBrowser from "./scenebrowser.astro";
import SceneButton from "./scenebutton.astro";
import SceneCursor from "./scenecursor.astro";
import ScenePage from "./scenepage.astro";

const copy = dictionary(Astro.currentLocale ?? "en");
const polite = copy.polite;
const scene = polite.scene;
---

<Scene label={polite.alt} class="flex flex-col gap-6">
  <SceneBrowser url={copy.scenes.url} class="h-[300px]">
    <ScenePage />

    <div
      class="pop absolute right-4 bottom-16 flex w-[210px] flex-col gap-2.5 rounded-lg border border-qj-line-card bg-white p-3 shadow-[0_18px_36px_-20px_rgba(20,32,28,0.35)]">
      <span class="text-[12px] leading-4 font-semibold text-qj-ink">{scene.headline}</span>
      <div class="grid h-8 grid-cols-3 gap-1.5">
        {
          scene.amounts.map((amount, i) => (
            <span
              class:list={[
                "flex items-center justify-center rounded-sm border border-qj-line-card text-[12px] font-semibold text-qj-ink",
                i === 1 && "pick",
              ]}>
              {amount}
            </span>
          ))
        }
      </div>
      <span class="pay flex h-8 items-center justify-center rounded-sm bg-qj-ink text-[12px] font-semibold text-white"
        >{scene.pay}</span
      >
    </div>

    <span class="thanks absolute right-4 bottom-4 flex items-center gap-2 rounded-full border border-qj-line-card bg-white px-4 py-2 text-[13px] font-semibold text-qj-ink shadow-[0_12px_22px_-12px_rgba(20,32,28,0.4)]">
      <span class="text-qj-accent" aria-hidden="true">♥</span>
      {scene.thanks}
    </span>

    <span class="rest absolute right-4 bottom-4 flex w-[190px] flex-col gap-1.5 rounded-sm border border-qj-line-card bg-white px-3 py-2 font-mono text-[11px] text-qj-body">
      {scene.resting}
      <span class="h-1 overflow-hidden rounded-full bg-qj-line-soft">
        <span class="rest-bar block h-full rounded-full bg-qj-accent-pale"></span>
      </span>
    </span>

    <div class="absolute right-4 bottom-4 flex flex-col items-end gap-2">
      <span class="back rounded-sm border border-qj-line-card bg-white px-2.5 py-1 font-mono text-[11.5px] text-qj-body">{scene.back}</span>
      <span class="btn block">
        <SceneButton label={copy.scenes.button} />
      </span>
    </div>

    <span class="cursor absolute top-0 left-0"><SceneCursor /></span>
  </SceneBrowser>

  <ol class="grid grid-cols-2 gap-x-6 gap-y-4 sm:grid-cols-4" aria-hidden="true">
    {
      polite.feelSteps.map((step, i) => (
        <li class="step flex flex-col gap-1.5 border-t-2 pt-3 text-[13.5px] leading-[1.45] text-qj-ink">
          <span class="font-mono text-[11.5px] text-qj-accent">0{i + 1}</span>
          {step}
        </li>
      ))
    }
  </ol>
</Scene>

<style>
  /* Base styles are the still frame shown with reduced motion: the button
     resting after a supporter gave. */
  .pop,
  .thanks,
  .back,
  .btn,
  .cursor {
    opacity: 0;
  }

  .step {
    border-color: var(--color-qj-line-soft);
  }

  .step:nth-child(3) {
    border-color: var(--color-qj-accent);
  }

  @media (prefers-reduced-motion: no-preference) {
    .pop,
    .pick,
    .pay,
    .thanks,
    .rest,
    .rest-bar,
    .back,
    .btn,
    .cursor,
    .step {
      animation-duration: 13s;
      animation-timing-function: ease-in-out;
      animation-iteration-count: infinite;
    }

    .pop {
      animation-name: supporter-pop;
    }

    .pick {
      animation-name: supporter-pick;
    }

    .pay {
      animation-name: supporter-pay;
    }

    .thanks {
      animation-name: supporter-thanks;
    }

    .rest {
      animation-name: supporter-rest;
    }

    .rest-bar {
      animation-name: supporter-rest-bar;
      animation-timing-function: linear;
    }

    .back {
      animation-name: supporter-back;
    }

    .btn {
      animation-name: supporter-btn;
    }

    .cursor {
      animation-name: supporter-cursor;
    }

    .step:nth-child(1) {
      animation-name: supporter-step-1;
    }

    .step:nth-child(2) {
      animation-name: supporter-step-2;
    }

    .step:nth-child(3) {
      animation-name: supporter-step-3;
    }

    .step:nth-child(4) {
      animation-name: supporter-step-4;
    }
  }

  @keyframes supporter-cursor {
    0% {
      opacity: 0;
      translate: 30cqw 40cqh;
      scale: 1;
    }
    3% {
      opacity: 1;
    }
    10% {
      translate: calc(100cqw - 84px) calc(100cqh - 36px);
      scale: 1;
    }
    11% {
      scale: 0.85;
    }
    12% {
      translate: calc(100cqw - 84px) calc(100cqh - 36px);
      scale: 1;
    }
    17% {
      translate: calc(100cqw - 125px) calc(100cqh - 140px);
      scale: 1;
    }
    18% {
      scale: 0.85;
    }
    19% {
      translate: calc(100cqw - 125px) calc(100cqh - 140px);
      scale: 1;
    }
    23% {
      translate: calc(100cqw - 125px) calc(100cqh - 98px);
      scale: 1;
    }
    24% {
      scale: 0.85;
    }
    25% {
      translate: calc(100cqw - 125px) calc(100cqh - 98px);
      scale: 1;
      opacity: 1;
    }
    40% {
      translate: 42cqw 55cqh;
      opacity: 1;
    }
    44%,
    100% {
      translate: 42cqw 55cqh;
      opacity: 0;
    }
  }

  @keyframes supporter-btn {
    0%,
    10% {
      opacity: 1;
      scale: 1;
    }
    11% {
      scale: 0.94;
    }
    12%,
    28% {
      opacity: 1;
      scale: 1;
    }
    30%,
    76% {
      opacity: 0;
      scale: 0.85;
    }
    79% {
      opacity: 1;
      scale: 1.06;
    }
    82%,
    100% {
      opacity: 1;
      scale: 1;
    }
  }

  @keyframes supporter-pop {
    0%,
    12% {
      opacity: 0;
      translate: 0 8px;
    }
    14%,
    27% {
      opacity: 1;
      translate: 0 0;
    }
    29%,
    100% {
      opacity: 0;
      translate: 0 8px;
    }
  }

  @keyframes supporter-pick {
    0%,
    18% {
      background: #fff;
      border-color: var(--color-qj-line-card);
    }
    19%,
    100% {
      background: var(--color-qj-mint);
      border-color: var(--color-qj-accent);
    }
  }

  @keyframes supporter-pay {
    0%,
    23.5% {
      scale: 1;
    }
    24.5% {
      scale: 0.95;
    }
    25.5%,
    100% {
      scale: 1;
    }
  }

  @keyframes supporter-thanks {
    0%,
    29% {
      opacity: 0;
      scale: 0.9;
    }
    31%,
    45% {
      opacity: 1;
      scale: 1;
    }
    47%,
    100% {
      opacity: 0;
      scale: 1;
    }
  }

  @keyframes supporter-rest {
    0%,
    47% {
      opacity: 0;
    }
    49%,
    74% {
      opacity: 1;
    }
    76%,
    100% {
      opacity: 0;
    }
  }

  @keyframes supporter-rest-bar {
    0%,
    49% {
      width: 100%;
    }
    74%,
    100% {
      width: 0%;
    }
  }

  @keyframes supporter-back {
    0%,
    79% {
      opacity: 0;
    }
    82%,
    97% {
      opacity: 1;
    }
    100% {
      opacity: 0;
    }
  }

  @keyframes supporter-step-1 {
    0%,
    28% {
      border-color: var(--color-qj-accent);
      opacity: 1;
    }
    30%,
    100% {
      border-color: var(--color-qj-line-soft);
      opacity: 0.45;
    }
  }

  @keyframes supporter-step-2 {
    0%,
    28% {
      border-color: var(--color-qj-line-soft);
      opacity: 0.45;
    }
    30%,
    46% {
      border-color: var(--color-qj-accent);
      opacity: 1;
    }
    48%,
    100% {
      border-color: var(--color-qj-line-soft);
      opacity: 0.45;
    }
  }

  @keyframes supporter-step-3 {
    0%,
    46% {
      border-color: var(--color-qj-line-soft);
      opacity: 0.45;
    }
    48%,
    75% {
      border-color: var(--color-qj-accent);
      opacity: 1;
    }
    77%,
    100% {
      border-color: var(--color-qj-line-soft);
      opacity: 0.45;
    }
  }

  @keyframes supporter-step-4 {
    0%,
    75% {
      border-color: var(--color-qj-line-soft);
      opacity: 0.45;
    }
    77%,
    100% {
      border-color: var(--color-qj-accent);
      opacity: 1;
    }
  }
</style>
