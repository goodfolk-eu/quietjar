---
import { dictionary } from "@/i18n/t";
import Scene from "./scene.astro";
import SceneBrowser from "./scenebrowser.astro";
import SceneButton from "./scenebutton.astro";
import SceneCursor from "./scenecursor.astro";
import ScenePage from "./scenepage.astro";

const copy = dictionary(Astro.currentLocale ?? "en");
const oldWay = copy.features.oldWay;
---

<Scene label={oldWay.alt}>
  <SceneBrowser url={copy.scenes.url} class="h-[250px]">
    <ScenePage />
    <div class="absolute top-4 right-4 grid justify-items-end font-mono text-[11.5px] text-qj-body">
      {
        oldWay.days.map((day) => (
          <span class="day rounded-sm border border-qj-line-card bg-white px-2.5 py-1 [grid-area:1/1]">{day}</span>
        ))
      }
    </div>
    <span class="ghost absolute right-4 bottom-4">
      <SceneButton label={copy.scenes.button} />
    </span>
    <span class="drift drift-a absolute top-0 left-0"><SceneCursor /></span>
    <span class="drift drift-b absolute top-0 left-0"><SceneCursor /></span>
  </SceneBrowser>
</Scene>

<style>
  /* Base styles are the still frame shown with reduced motion: day 90. */
  .day {
    opacity: 0;
  }

  .day:last-child {
    opacity: 1;
  }

  .ghost {
    opacity: 0.3;
    filter: grayscale(1);
  }

  .drift {
    opacity: 0;
  }

  @media (prefers-reduced-motion: no-preference) {
    .day,
    .ghost,
    .drift {
      animation-duration: 9s;
      animation-timing-function: linear;
      animation-iteration-count: infinite;
    }

    .day:nth-child(1) {
      animation-name: oldway-day-1;
    }

    .day:nth-child(2) {
      animation-name: oldway-day-2;
    }

    .day:nth-child(3) {
      animation-name: oldway-day-3;
    }

    .ghost {
      animation-name: oldway-ghost;
      animation-timing-function: ease-in-out;
    }

    .drift-a {
      animation-name: oldway-drift-a;
      animation-timing-function: ease-in-out;
    }

    .drift-b {
      animation-name: oldway-drift-b;
      animation-timing-function: ease-in-out;
    }
  }

  @keyframes oldway-day-1 {
    0%,
    31% {
      opacity: 1;
    }
    33%,
    100% {
      opacity: 0;
    }
  }

  @keyframes oldway-day-2 {
    0%,
    31% {
      opacity: 0;
    }
    33%,
    64% {
      opacity: 1;
    }
    66%,
    100% {
      opacity: 0;
    }
  }

  @keyframes oldway-day-3 {
    0%,
    64% {
      opacity: 0;
    }
    66%,
    100% {
      opacity: 1;
    }
  }

  @keyframes oldway-ghost {
    0%,
    30% {
      opacity: 1;
      filter: grayscale(0);
    }
    40%,
    63% {
      opacity: 0.6;
      filter: grayscale(0.5);
    }
    73%,
    95% {
      opacity: 0.3;
      filter: grayscale(1);
    }
    100% {
      opacity: 1;
      filter: grayscale(0);
    }
  }

  @keyframes oldway-drift-a {
    0%,
    10% {
      opacity: 0;
      translate: -24px 30cqh;
    }
    12% {
      opacity: 1;
    }
    26% {
      translate: calc(100cqw - 90px) calc(100cqh - 44px);
    }
    35% {
      opacity: 1;
      translate: calc(100cqw + 10px) calc(100cqh - 120px);
    }
    36%,
    100% {
      opacity: 0;
      translate: calc(100cqw + 10px) calc(100cqh - 120px);
    }
  }

  @keyframes oldway-drift-b {
    0%,
    52% {
      opacity: 0;
      translate: 40cqw -24px;
    }
    54% {
      opacity: 1;
    }
    66% {
      translate: calc(100cqw - 70px) calc(100cqh - 56px);
    }
    76% {
      opacity: 1;
      translate: 58cqw calc(100cqh + 10px);
    }
    77%,
    100% {
      opacity: 0;
      translate: 58cqw calc(100cqh + 10px);
    }
  }
</style>
