---
interface Props {
  label: string;
}

const { label } = Astro.props;
---

<span
  class="flex items-center gap-2 rounded-full bg-qj-accent py-2 pr-4 pl-3 text-[13px] font-semibold whitespace-nowrap text-white shadow-[0_12px_22px_-12px_rgba(11,107,58,0.7)]">
  <img src="/brand/mark-white.svg" alt="" width="20" height="15" class="h-[15px] w-5" />
  <span class="flex flex-col gap-1">
    {label}
    <slot />
  </span>
</span>
