---
import { dictionary } from "@/i18n/t";

const copy = dictionary(Astro.currentLocale ?? "en");
const auth = copy.auth;
---

<!-- BetterAuth email-OTP sign-in modal. 
     Both "Log in" and "Sign up" open this; passwordless OTP auto-creates
     the user on first successful verification. On success -> /dashboard/. -->
<div id="qj-auth-overlay" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/40 p-4"
  data-i18n={JSON.stringify(auth)}>
  <div class="w-full max-w-md rounded-lg bg-white p-6 shadow-xl relative">
    <button
      id="qj-auth-close"
      type="button"
      aria-label={auth.close}
      class="absolute right-4 top-4 text-slate-600 hover:text-slate-700 text-2xl leading-none cursor-pointer">&times;</button>

    <h2 id="qj-auth-title" class="text-2xl font-bold text-gray-900">{auth.title}</h2>
    <p class="mt-1 text-sm text-slate-600">
      {auth.subtitle}
    </p>

    <form id="qj-auth-form" class="mt-5">
      <label for="qj-auth-email" class="block text-sm font-medium text-gray-700">{auth.email}</label>
      <input
        id="qj-auth-email"
        name="email"
        type="email"
        required
        placeholder={auth.emailPlaceholder}
        class="mt-1 w-full px-4 py-3 border-2 rounded-md placeholder:text-gray-400 outline-hidden focus:ring-4 border-gray-300 focus:border-gray-600 ring-gray-100"
      />
      <div id="qj-code-row" class="hidden mt-4">
        <label for="qj-auth-code" class="block text-sm font-medium text-gray-700">{auth.code}</label>
        <input
          id="qj-auth-code"
          name="code"
          inputmode="numeric"
          autocomplete="one-time-code"
          placeholder={auth.codePlaceholder}
          class="mt-1 w-full px-4 py-3 border-2 rounded-md placeholder:text-gray-400 outline-hidden focus:ring-4 border-gray-300 focus:border-gray-600 ring-gray-100"
        />
      </div>

      <p id="qj-auth-status" class="mt-3 text-sm text-red-500 min-h-[1.25rem]"></p>

      <div class="mt-4 flex gap-3">
        <button
          id="qj-send-code"
          type="submit"
          class="w-full rounded-sm px-5 py-2.5 bg-black text-white hover:bg-gray-800 transition cursor-pointer">
          {auth.sendCode}
        </button>
        <button
          id="qj-sign-in"
          type="button"
          class="hidden w-full rounded-sm px-5 py-2.5 bg-black text-white hover:bg-gray-800 transition cursor-pointer">
          {auth.signIn}
        </button>
      </div>
    </form>
  </div>
</div>

<script>
import { authClient } from "../../lib/api";
import { emitAuthStateChange } from "../../lib/session";

const overlay = document.getElementById("qj-auth-overlay")!;
const t = JSON.parse(overlay.dataset.i18n ?? "{}") as {
  title: string;
  titleSignup: string;
  messages: {
    enterEmail: string;
    sending: string;
    codeSent: string;
    enterCode: string;
    verifying: string;
    signedIn: string;
  };
};
const title = document.getElementById("qj-auth-title")!;
const form = document.getElementById("qj-auth-form") as HTMLFormElement;
const emailInput = document.getElementById("qj-auth-email") as HTMLInputElement;
const codeInput = document.getElementById("qj-auth-code") as HTMLInputElement;
const codeRow = document.getElementById("qj-code-row")!;
const sendBtn = document.getElementById("qj-send-code") as HTMLButtonElement;
const signInBtn = document.getElementById("qj-sign-in") as HTMLButtonElement;
const statusEl = document.getElementById("qj-auth-status")!;
const closeBtn = document.getElementById("qj-auth-close") as HTMLButtonElement;

let capturedEmail = "";

function open(mode: "login" | "signup" | string) {
  title.textContent = mode === "signup" ? t.titleSignup : t.title;
  codeRow.classList.add("hidden");
  sendBtn.classList.remove("hidden");
  sendBtn.classList.add("w-full");
  signInBtn.classList.add("hidden");
  statusEl.textContent = "";
  emailInput.value = "";
  codeInput.value = "";
  overlay.classList.remove("hidden");
  overlay.classList.add("flex");
  setTimeout(() => emailInput.focus(), 0);
}
function close() {
  overlay.classList.add("hidden");
  overlay.classList.remove("flex");
}
window.__quietjarAuthOpen = open;

closeBtn.addEventListener("click", close);
overlay.addEventListener("click", (e) => { if (e.target === overlay) close(); });

sendBtn.addEventListener("click", async (e) => {
  e.preventDefault();
  const email = emailInput.value.trim();
  if (!email) { statusEl.textContent = t.messages.enterEmail; return; }
  statusEl.classList.remove("text-red-500","text-green-600");
  statusEl.classList.add("text-green-600");
  statusEl.textContent = t.messages.sending;
  const { error } = await authClient.emailOtp.sendVerificationOtp({ email, type: "sign-in" });
  if (error) {
    statusEl.classList.remove("text-green-600");
    statusEl.classList.add("text-red-500");
    statusEl.textContent = error.message ?? JSON.stringify(error);
    return;
  }
  capturedEmail = email;
  statusEl.textContent = t.messages.codeSent;
  codeRow.classList.remove("hidden");
  sendBtn.classList.add("hidden");
  sendBtn.classList.remove("w-full");
  signInBtn.classList.remove("hidden");
  setTimeout(() => codeInput.focus(), 0);
});

signInBtn.addEventListener("click", async () => {
  const code = codeInput.value.trim();
  if (!code) { statusEl.textContent = t.messages.enterCode; return; }
  statusEl.classList.remove("text-red-500","text-green-600");
  statusEl.classList.add("text-green-600");
  statusEl.textContent = t.messages.verifying;
  const { error } = await authClient.signIn.emailOtp({
    email: capturedEmail,
    otp: code,
    name: capturedEmail.split("@")[0],
  });
  if (error) {
    statusEl.classList.remove("text-green-600");
    statusEl.classList.add("text-red-500");
    statusEl.textContent = error.message ?? JSON.stringify(error);
    return;
  }
  statusEl.textContent = t.messages.signedIn;
  emitAuthStateChange(true);
  window.location.href = "/dashboard/";
});

form.addEventListener("submit", (e) => e.preventDefault());
</script>
