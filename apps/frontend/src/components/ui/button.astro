---
interface Props {
  size?: "md" | "lg";
  block?: boolean;
  style?: "outline" | "primary" | "inverted";
  class?: string;
  [x: string]: unknown;
}

const { size = "md", style = "primary", block, class: className, ...rest } = Astro.props;

const sizes = {
  md: "px-5 py-2.5",
  lg: "px-6 py-3",
};

const styles = {
  outline: "border-2 border-qj-blue hover:bg-qj-blue text-qj-blue hover:text-white",
  primary: "bg-qj-green text-white hover:bg-qj-green-press border-2 border-transparent",
  inverted: "bg-white text-qj-ink border-2 border-transparent",
};
---

<button
  {...rest}
  class:list={[
    "rounded-sm text-center transition focus-visible:ring-2 ring-offset-2 ring-gray-200",
    block && "w-full",
    sizes[size],
    styles[style],
    className,
  ]}
  ><slot />
</button>
