---
import { Icon } from "astro-icon/components";
import { dictionary } from "@/i18n/t";

const copy = dictionary(Astro.currentLocale ?? "en");
const craft = copy.craft;
const features = craft.features;
---

<section class="mt-24 md:mt-32">
  <div class="text-center max-w-3xl mx-auto">
    <p class="text-sm font-semibold tracking-wide text-slate-600 uppercase">{craft.eyebrow}</p>
    <h2 class="mt-3 text-4xl lg:text-5xl font-bold lg:tracking-tight">
      {craft.title}
    </h2>
    <p class="mt-4 text-lg text-slate-600">
      {craft.description}
    </p>
  </div>

  <div class="grid sm:grid-cols-2 md:grid-cols-3 mt-14 gap-10">
    {
      features.map((item) => (
        <div class="flex gap-4 items-start">
          <div class="mt-1 bg-black rounded-full p-2 w-8 h-8 shrink-0">
            <Icon class="text-white" name={item.icon} />
          </div>
          <div>
            <h3 class="font-semibold text-lg">{item.title}</h3>
            <p class="text-slate-600 mt-2 leading-relaxed">{item.description}</p>
          </div>
        </div>
      ))
    }
  </div>
</section>
