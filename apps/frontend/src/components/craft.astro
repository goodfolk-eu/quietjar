---
import { dictionary } from "@/i18n/t";

const copy = dictionary(Astro.currentLocale ?? "en");
const craft = copy.craft;
const features = craft.features;
---

<section id="features" class="border-y border-qj-line bg-qj-surface">
  <div class="mx-auto flex max-w-[1200px] flex-col gap-[44px] px-10 pb-24 pt-[88px]">
    <div class="flex max-w-[56ch] flex-col gap-3.5">
      <span class="text-[13.5px] font-medium text-qj-green">{craft.eyebrow}</span>
      <h2 class="text-balance font-display text-[44px] font-bold leading-[1.05] tracking-[-0.03em] text-qj-ink">
        {craft.title}
      </h2>
      <p class="text-pretty text-[17px] leading-[1.62] text-qj-ink-2">
        {craft.description}
      </p>
    </div>

    <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
      {
        features.map((item, i) => (
          <div class="flex flex-col gap-2.5 rounded border border-qj-line bg-white px-[30px] py-[34px]">
            <span class="font-mono text-[11.5px] text-qj-green">0{i + 1}</span>
            <h3 class="font-display text-[21px] font-bold tracking-[-0.02em] text-qj-ink">
              {item.title}
            </h3>
            <p class="text-[15px] leading-[1.6] text-qj-ink-2">
              {item.description}
            </p>
          </div>
        ))
      }
    </div>
  </div>
</section>