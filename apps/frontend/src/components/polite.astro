---
import { Icon } from "astro-icon/components";
import { dictionary } from "@/i18n/t";

const copy = dictionary(Astro.currentLocale ?? "en");
const polite = copy.polite;
---

<section id="how" class="mt-24 md:mt-32 scroll-mt-24">
  <div class="grid lg:grid-cols-2 gap-12 items-center">
    <div>
      <p class="text-sm font-semibold tracking-wide text-slate-600 uppercase">{polite.eyebrow}</p>
      <h2 class="mt-3 text-4xl lg:text-5xl font-bold lg:tracking-tight">
        {polite.title}
      </h2>
      <p class="mt-4 text-lg text-slate-600">
        {polite.description}
      </p>
      <div class="mt-6 flex gap-3 items-center">
        <div class="bg-black rounded-full p-2 w-9 h-9 shrink-0"><Icon class="text-white" name="bx:bxs-heart" /></div>
        <p class="text-slate-600">{polite.note}</p>
      </div>
    </div>
    <div class="rounded-lg border border-slate-200 bg-white p-8">
      <h3 class="text-sm text-slate-600">{polite.feelLabel}</h3>
      <ol class="mt-4 space-y-3 text-sm">
        <li class="rounded-md border border-slate-200 px-4 py-3 text-slate-600">{polite.feelSteps[0]}</li>
        <li class="rounded-md border border-green-300 bg-green-50 px-4 py-3 text-green-700">{polite.feelSteps[1]}</li>
        <li class="rounded-md border border-slate-200 px-4 py-3 text-slate-600">{polite.feelSteps[2]}</li>
        <li class="rounded-md border border-slate-200 px-4 py-3 text-slate-600">{polite.feelSteps[3]}</li>
      </ol>
    </div>
  </div>
</section>
