---
import SupporterScene from "@/components/scenes/supporterscene.astro";
import { dictionary } from "@/i18n/t";

const copy = dictionary(Astro.currentLocale ?? "en");
const polite = copy.polite;
---

<section>
  <div class="mx-auto grid max-w-[1180px] grid-cols-1 items-center gap-[72px] border-t border-qj-line px-10 pt-[clamp(72px,9vw,120px)] pb-[clamp(72px,9vw,120px)] lg:grid-cols-[minmax(0,0.8fr)_minmax(0,1.2fr)]">
    <div class="flex flex-col gap-4">
      <span class="text-[13.5px] font-semibold tracking-[-0.005em] text-qj-accent">{polite.eyebrow}</span>
      <h2 class="font-display text-[clamp(28px,3.4vw,44px)] font-bold leading-[1.05] tracking-[-0.028em] text-qj-ink">
        {polite.title}
      </h2>
      <p class="mt-1.5 max-w-[26ch] font-display text-[21px] font-bold tracking-[-0.022em] text-qj-ink">
        {polite.note}
      </p>
    </div>

    <div class="flex flex-col gap-7">
      <span class="font-mono text-[11.5px] uppercase tracking-[0.08em] text-qj-body">{polite.feelLabel}</span>
      <SupporterScene />
    </div>
  </div>
</section>
