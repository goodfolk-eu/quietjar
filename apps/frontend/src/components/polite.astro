---
import { dictionary } from "@/i18n/t";

const copy = dictionary(Astro.currentLocale ?? "en");
const polite = copy.polite;
---

<section class="bg-white">
  <div class="mx-auto grid max-w-[1200px] grid-cols-1 items-start gap-18 px-10 py-24 lg:grid-cols-[minmax(0,1fr)_minmax(0,0.85fr)]">
    <div class="flex flex-col gap-4">
      <span class="text-[13.5px] font-medium text-qj-green">{polite.eyebrow}</span>
      <h2 class="text-balance font-display text-[44px] font-bold leading-[1.05] tracking-[-0.03em] text-qj-ink">
        {polite.title}
      </h2>
      <p class="max-w-[48ch] text-pretty text-[17px] leading-[1.62] text-qj-ink-2">
        {polite.description}
      </p>
      <p class="mt-1.5 max-w-[34ch] font-display text-[21px] font-bold tracking-[-0.02em] text-qj-blue">
        {polite.note}
      </p>
    </div>

    <div class="flex flex-col gap-[18px] rounded border border-qj-line bg-white px-8 py-[30px] pb-[34px]">
      <span class="font-mono text-[11.5px] uppercase tracking-[0.08em] text-qj-ink-3">{polite.feelLabel}</span>
      <ol class="text-[15px] leading-[1.5]">
        {
          polite.feelSteps.map((step, i) => (
            <li class="flex gap-3.5 border-b border-qj-line-2 py-3.5 last:border-none">
              <span class:list={["mt-[7px] size-2 shrink-0", ["bg-qj-green", "bg-qj-tint", "bg-[#D9DEE1]", "bg-qj-green"][i]]} aria-hidden="true"></span>
              <span class:list={[i === 2 ? "text-qj-ink-2" : "text-qj-ink"]}>{step}</span>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>