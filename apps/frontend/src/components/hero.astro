---
import BrowserMock from "@/components/browsermock.astro";
import { dictionary } from "@/i18n/t";

const copy = dictionary(Astro.currentLocale ?? "en");
const hero = copy.hero;
---

<div class="hero-wrap bg-qj-paper">
  <div class="hero-top">
    <div class="hero-shade"></div>
    <section class="relative">
      <div class="relative mx-auto grid max-w-[1180px] grid-cols-1 items-center gap-[72px] px-10 pt-[clamp(56px,6.5vw,96px)] pb-[clamp(88px,10vw,138px)] lg:grid-cols-[minmax(0,1.02fr)_minmax(0,0.98fr)]">
        <div class="flex flex-col gap-[22px]">
          <span class="text-[13.5px] font-semibold tracking-[-0.005em] text-qj-accent">{hero.eyebrow}</span>
          <h1 class="text-balance font-display text-[clamp(36px,4.6vw,58px)] font-bold leading-[1.07] tracking-[-0.028em] text-qj-ink">
            {hero.title}
          </h1>
          <p class="max-w-[44ch] text-pretty text-[17.5px] leading-[1.68] text-qj-body">
            {hero.description}
          </p>
          <div class="mt-2 flex flex-wrap items-center gap-5">
            <button
              data-auth-mode="signup"
              type="button"
              class="cursor-pointer rounded-sm bg-qj-accent px-[26px] py-[15px] text-center text-[15px] font-semibold text-white transition hover:bg-qj-accent-alt">
              {hero.ctaPrimary}
            </button>
            <a
              href="#how"
              class="text-[15px] font-semibold text-qj-ink transition hover:text-qj-accent">
              {hero.ctaSecondary} →
            </a>
          </div>
        </div>

        <BrowserMock />
      </div>
    </section>
  </div>

  <div class="bg-white">
    <div class="mx-auto max-w-[1180px] px-10 pt-[26px] pb-[28px]">
      <div class="flex flex-wrap gap-x-12 gap-y-3.5">
        {
          hero.trustBar.map((item) => (
            <p class="flex items-center gap-2 text-[14.5px] text-qj-body">
              <span class="text-qj-accent" aria-hidden="true">✓</span>
              {item}
            </p>
          ))
        }
      </div>
    </div>
  </div>
</div>

<style>
  .hero-wrap {
    position: relative;
  }

  .hero-top {
    position: relative;
    overflow: hidden;
    margin-top: -88px;
    padding-top: 88px;
  }

  .hero-shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      102deg,
      rgba(20, 32, 28, 0) 40%,
      rgba(20, 32, 28, 0.035) 70%,
      rgba(20, 32, 28, 0.075) 100%
    );
  }
</style>

<script>
document.querySelectorAll("[data-auth-mode]").forEach((btn) => {
  btn.addEventListener("click", () => {
    const mode = btn.getAttribute("data-auth-mode") as "login" | "signup";
    window.__quietjarAuthOpen?.(mode);
  });
});
</script>
