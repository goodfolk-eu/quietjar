---
---

<main
  class="grid lg:grid-cols-2 place-items-center pt-16 pb-8 md:pt-12 md:pb-24">
  <div class="py-6 md:order-1 hidden md:block">
    <svg width="440" height="440" viewBox="0 0 200 200" fill="none" xmlns="http://www.w3.org/2000/svg" class="mx-auto max-w-full h-auto" aria-hidden="true">
      <defs>
        <linearGradient id="qjjar" x1="0" y1="0" x2="1" y2="1">
          <stop offset="0" stop-color="#0f172a"/>
          <stop offset="1" stop-color="#1e293b"/>
        </linearGradient>
      </defs>
      <rect x="10" y="10" width="180" height="180" rx="28" fill="url(#qjjar)"/>
      <ellipse cx="100" cy="72" rx="42" ry="22" stroke="#e2e8f0" stroke-width="4"/>
      <path d="M58 72 V132 c0 18 18 30 42 30 s42-12 42-30 V72" fill="#334155" stroke="#e2e8f0" stroke-width="4"/>
      <circle cx="100" cy="104" r="12" fill="#38bdf8"/>
      <path d="M84 58 h32 M100 42 v16" stroke="#38bdf8" stroke-width="5" stroke-linecap="round"/>
    </svg>
  </div>
  <div>
    <p class="text-sm font-semibold tracking-wide text-slate-400 uppercase">A donation button that lives on your site</p>
    <h1
      class="mt-3 text-5xl lg:text-6xl xl:text-7xl font-bold lg:tracking-tight xl:tracking-tighter">
      Let people support you<br class="hidden sm:block" /> without leaving your site.
    </h1>
    <p class="text-lg mt-4 text-slate-600 max-w-xl">
      Every time you send a customer off to a separate donation page, most of
      them never arrive. QuietJar lives right on your page. The moment someone
      wants to give, they can. Two taps, no redirect, no lost place. Fewer
      clicks means more of them actually follow through.
    </p>
    <div class="mt-6 flex flex-col sm:flex-row gap-3">
      <button
        data-auth-mode="signup"
        type="button"
        class="flex gap-1 items-center justify-center rounded-sm text-center transition focus-visible:ring-2 ring-offset-2 ring-gray-200 px-5 py-2.5 bg-black text-white hover:bg-gray-800 border-2 border-transparent cursor-pointer">
        Add it to your site
      </button>
      <a
        href="#how"
        class="flex gap-1 items-center justify-center rounded-sm text-center transition focus-visible:ring-2 ring-offset-2 ring-gray-200 px-5 py-2.5 bg-white border-2 border-black hover:bg-gray-100 text-black cursor-pointer">
        See it in action
      </a>
    </div>
    <p class="mt-4 text-sm text-slate-500">
      No monthly fee. You only pay a small share when you get paid.
    </p>
  </div>
</main>

<script>
document.querySelectorAll("[data-auth-mode]").forEach((btn) => {
  btn.addEventListener("click", () => {
    const mode = btn.getAttribute("data-auth-mode") as "login" | "signup";
    window.__quietjarAuthOpen?.(mode);
  });
});
</script>
