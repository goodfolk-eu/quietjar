---
import BrowserMock from "@/components/browsermock.astro";
import { dictionary } from "@/i18n/t";

const copy = dictionary(Astro.currentLocale ?? "en");
const hero = copy.hero;
---

<section class="bg-white">
  <div class="mx-auto grid max-w-[1200px] grid-cols-1 items-center gap-x-18 gap-y-10 px-10 pb-[104px] pt-24 lg:grid-cols-[minmax(0,1.05fr)_minmax(0,0.95fr)]">
    <div class="flex flex-col gap-5">
      <span class="text-[13.5px] font-medium text-qj-green">{hero.eyebrow}</span>
      <h1 class="text-balance font-display text-[62px] font-bold leading-[1.01] tracking-[-0.032em] text-qj-ink">
        {hero.title}
      </h1>
      <p class="max-w-[46ch] text-pretty text-[17.5px] leading-[1.62] text-qj-ink-2">
        {hero.description}
      </p>
      <div class="mt-2 flex flex-col gap-3 sm:flex-row sm:items-center">
        <button
          data-auth-mode="signup"
          type="button"
          class="cursor-pointer rounded-sm bg-qj-green px-6 py-3.5 text-center text-[15px] font-semibold text-white transition hover:bg-qj-green-press">
          {hero.ctaPrimary}
        </button>
        <a
          href="#how"
          class="rounded-sm border-[1.5px] border-qj-blue bg-white px-[22px] py-3 text-center text-[15px] font-semibold text-qj-blue transition hover:bg-[#F2F5FC]">
          {hero.ctaSecondary}
        </a>
      </div>
      <p class="mt-1 text-[13.5px] leading-[1.5] text-qj-ink-3">
        {hero.subtext}
      </p>
    </div>

    <BrowserMock />
  </div>
</section>

<script>
document.querySelectorAll("[data-auth-mode]").forEach((btn) => {
  btn.addEventListener("click", () => {
    const mode = btn.getAttribute("data-auth-mode") as "login" | "signup";
    window.__quietjarAuthOpen?.(mode);
  });
});
</script>