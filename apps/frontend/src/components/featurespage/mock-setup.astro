---
import { dictionary } from "@/i18n/t";

const copy = dictionary(Astro.currentLocale ?? "en");
const setup = copy.featuresPage.setup;
---

<ol
  class="flex flex-col rounded-lg border border-qj-line-card bg-white px-7 py-3 shadow-[0_28px_56px_-26px_rgba(20,32,28,0.28)]">
  {
    setup.steps.map((step, i) => (
      <li class="flex gap-4 border-b border-qj-line-soft py-5 last:border-none">
        <span class="w-6 shrink-0 pt-[3px] font-mono text-[12.5px] text-qj-accent">0{i + 1}</span>
        <div class="flex min-w-0 flex-1 flex-col gap-1">
          <span class="font-display text-[17px] font-bold tracking-[-0.02em] text-qj-ink">{step.title}</span>
          <span class="text-[14px] leading-[1.55] text-qj-body">{step.description}</span>
          {i === setup.steps.length - 1 && (
            <pre class="mt-2.5 overflow-x-auto rounded-sm bg-qj-code px-4 py-3.5 font-mono text-[12px] leading-[1.7] text-qj-ink">{setup.snippet}</pre>
          )}
        </div>
      </li>
    ))
  }
</ol>
