---
import { dictionary } from "@/i18n/t";

const copy = dictionary(Astro.currentLocale ?? "en");
const rows: ReadonlyArray<{
  readonly label: string;
  readonly value: string;
  readonly color?: string;
}> = copy.featuresPage.configurable.mock.rows;
---

<div
  class="flex flex-col gap-1 rounded-lg border border-qj-line-card bg-white p-3 shadow-[0_28px_56px_-26px_rgba(20,32,28,0.28)]"
>
  {
    rows.map((row) => (
      <div class="flex items-center justify-between gap-6 rounded-sm px-4 py-3.5 odd:bg-qj-paper">
        <span class="text-[14px] text-qj-body">{row.label}</span>
        <span class="flex items-center gap-2 font-mono text-[12px] text-qj-ink">
          {row.color && <span class="size-3 rounded-full" style={`background: ${row.color}`} aria-hidden="true" />}
          {row.value}
        </span>
      </div>
    ))
  }
</div>
