---
interface Props {
  eyebrow: string;
  title: string;
  description: string;
}

const { eyebrow, title, description } = Astro.props;
---

<div class="flex flex-col gap-8">
  <div class="flex flex-col gap-3.5">
    <span class="text-[13.5px] font-semibold tracking-[-0.005em] text-qj-accent">{eyebrow}</span>
    <h2 class="text-balance font-display text-[clamp(24px,2.6vw,30px)] font-bold leading-[1.1] tracking-[-0.024em] text-qj-ink">
      {title}
    </h2>
    <p class="max-w-[44ch] text-pretty text-[16px] leading-[1.62] text-qj-body">{description}</p>
  </div>
  <slot />
</div>
