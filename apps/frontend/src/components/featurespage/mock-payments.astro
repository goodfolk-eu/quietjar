---
import { dictionary } from "@/i18n/t";

const copy = dictionary(Astro.currentLocale ?? "en");
const mock = copy.featuresPage.payments.mock;
---

<figure class="flex flex-col items-center gap-4">
  <img
    src="/images/checkout-methods.webp"
    srcset="/images/checkout-methods.webp 1x, /images/checkout-methods@2x.webp 2x"
    alt={mock.alt}
    width="360"
    height="602"
    loading="lazy"
    decoding="async"
    class="w-full max-w-[360px] rounded-[12px] border border-qj-line-card shadow-[0_28px_56px_-26px_rgba(20,32,28,0.28)]"
  />
  <figcaption class="text-center text-[13.5px] text-qj-body">{mock.caption}</figcaption>
</figure>
