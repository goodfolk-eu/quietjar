---
import { dictionary } from "@/i18n/t";

const copy = dictionary(Astro.currentLocale ?? "en");
const widget = copy.featuresPage.widget;
---

<section class="border-y border-qj-line bg-white">
  <div class="mx-auto flex max-w-[1180px] flex-col gap-14 px-10 py-[clamp(72px,9vw,120px)]">
    <div class="grid grid-cols-1 items-end gap-10 lg:grid-cols-[minmax(0,1fr)_minmax(0,0.85fr)] lg:gap-[72px]">
      <div class="flex flex-col gap-4">
        <span class="text-[13.5px] font-semibold tracking-[-0.005em] text-qj-accent">{widget.eyebrow}</span>
        <h2 class="text-balance font-display text-[clamp(28px,3.4vw,44px)] font-bold leading-[1.05] tracking-[-0.028em] text-qj-ink">
          {widget.title}
        </h2>
        <p class="max-w-[48ch] text-pretty text-[17px] leading-[1.62] text-qj-body">{widget.description}</p>
      </div>
      <ul class="flex flex-col gap-2.5 text-[15.5px] leading-[1.6] text-qj-body">
        {
          widget.bullets.map((bullet) => (
            <li class="flex items-start gap-2.5">
              <span class="pt-[5px] text-qj-accent" aria-hidden="true">
                ✓
              </span>
              <span>{bullet}</span>
            </li>
          ))
        }
      </ul>
    </div>

    <dl class="grid grid-cols-1 gap-8 border-t border-qj-line-soft pt-10 sm:grid-cols-3">
      {
        widget.stats.map((stat) => (
          <div class="flex flex-col gap-1.5 sm:border-l sm:border-qj-line-soft sm:pl-8 sm:first:border-none sm:first:pl-0">
            <dt class="order-2 text-[14px] text-qj-body">{stat.label}</dt>
            <dd class="order-1 font-display text-[clamp(36px,4vw,48px)] font-bold leading-[1] tracking-[-0.03em] text-qj-ink">
              {stat.value}
            </dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>
