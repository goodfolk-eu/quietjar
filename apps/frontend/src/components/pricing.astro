---
---

<section id="pricing" class="mt-24 md:mt-32 scroll-mt-24">
  <div class="max-w-3xl mx-auto text-center">
    <p class="text-sm font-semibold tracking-wide text-slate-400 uppercase">Pricing</p>
    <h2 class="mt-3 text-4xl lg:text-5xl font-bold lg:tracking-tight">
      We only win when you do.
    </h2>
    <p class="mt-4 text-lg text-slate-600">
      No monthly fee. No plans to compare. QuietJar takes a small share of what
      you actually receive. So it costs you nothing until it is earning you
      something. Your incentives and ours point the same direction. Get more of
      your supporters to follow through.
    </p>
  </div>

  <div class="mt-14 mx-auto max-w-md">
    <div class="rounded-lg border-2 border-black bg-white p-8 text-center">
      <p class="text-sm font-semibold tracking-wide text-slate-400 uppercase">Simple</p>
      <p class="mt-4 text-5xl font-bold">Free</p>
      <p class="text-slate-500 mt-2">to start, forever</p>
      <div class="mt-6 border-t border-slate-100 pt-6 text-left space-y-3 text-slate-600 text-sm">
        <p>No monthly fee. No plans to compare.</p>
        <p>Pay a small percentage only when someone supports you.</p>
        <p>Your incentives and ours point the same direction.</p>
      </div>
      <button
        data-auth-mode="signup"
        type="button"
        class="mt-8 w-full rounded-sm text-center transition focus-visible:ring-2 ring-offset-2 ring-gray-200 px-6 py-3 bg-black text-white hover:bg-gray-800 border-2 border-transparent cursor-pointer">
        Add it to your site
      </button>
    </div>
  </div>
</section>

<script>
document.querySelectorAll("[data-auth-mode]").forEach((btn) => {
  btn.addEventListener("click", () => {
    const mode = btn.getAttribute("data-auth-mode") as "login" | "signup";
    window.__quietjarAuthOpen?.(mode);
  });
});
</script>
