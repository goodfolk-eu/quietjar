---
import { dictionary } from "@/i18n/t";

const copy = dictionary(Astro.currentLocale ?? "en");
const pricing = copy.pricing;
---

<section id="pricing">
  <div class="mx-auto grid max-w-[1180px] grid-cols-1 items-center gap-[72px] border-t border-qj-line px-10 pt-[clamp(72px,9vw,120px)] pb-[clamp(72px,9vw,120px)] lg:grid-cols-[minmax(0,1fr)_minmax(0,0.72fr)]">
    <div class="flex flex-col gap-4">
      <span class="text-[13.5px] font-semibold tracking-[-0.005em] text-qj-accent">{pricing.eyebrow}</span>
      <h2 class="text-balance font-display text-[clamp(28px,3.4vw,44px)] font-bold leading-[1.05] tracking-[-0.028em] text-qj-ink">
        {pricing.title}
      </h2>
      <p class="max-w-[50ch] text-pretty text-[17px] leading-[1.62] text-qj-body">
        {pricing.description}
      </p>
    </div>

    <div class="flex flex-col gap-[22px] rounded-xl bg-qj-field p-10 pb-11">
      <span class="font-mono text-[11.5px] uppercase tracking-[0.1em] text-qj-field-mint">{pricing.planLabel}</span>
      <div class="flex items-baseline gap-2.5">
        <span class="font-display text-[66px] font-bold leading-[0.9] tracking-[-0.028em] text-white">{pricing.planPrice}</span>
        <span class="text-[15px] text-white/72">{pricing.planPriceNote}</span>
      </div>
      <table class="w-full border-collapse text-left text-[15px] text-white">
        <thead>
          <tr class="border-b border-white/25">
            {pricing.exampleHead.map((heading) => (
              <th scope="col" class="py-2.5 pr-4 font-mono text-[11.5px] font-medium uppercase tracking-[0.08em] text-white/60">
                {heading}
              </th>
            ))}
          </tr>
        </thead>
        <tbody>
          {
            pricing.exampleRows.map((row) => (
              <tr class="border-b border-white/12">
                {row.map((cell) => (
                  <td class="py-2.5 pr-4">{cell}</td>
                ))}
              </tr>
            ))
          }
        </tbody>
      </table>
      <p class="text-[14px] leading-[1.6] text-white/80">{pricing.absorb}</p>
      <p class="text-[14px] leading-[1.6] text-white/80">{pricing.payout}</p>
      <button
        data-auth-mode="signup"
        type="button"
        class="mt-1 cursor-pointer self-start rounded-sm bg-white px-6 py-3.5 text-center text-[15px] font-semibold text-qj-field transition hover:bg-qj-paper">
        {pricing.cta}
      </button>
    </div>
  </div>
</section>

<script>
document.querySelectorAll("[data-auth-mode]").forEach((btn) => {
  btn.addEventListener("click", () => {
    const mode = btn.getAttribute("data-auth-mode") as "login" | "signup";
    window.__quietjarAuthOpen?.(mode);
  });
});
</script>