---
import { dictionary } from "@/i18n/t";

const copy = dictionary(Astro.currentLocale ?? "en");
const pricing = copy.pricing;
---

<section id="pricing" class="bg-white">
  <div class="mx-auto grid max-w-[1200px] grid-cols-1 items-center gap-18 px-10 py-24 lg:grid-cols-[minmax(0,1fr)_minmax(0,0.72fr)]">
    <div class="flex flex-col gap-4">
      <span class="text-[13.5px] font-medium text-qj-green">{pricing.eyebrow}</span>
      <h2 class="text-balance font-display text-[44px] font-bold leading-[1.05] tracking-[-0.03em] text-qj-ink">
        {pricing.title}
      </h2>
      <p class="max-w-[50ch] text-pretty text-[17px] leading-[1.62] text-qj-ink-2">
        {pricing.description}
      </p>
    </div>

    <div class="flex flex-col gap-[22px] rounded bg-qj-blue p-10 pb-11">
      <span class="font-mono text-[11.5px] uppercase tracking-[0.1em] text-qj-tint">{pricing.planLabel}</span>
      <div class="flex items-baseline gap-2.5">
        <span class="font-display text-[66px] font-bold leading-[0.9] tracking-[-0.035em] text-white">{pricing.planPrice}</span>
        <span class="text-[15px] text-white/72">{pricing.planPriceNote}</span>
      </div>
      <div class="flex flex-col gap-3 border-t border-white/18 pt-[22px] text-[15px] leading-[1.55] text-white/86">
        {pricing.planFeatures.map((feature) => (
          <span>{feature}</span>
        ))}
      </div>
      <button
        data-auth-mode="signup"
        type="button"
        class="mt-1 cursor-pointer self-start rounded-sm bg-qj-green px-6 py-3.5 text-center text-[15px] font-semibold text-white transition hover:bg-qj-green-press">
        {pricing.cta}
      </button>
    </div>
  </div>
</section>

<script>
document.querySelectorAll("[data-auth-mode]").forEach((btn) => {
  btn.addEventListener("click", () => {
    const mode = btn.getAttribute("data-auth-mode") as "login" | "signup";
    window.__quietjarAuthOpen?.(mode);
  });
});
</script>