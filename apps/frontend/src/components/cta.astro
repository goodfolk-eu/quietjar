---
import StarRing from "@/components/starrring.astro";
import { dictionary } from "@/i18n/t";

const copy = dictionary(Astro.currentLocale ?? "en");
const cta = copy.cta;
---

<section class="relative overflow-hidden bg-qj-blue">
  <StarRing />
  <div class="relative mx-auto flex max-w-[1200px] flex-col items-start gap-[22px] px-10 pb-[104px] pt-24">
    <h2 class="max-w-[26ch] text-balance font-display text-[50px] font-bold leading-[1.03] tracking-[-0.032em] text-white">
      {cta.title}
    </h2>
    <p class="max-w-[48ch] text-pretty text-[17px] leading-[1.62] text-white/80">
      {cta.description}
    </p>
    <div class="mt-1.5 flex flex-col items-center gap-3.5 sm:flex-row">
      <button type="button" data-auth-mode="signup"
        class="cursor-pointer rounded-sm bg-qj-green px-6 py-3.5 text-center text-[15px] font-semibold text-white transition hover:bg-qj-green-press">
        {cta.primary}
      </button>
      <a href="#faq" class="rounded-sm px-1 py-3.5 text-center text-[15px] font-semibold text-qj-tint transition hover:text-white">
        {cta.secondary}
      </a>
    </div>
  </div>
</section>

<script>
document.querySelectorAll("[data-auth-mode]").forEach((btn) => {
  btn.addEventListener("click", () => {
    const mode = btn.getAttribute("data-auth-mode") as "login" | "signup";
    window.__quietjarAuthOpen?.(mode);
  });
});
</script>