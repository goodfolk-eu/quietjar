---
import AuthModal from "@/components/auth/auth-modal.astro";
import Container from "@/components/container.astro";
import Logo from "@/components/logo.astro";
import { dictionary } from "@/i18n/t";

const copy = dictionary(Astro.currentLocale ?? "en");
const navLinks = copy.nav.links;

// Active for an exact match, and for anything under that link's own path, so
// a future sub-page (e.g. /pricing/enterprise/) still lights up "Pricing".
const currentPath = Astro.url.pathname;
const isActive = (path: string) =>
  currentPath === path || (path !== "/" && currentPath.startsWith(path));
---

<header
  id="qj-header"
  class="sticky top-0 z-40 bg-transparent transition-colors duration-200 data-[scrolled=true]:bg-white data-[scrolled=true]:shadow-[0_1px_0_rgba(23,26,24,0.08)] data-[menu-open=true]:bg-white data-[menu-open=true]:shadow-[0_1px_0_rgba(23,26,24,0.08)]">
  <Container
    class="flex items-center justify-between gap-x-6 py-[18px] max-[1000px]:px-6 max-[1000px]:py-4 max-[560px]:px-5 max-[560px]:py-3.5">
    <a href="/" aria-label="QuietJar" class="flex items-center gap-0.5">
      <Logo class="hidden h-11 w-auto min-[1000px]:block" />
      <Logo class="block h-9 w-auto min-[1000px]:hidden" iconOnly />
    </a>

    <nav class="hidden items-center gap-6.5 min-[1000px]:flex" aria-label={copy.nav.primary}>
      {navLinks.map((link) => (
        <a
          href={link.path}
          aria-current={isActive(link.path) ? "page" : undefined}
          class:list={[
            "border-b-2 py-1 text-[14.5px] font-medium transition",
            isActive(link.path)
              ? "border-qj-accent text-qj-accent"
              : "border-transparent text-qj-ink hover:text-qj-accent",
          ]}>
          {link.title}
        </a>
      ))}
    </nav>

    <div class="flex items-center gap-3 max-[560px]:gap-2">
      <div id="qj-auth-buttons" class="flex items-center gap-3">
        <button type="button" id="qj-nav-login"
          class="hidden cursor-pointer px-1 py-2.5 text-[14.5px] font-medium text-qj-ink transition hover:text-qj-accent min-[1000px]:block">{copy.nav.login}</button>
        <button type="button" id="qj-nav-signup"
          class="cursor-pointer rounded-sm bg-qj-accent px-[18px] py-2.5 text-[14.5px] font-semibold text-white transition hover:bg-qj-accent-alt max-[560px]:px-3.5 max-[560px]:text-[14px]">{copy.nav.signup}</button>
      </div>
      <a id="qj-nav-dashboard" href="/dashboard/"
        class="hidden rounded-sm bg-qj-accent px-[18px] py-2.5 text-[14.5px] font-semibold text-white transition hover:bg-qj-accent-alt max-[560px]:px-3.5 max-[560px]:text-[14px]">{copy.nav.dashboard}</a>

      <button
        type="button"
        id="qj-menu-toggle"
        aria-controls="qj-mobile-menu"
        aria-expanded="false"
        aria-label={copy.nav.menuOpen}
        data-label-open={copy.nav.menuOpen}
        data-label-close={copy.nav.menuClose}
        class="-mr-2 flex size-10 cursor-pointer items-center justify-center rounded-sm text-qj-ink transition hover:text-qj-accent min-[1000px]:hidden">
        <svg width="22" height="22" viewBox="0 0 22 22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <g data-icon="open">
            <path d="M3 6h16" />
            <path d="M3 11h16" />
            <path d="M3 16h16" />
          </g>
          <g data-icon="close" class="hidden">
            <path d="M5 5l12 12" />
            <path d="M17 5L5 17" />
          </g>
        </svg>
      </button>
    </div>
  </Container>

  <div
    id="qj-mobile-menu"
    class="absolute inset-x-0 top-full hidden border-t border-qj-line bg-white shadow-[0_24px_48px_-24px_rgba(20,32,28,0.35)] min-[1000px]:hidden">
    <nav class="mx-auto flex max-w-[1200px] flex-col px-6 py-3 max-[560px]:px-5" aria-label={copy.nav.primary}>
      {navLinks.map((link) => (
        <a
          href={link.path}
          aria-current={isActive(link.path) ? "page" : undefined}
          class:list={[
            "border-b border-l-[3px] border-qj-line-soft py-4 pl-3 font-display text-[22px] font-bold tracking-[-0.022em] transition",
            isActive(link.path) ? "border-l-qj-accent text-qj-accent" : "border-l-transparent text-qj-ink hover:text-qj-accent",
          ]}>
          {link.title}
        </a>
      ))}
      <button type="button" id="qj-menu-login"
        class="cursor-pointer py-4 text-left text-[16px] font-medium text-qj-ink transition hover:text-qj-accent">{copy.nav.login}</button>
      <a id="qj-menu-dashboard" href="/dashboard/"
        class="hidden py-4 text-[16px] font-medium text-qj-ink transition hover:text-qj-accent">{copy.nav.dashboard}</a>
    </nav>
  </div>

  <div id="qj-menu-backdrop" class="fixed inset-0 -z-10 hidden bg-qj-field/30 min-[1000px]:hidden" aria-hidden="true"></div>
</header>

<AuthModal />

<script>
import { hasSessionCookie, onAuthStateChange } from "../../lib/session";

const authEls = [document.getElementById("qj-auth-buttons"), document.getElementById("qj-menu-login")];
const dashEls = [document.getElementById("qj-nav-dashboard"), document.getElementById("qj-menu-dashboard")];

function setSignedIn(signedIn: boolean) {
  authEls.forEach((el) => el?.classList.toggle("hidden", signedIn));
  dashEls.forEach((el) => el?.classList.toggle("hidden", !signedIn));
}

setSignedIn(hasSessionCookie());
onAuthStateChange(setSignedIn);

const header = document.getElementById("qj-header");
function updateScrolled() {
  header?.setAttribute("data-scrolled", String(window.scrollY > 8));
}
updateScrolled();
window.addEventListener("scroll", updateScrolled, { passive: true });

// Mobile menu: a panel under the header, dimmed page behind it.
const toggle = document.getElementById("qj-menu-toggle");
const menu = document.getElementById("qj-mobile-menu");
const backdrop = document.getElementById("qj-menu-backdrop");
const iconOpen = toggle?.querySelector<SVGElement>('[data-icon="open"]');
const iconClose = toggle?.querySelector<SVGElement>('[data-icon="close"]');

function setMenu(open: boolean) {
  if (!toggle || !menu || !backdrop) return;
  menu.classList.toggle("hidden", !open);
  backdrop.classList.toggle("hidden", !open);
  iconOpen?.classList.toggle("hidden", open);
  iconClose?.classList.toggle("hidden", !open);
  toggle.setAttribute("aria-expanded", String(open));
  toggle.setAttribute("aria-label", (open ? toggle.dataset.labelClose : toggle.dataset.labelOpen) ?? "");
  header?.setAttribute("data-menu-open", String(open));
}

const isMenuOpen = () => toggle?.getAttribute("aria-expanded") === "true";

toggle?.addEventListener("click", () => setMenu(!isMenuOpen()));
backdrop?.addEventListener("click", () => setMenu(false));
menu?.querySelectorAll("a").forEach((link) => link.addEventListener("click", () => setMenu(false)));
document.addEventListener("keydown", (event) => {
  if (event.key === "Escape" && isMenuOpen()) {
    setMenu(false);
    toggle?.focus();
  }
});
window.matchMedia("(min-width: 1000px)").addEventListener("change", (event) => {
  if (event.matches) setMenu(false);
});

const openAuth = (mode: "login" | "signup") => {
  setMenu(false);
  window.__quietjarAuthOpen?.(mode);
};
document.getElementById("qj-nav-login")?.addEventListener("click", () => openAuth("login"));
document.getElementById("qj-menu-login")?.addEventListener("click", () => openAuth("login"));
document.getElementById("qj-nav-signup")?.addEventListener("click", () => openAuth("signup"));
</script>
