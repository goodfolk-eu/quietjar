---
import AuthModal from "@/components/auth/auth-modal.astro";
import Container from "@/components/container.astro";
import Logo from "@/components/logo.astro";
import { dictionary } from "@/i18n/t";

const copy = dictionary(Astro.currentLocale ?? "en");
const navLinks = copy.nav.links;
---

<header id="qj-header" class="sticky top-0 z-40 bg-transparent transition-colors duration-200 data-[scrolled=true]:bg-white data-[scrolled=true]:shadow-[0_1px_0_rgba(23,26,24,0.08)]">
  <Container
    class="flex items-center justify-between gap-x-6 py-[18px] max-[1000px]:px-6 max-[1000px]:py-4 max-[560px]:px-5 max-[560px]:py-3.5">
    <a href="/" aria-label="QuietJar" class="flex items-center gap-0.5">
      <Logo class="hidden h-11 w-auto min-[1000px]:block" />
      <Logo class="block h-9 w-auto min-[1000px]:hidden" iconOnly />
    </a>

    <nav class="hidden items-center gap-6.5 min-[1000px]:flex" aria-label={copy.nav.primary}>
      {navLinks.map((link) => (
        <a href={link.path} class="text-[14.5px] font-medium text-qj-ink transition hover:text-qj-accent">{link.title}</a>
      ))}
    </nav>

    <div class="flex items-center gap-3">
      <div id="qj-auth-buttons" class="flex items-center gap-3">
        <button type="button" id="qj-nav-login"
          class="cursor-pointer px-1 py-2.5 text-[14.5px] font-medium text-qj-ink transition hover:text-qj-accent">{copy.nav.login}</button>
        <button type="button" id="qj-nav-signup"
          class="cursor-pointer rounded-sm bg-qj-accent px-[18px] py-2.5 text-[14.5px] font-semibold text-white transition hover:bg-qj-accent-alt">{copy.nav.signup}</button>
      </div>
      <a id="qj-nav-dashboard" href="/dashboard/"
        class="hidden rounded-sm bg-qj-accent px-[18px] py-2.5 text-[14.5px] font-semibold text-white transition hover:bg-qj-accent-alt">{copy.nav.dashboard}</a>
    </div>
  </Container>
</header>

<AuthModal />

<script>
import { hasSessionCookie, onAuthStateChange } from "../../lib/session";

const authDesk = [document.getElementById("qj-auth-buttons")];
const dashDesk = [document.getElementById("qj-nav-dashboard")];

function setSignedIn(signedIn: boolean) {
  authDesk.forEach((el) => el?.classList.toggle("hidden", signedIn));
  dashDesk.forEach((el) => el?.classList.toggle("hidden", !signedIn));
}

setSignedIn(hasSessionCookie());
onAuthStateChange(setSignedIn);

const header = document.getElementById("qj-header");
function updateScrolled() {
  header?.setAttribute("data-scrolled", String(window.scrollY > 8));
}
updateScrolled();
window.addEventListener("scroll", updateScrolled, { passive: true });

document.getElementById("qj-nav-login")?.addEventListener("click", () => window.__quietjarAuthOpen?.("login"));
document.getElementById("qj-nav-signup")?.addEventListener("click", () => window.__quietjarAuthOpen?.("signup"));
</script>
