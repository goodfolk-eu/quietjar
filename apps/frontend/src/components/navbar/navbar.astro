---
import AuthModal from "@/components/auth/auth-modal.astro";
import Container from "@/components/container.astro";
import Logo from "@/components/logo.astro";
import { dictionary } from "@/i18n/t";

const copy = dictionary(Astro.currentLocale ?? "en");
const navLinks = copy.nav.links;
---

<header class="sticky top-0 z-40 border-b border-qj-line bg-white/94 backdrop-blur-md">
  <Container class="flex h-18 items-center justify-between">
    <a href="/" aria-label="QuietJar" class="flex items-center gap-0.5">
      <Logo class="h-11 w-auto" />
    </a>

    <nav class="hidden md:flex items-center gap-6.5" aria-label={copy.nav.primary}>
      {navLinks.map((link) => (
        <a href={link.path} class="text-[14.5px] font-medium text-qj-ink transition hover:text-qj-blue">{link.title}</a>
      ))}
    </nav>

    <div class="hidden md:flex items-center gap-3">
      <div id="qj-auth-buttons" class="flex items-center gap-3">
        <button type="button" id="qj-nav-login"
          class="cursor-pointer px-1 py-2.5 text-[14.5px] font-medium text-qj-blue transition hover:text-qj-blue-press">{copy.nav.login}</button>
        <button type="button" id="qj-nav-signup"
          class="cursor-pointer rounded-sm bg-qj-green px-[18px] py-2.5 text-[14.5px] font-semibold text-white transition hover:bg-qj-green-press">{copy.nav.signup}</button>
      </div>
      <a id="qj-nav-dashboard" href="/dashboard/"
        class="hidden rounded-sm bg-qj-green px-[18px] py-2.5 text-[14.5px] font-semibold text-white transition hover:bg-qj-green-press">{copy.nav.dashboard}</a>
    </div>

    <button id="qj-mobile-toggle" type="button"
      class="cursor-pointer p-2 text-qj-ink md:hidden" aria-label={copy.nav.menu} aria-expanded="false">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
    </button>
  </Container>

  <div id="qj-mobile-menu" class="hidden border-t border-qj-line bg-white pb-4 md:hidden">
    <Container class="flex flex-col gap-1 pt-3">
      <nav class="flex flex-col gap-1" aria-label={copy.nav.mobile}>
        {navLinks.map((link) => (
          <a href={link.path} class="px-3 py-2 text-[14.5px] text-qj-ink transition hover:text-qj-blue">{link.title}</a>
        ))}
      </nav>
      <div class="mt-3 flex gap-3">
        <div id="qj-auth-buttons-mobile" class="flex items-center gap-3">
          <button type="button" id="qj-nav-login-mobile"
            class="cursor-pointer rounded-sm border-2 border-qj-blue px-4 py-2 text-center text-[14.5px] text-qj-blue transition hover:bg-qj-blue hover:text-white">{copy.nav.login}</button>
          <button type="button" id="qj-nav-signup-mobile"
            class="cursor-pointer rounded-sm bg-qj-green px-4 py-2 text-center text-[14.5px] text-white transition hover:bg-qj-green-press">{copy.nav.signup}</button>
        </div>
        <a id="qj-nav-dashboard-mobile" href="/dashboard/"
          class="hidden rounded-sm bg-qj-green px-4 py-2 text-center text-[14.5px] text-white transition hover:bg-qj-green-press">{copy.nav.dashboard}</a>
      </div>
    </Container>
  </div>
</header>

<AuthModal />

<script>
import { hasSessionCookie, onAuthStateChange } from "../../lib/session";

const loginBtns = [document.getElementById("qj-nav-login"), document.getElementById("qj-nav-login-mobile")];
const signupBtns = [document.getElementById("qj-nav-signup"), document.getElementById("qj-nav-signup-mobile")];
const authDesk = [document.getElementById("qj-auth-buttons"), document.getElementById("qj-auth-buttons-mobile")];
const dashDesk = [document.getElementById("qj-nav-dashboard"), document.getElementById("qj-nav-dashboard-mobile")];

function setSignedIn(signedIn: boolean) {
  authDesk.forEach((el) => el?.classList.toggle("hidden", signedIn));
  dashDesk.forEach((el) => el?.classList.toggle("hidden", !signedIn));
}

setSignedIn(hasSessionCookie());
onAuthStateChange(setSignedIn);

loginBtns.forEach((b) => b?.addEventListener("click", () => window.__quietjarAuthOpen?.("login")));
signupBtns.forEach((b) => b?.addEventListener("click", () => window.__quietjarAuthOpen?.("signup")));

const toggle = document.getElementById("qj-mobile-toggle")!;
const menu = document.getElementById("qj-mobile-menu")!;
toggle.addEventListener("click", () => {
  const willOpen = menu.classList.contains("hidden");
  menu.classList.toggle("hidden");
  toggle.setAttribute("aria-expanded", String(willOpen));
});
</script>
