---
import type { QuietJarConfig } from "@quietjar/widget/config";
import { dictionary } from "@/i18n/t";

const copy = dictionary(Astro.currentLocale ?? "en");
const mock = copy.hero.browserMock;

// The homepage installs the widget the way a customer would, pointing the
// inline mount at the demo slot. Dev loads the local bundle: the deployed
// bundle at the customer URL would be older than this checkout. Dev can still
// target another origin with PUBLIC_WIDGET_URL.
const widgetSrc =
  import.meta.env.PUBLIC_WIDGET_URL ??
  (import.meta.env.DEV ? "/js/latest/quietjar.js" : "https://quietjar.com/js/latest/quietjar.js");

// Font strings are validated by the widget itself; an unknown value falls
// back to its default preset.
const presetStyles = Object.fromEntries(
  mock.presets.map((preset) => [
    preset.key,
    {
      headline: preset.headline,
      body: preset.body,
      action: preset.action,
      color: preset.color,
      font: preset.font as NonNullable<QuietJarConfig["style"]>["font"],
    },
  ]),
);
---

<div
  class="flex flex-col"
  data-qj-demo
  data-presets={JSON.stringify(presetStyles)}
>
  <div class="mock-card overflow-hidden rounded-xl bg-white" data-qj-mock data-preset="docs">
    <div class="flex items-center gap-5 border-b border-qj-line-card px-[18px]" data-qj-presets>
      {
        mock.presets.map((preset, i) => (
          <button
            type="button"
            data-preset-btn={preset.key}
            aria-pressed={i === 0 ? "true" : "false"}
            class="-mb-px cursor-pointer border-b-2 border-transparent py-3 text-[13.5px] text-qj-body transition hover:text-qj-ink aria-pressed:border-qj-accent aria-pressed:font-semibold aria-pressed:text-qj-ink"
          >
            {preset.label}
          </button>
        ))
      }
    </div>

    <div class="flex items-center gap-[7px] border-b border-qj-line-card px-4 py-3">
      <span class="size-2 rounded-full bg-[#DCE0DA]" aria-hidden="true"></span>
      <span class="size-2 rounded-full bg-[#DCE0DA]" aria-hidden="true"></span>
      <span class="size-2 rounded-full bg-[#DCE0DA]" aria-hidden="true"></span>
      <span class="ml-2.5 font-mono text-[11.5px] text-qj-body">{mock.url}</span>
    </div>

    <div class="flex flex-col gap-3.5 px-8 py-[30px] pb-[34px]" style={`background: var(--demo-bg)`}>
      <div class="flex flex-col gap-2">
        <span class="h-2 w-[62%] rounded-sm" style={`background: var(--demo-line)`} aria-hidden="true"></span>
        <span class="h-2 w-full rounded-sm" style={`background: var(--demo-line)`} aria-hidden="true"></span>
        <span class="h-2 w-[88%] rounded-sm" style={`background: var(--demo-line)`} aria-hidden="true"></span>
      </div>

      <div id="qj-demo-slot" class="my-1.5"></div>

      <div class="flex flex-col gap-2">
        <span class="h-2 w-full rounded-sm" style={`background: var(--demo-line)`} aria-hidden="true"></span>
        <span class="h-2 w-[74%] rounded-sm" style={`background: var(--demo-line)`} aria-hidden="true"></span>
      </div>
    </div>

    <div
      class="flex items-center justify-end border-t border-qj-line-card bg-qj-code px-5 py-3 font-mono text-[12px]"
    >
      <span class="whitespace-nowrap text-qj-accent">{mock.live}</span>
    </div>
  </div>
</div>

<style>
  .mock-card {
    box-shadow: 0 28px 56px -26px rgba(20, 32, 28, 0.28);
  }

  [data-qj-mock][data-preset="docs"] {
    --demo-bg: #ffffff;
    --demo-line: #f0ede6;
  }

  [data-qj-mock][data-preset="blog"] {
    --demo-bg: #fbf7ef;
    --demo-line: #eae1d0;
  }

  [data-qj-mock][data-preset="magazine"] {
    --demo-bg: #f5f4f2;
    --demo-line: #dedcd8;
  }
</style>

<script>
  import { mountWidget } from "@quietjar/widget/embed";
  import { resolveConfig, type QuietJarConfig } from "@quietjar/widget/config";

  const root = document.querySelector<HTMLElement>("[data-qj-demo]");

  if (root) {
    const mockCard = root.querySelector<HTMLElement>("[data-qj-mock]");
    const slot = root.querySelector<HTMLElement>("#qj-demo-slot");
    const presetButtons = [...root.querySelectorAll<HTMLButtonElement>("[data-preset-btn]")];
    const presetStyles = JSON.parse(root.dataset.presets ?? "{}") as Record<
      string,
      {
        headline?: string;
        body?: string;
        action?: string;
        color?: string;
        font?: NonNullable<QuietJarConfig["style"]>["font"];
      }
    >;

    // Captured before any preset runs, so every tab composes from the
    // production config instead of the previous tab's restyle. The widget
    // attaches an open() method to the config object, which structuredClone
    // rejects, so the copy drops functions with a JSON round trip.
    const baseConfig = window.QuietJar
      ? (JSON.parse(JSON.stringify(window.QuietJar)) as QuietJarConfig)
      : undefined;

    for (const button of presetButtons) {
      button.addEventListener("click", () => {
        mockCard?.setAttribute("data-preset", button.dataset.presetBtn ?? "docs");
        for (const other of presetButtons) {
          other.setAttribute("aria-pressed", String(other === button));
        }

        if (!slot || !baseConfig) return;
        slot.querySelector("[data-quietjar-host]")?.remove();
        const preset = presetStyles[button.dataset.presetBtn ?? ""] ?? {};
        mountWidget(
          resolveConfig({
            ...baseConfig,
            labels: {
              ...baseConfig.labels,
              headline: preset.headline ?? baseConfig.labels?.headline,
              body: preset.body ?? baseConfig.labels?.body,
              action: preset.action ?? baseConfig.labels?.action,
            },
            style: {
              ...baseConfig.style,
              color: preset.color ?? baseConfig.style?.color,
              font: preset.font ?? baseConfig.style?.font,
            },
          }),
        );
      });
    }
  }
</script>

<script is:inline src="/demo-config.js" defer></script>

<script is:inline src={widgetSrc} defer></script>
