---
import { dictionary } from "@/i18n/t";

const copy = dictionary(Astro.currentLocale ?? "en");
const mock = copy.hero.browserMock;
---

<div class="flex flex-col" data-qj-demo>
  <div class="mock-card overflow-hidden rounded-xl bg-white" data-qj-mock data-preset="docs" data-state="ask">
    <div class="flex items-center gap-5 border-b border-qj-line-card px-[18px]" data-qj-presets>
      {
        mock.presets.map((preset, i) => (
          <button
            type="button"
            data-preset-btn={preset.key}
            aria-pressed={i === 0 ? "true" : "false"}
            class="-mb-px cursor-pointer border-b-2 border-transparent py-3 text-[13.5px] text-qj-body transition hover:text-qj-ink aria-pressed:border-qj-accent aria-pressed:font-semibold aria-pressed:text-qj-ink"
          >
            {preset.label}
          </button>
        ))
      }
    </div>

    <div class="flex items-center gap-[7px] border-b border-qj-line-card px-4 py-3">
      <span class="size-2 rounded-full bg-[#DCE0DA]" aria-hidden="true"></span>
      <span class="size-2 rounded-full bg-[#DCE0DA]" aria-hidden="true"></span>
      <span class="size-2 rounded-full bg-[#DCE0DA]" aria-hidden="true"></span>
      <span class="ml-2.5 font-mono text-[11.5px] text-qj-body">{mock.url}</span>
    </div>

    <div class="flex flex-col gap-3.5 px-8 py-[30px] pb-[34px]" style={`background: var(--demo-bg)`}>
      <div class="flex flex-col gap-2">
        <span class="h-2 w-[62%] rounded-sm" style={`background: var(--demo-line)`} aria-hidden="true"></span>
        <span class="h-2 w-full rounded-sm" style={`background: var(--demo-line)`} aria-hidden="true"></span>
        <span class="h-2 w-[88%] rounded-sm" style={`background: var(--demo-line)`} aria-hidden="true"></span>
      </div>

      <div class="my-1.5 flex items-center justify-between gap-5 rounded-lg px-[22px] py-5" style={`background: var(--demo-widget-bg)`}>
        <div class="flex flex-col gap-[3px]">
          <span class="font-display text-[17px] font-bold tracking-[-0.02em]" style={`color: var(--demo-ink); font-family: var(--demo-heading-font)`} data-qj-ask-headline>
            {mock.enjoy}
          </span>
          <span class="hidden font-display text-[17px] font-bold tracking-[-0.02em]" style={`color: var(--demo-ink); font-family: var(--demo-heading-font)`} data-qj-thanks-headline>
            {mock.thanks}
          </span>
          <span class="text-[13px] text-qj-body" data-qj-ask-sub>{mock.sub}</span>
          <span class="hidden text-[13px] text-qj-body" data-qj-thanks-sub>{mock.thanksSub}</span>
        </div>
        <button
          type="button"
          data-qj-demo-cta
          class="shrink-0 cursor-pointer whitespace-nowrap rounded-sm px-[18px] py-[11px] text-[14px] font-semibold text-white transition"
          style={`background: var(--demo-accent)`}>
          {mock.cta}
        </button>
      </div>

      <div class="flex flex-col gap-2">
        <span class="h-2 w-full rounded-sm" style={`background: var(--demo-line)`} aria-hidden="true"></span>
        <span class="h-2 w-[74%] rounded-sm" style={`background: var(--demo-line)`} aria-hidden="true"></span>
      </div>
    </div>

    <div class="flex flex-col items-start gap-1 border-t border-qj-line-card bg-qj-code px-5 py-3 font-mono text-[12px] sm:flex-row sm:items-center sm:justify-between sm:gap-3">
      <span class="break-all text-qj-body">{mock.snippet}</span>
      <span class="whitespace-nowrap text-qj-accent">{mock.live}</span>
    </div>
  </div>
</div>

<style>
  .mock-card {
    box-shadow: 0 28px 56px -26px rgba(20, 32, 28, 0.28);
  }

  [data-qj-mock][data-preset="docs"] {
    --demo-bg: #ffffff;
    --demo-ink: #171a18;
    --demo-line: #f0ede6;
    --demo-widget-bg: #f2f7f3;
    --demo-accent: #0b6b3a;
    --demo-heading-font: var(--font-display);
  }

  [data-qj-mock][data-preset="blog"] {
    --demo-bg: #fbf7ef;
    --demo-ink: #2b2013;
    --demo-line: #eae1d0;
    --demo-widget-bg: #fbf7ef;
    --demo-accent: #8a5a2b;
    --demo-heading-font: Georgia, "Times New Roman", serif;
  }

  [data-qj-mock][data-preset="magazine"] {
    --demo-bg: #f5f4f2;
    --demo-ink: #111111;
    --demo-line: #dedcd8;
    --demo-widget-bg: #f5f4f2;
    --demo-accent: #c4372b;
    --demo-heading-font: "Arial Narrow", Arial, sans-serif;
  }

  [data-qj-mock][data-state="thanks"] [data-qj-demo-cta] {
    opacity: 0.4;
    pointer-events: none;
    box-shadow: none;
  }

  [data-qj-mock][data-state="thanks"] [data-qj-ask-headline],
  [data-qj-mock][data-state="thanks"] [data-qj-ask-sub] {
    display: none;
  }

  [data-qj-mock][data-state="thanks"] [data-qj-thanks-headline],
  [data-qj-mock][data-state="thanks"] [data-qj-thanks-sub] {
    display: block;
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>("[data-qj-demo]");

  if (root) {
    const mock = root.querySelector<HTMLElement>("[data-qj-mock]");
    const presetButtons = [...root.querySelectorAll<HTMLButtonElement>("[data-preset-btn]")];

    for (const button of presetButtons) {
      button.addEventListener("click", () => {
        mock?.setAttribute("data-preset", button.dataset.presetBtn ?? "docs");
        for (const other of presetButtons) {
          other.setAttribute("aria-pressed", String(other === button));
        }
      });
    }

    root.querySelector("[data-qj-demo-cta]")?.addEventListener("click", () => {
      mock?.setAttribute("data-state", "thanks");
    });
  }
</script>
