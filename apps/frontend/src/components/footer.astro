---
import { getCollection } from "astro:content";
import Container from "@/components/container.astro";
import Logo from "@/components/logo.astro";
import { dictionary } from "@/i18n/t";
import { localizedPath } from "@/lib/links";

const locale = Astro.currentLocale ?? "en";
const copy = dictionary(locale);
const siteLinks = copy.footer.siteLinks.map((link) => ({
  ...link,
  path: localizedPath(link.path, locale),
}));
const compareLinks = copy.footer.compareLinks.map((link) => ({
  ...link,
  path: localizedPath(link.path, locale),
}));

const legalDocs = (await getCollection("legal", ({ id }) => id.startsWith(`${locale}/`)))
  .map((entry) => ({
    slug: entry.id.split("/")[1],
    ...entry.data,
    path: localizedPath(`/legal/${entry.id.split("/")[1]}/`, locale),
  }))
  .sort((a, b) => a.order - b.order);
---

<footer class="bg-qj-field-deep">
  <Container class="py-16">
    <div class="flex flex-wrap items-start justify-between gap-x-16 gap-y-12">
      <div class="max-w-64">
        <a href="/" aria-label="QuietJar" class="flex items-center gap-0.5">
          <Logo class="h-11 w-auto" mark="#ffffff" quiet="#86C4A3" jar="#ffffff" />
        </a>
        <p class="mt-4 text-[13.5px] leading-[1.6] text-white/52">
          {copy.footer.address.map((line) => <>{line}<br /></>)}
        </p>
      </div>

      <div class="flex flex-wrap gap-16">
        <div>
          <p class="text-[13px] font-semibold tracking-wide text-white/50 uppercase">
            {copy.footer.navHeading}
          </p>
          <ul class="mt-4 space-y-2.5">
            {
              siteLinks.map((link) => (
                <li>
                  <a href={link.path} class="text-[14px] text-white/70 hover:text-white">
                    {link.title}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>

        <div>
          <p class="text-[13px] font-semibold tracking-wide text-white/50 uppercase">
            {copy.footer.compareHeading}
          </p>
          <ul class="mt-4 space-y-2.5">
            {
              compareLinks.map((link) => (
                <li>
                  <a href={link.path} class="text-[14px] text-white/70 hover:text-white">
                    {link.title}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>

        <div>
          <p class="text-[13px] font-semibold tracking-wide text-white/50 uppercase">
            {copy.footer.legalHeading}
          </p>
          <ul class="mt-4 space-y-2.5">
            {
              legalDocs.map((doc) => (
                <li>
                  <a href={doc.path} class="text-[14px] text-white/70 hover:text-white">
                    {doc.navTitle ?? doc.title}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>

    <div
      class="mt-14 flex flex-wrap items-center justify-between gap-x-8 gap-y-4 border-t border-white/10 pt-8">
      <span class="text-[13.5px] leading-[1.5] text-white/52">
        {copy.footer.copyright.replace("{year}", String(new Date().getFullYear()))}
      </span>
      <a
        href="https://goodfolk.eu/"
        rel="noopener"
        aria-label={`${copy.footer.poweredBy} Goodfolk`}
        class="inline-flex items-center gap-[11px] text-white no-underline">
        <span class="text-[14px] font-normal opacity-60">{copy.footer.poweredBy}</span>
        <svg viewBox="0 0 187.57 40.23" height="20" width="93.3" fill="currentColor" aria-hidden="true" class="block flex-none">
