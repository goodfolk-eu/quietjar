---
import { dictionary } from "@/i18n/t";

const copy = dictionary(Astro.currentLocale ?? "en");
const logos = copy.logos;
---

<div class="mt-24">
  <p class="text-center text-slate-600 text-sm">
    {logos.text}
  </p>
  <ul class="flex gap-8 md:gap-16 items-center justify-center mt-8 flex-wrap text-slate-600 font-semibold tracking-wide">
    {logos.methods.map((method) => (
      <li class="text-xl">{method}</li>
    ))}
  </ul>
</div>
