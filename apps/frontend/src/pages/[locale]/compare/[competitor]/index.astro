---
import Container from "@/components/container.astro";
import { locales } from "@/i18n/config";
import { dictionary } from "@/i18n/t";
import Layout from "@/layouts/Layout.astro";

// This route has two dynamic segments (locale and competitor), so it writes
// its own getStaticPaths rather than reusing the shared one-param helper.
// getStaticPaths runs before the frontmatter body, so it can only reference
// imports and its own locals here.
export function getStaticPaths() {
  return locales.flatMap((locale) =>
    ["ko-fi", "buymeacoffee"].map((competitor) => ({ params: { locale, competitor } })),
  );
}

const competitor = Astro.params.competitor as "ko-fi" | "buymeacoffee";
const copy = dictionary(Astro.currentLocale ?? "en");
const compare = copy.compare;
const page = compare[competitor];
---

<Layout title={page.meta.title} description={page.meta.description}>
  <Container class="py-16 lg:py-24">
    <div class="mx-auto max-w-[720px]">
      <span class="text-[13.5px] font-medium text-qj-green">{page.eyebrow}</span>
      <h1 class="mt-4 text-balance font-display text-[44px] font-bold leading-[1.05] tracking-[-0.028em] text-qj-ink">
        {page.title}
      </h1>
      <p class="mt-5 max-w-[52ch] text-pretty text-[17px] leading-[1.62] text-qj-ink-2">{page.intro}</p>

      <div class="mt-14 flex flex-col gap-10">
        {
          page.sections.map((section) => (
            <section class="border-t border-qj-line pt-8">
              <h2 class="font-display text-[24px] font-bold tracking-[-0.028em] text-qj-ink">{section.name}</h2>
              <p class="mt-3 text-pretty text-[15.5px] leading-[1.65] text-qj-ink-2">{section.text}</p>
              {section.text2 && (
                <p class="mt-3 text-pretty text-[15.5px] leading-[1.65] text-qj-ink-2">{section.text2}</p>
              )}
            </section>
          ))
        }
      </div>
    </div>

    <div class="mx-auto mt-14 max-w-[900px]">
      <div class="overflow-x-auto">
        <table class="w-full min-w-[720px] border-collapse text-left text-[14px]">
          <thead>
            <tr class="border-b border-qj-line-3">
              {
                compare.tableHead.map((heading) => (
                  <th scope="col" class="px-3 py-3 font-mono text-[11px] font-medium uppercase tracking-[0.08em] text-qj-ink-3">
                    {heading}
                  </th>
                ))
              }
            </tr>
          </thead>
          <tbody>
            {
              page.table.rows.map((row) => (
                <tr class="border-b border-qj-line-2 align-top">
                  {row.map((cell, i) => (
                    <td class:list={["px-3 py-3 leading-[1.5]", i === 0 ? "font-semibold text-qj-ink" : "text-qj-ink-2"]}>
                      {cell}
                    </td>
                  ))}
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>

      {
        compare.notes.map((note) => (
          <p class="mt-6 text-[13.5px] leading-[1.6] text-qj-ink-3">{note}</p>
        ))
      }
    </div>

    <div class="mx-auto mt-14 max-w-[720px] border-t border-qj-line pt-10">
      <button
        type="button"
        data-auth-mode="signup"
        data-dashboard-label={copy.nav.dashboard}
        class="cursor-pointer rounded-sm bg-qj-green px-6 py-3.5 text-center text-[15px] font-semibold text-white transition hover:bg-qj-green-press">
        {page.cta}
      </button>
    </div>
  </Container>
</Layout>
