---
import Container from "@/components/container.astro";
import { dictionary } from "@/i18n/t";
import Layout from "@/layouts/Layout.astro";

export { getStaticPaths } from "@/lib/locale-paths";

const locale = Astro.currentLocale ?? "en";
const copy = dictionary(locale);
const dev = copy.developers;
---

<Layout
  title="QuietJar for developers - One script tag, no layout shift"
  description="Add QuietJar to any site with one script tag. No layout shift, the payment methods people already use, and it steps back after someone gives.">
  <Container class="py-16 lg:py-24">
    <div class="mx-auto max-w-[720px]">
    <div class="flex flex-col gap-4">
      <span class="text-[13.5px] font-medium text-qj-green">{dev.eyebrow}</span>
      <h1 class="text-balance font-display text-[44px] font-bold leading-[1.05] tracking-[-0.028em] text-qj-ink">
        {dev.title}
      </h1>
      <p class="max-w-[52ch] text-pretty text-[17px] leading-[1.62] text-qj-ink-2">{dev.sub}</p>
    </div>

    <div class="mt-14 flex flex-col gap-14">
      <section class="flex flex-col gap-4">
        <h2 class="font-display text-[26px] font-bold tracking-[-0.028em] text-qj-ink">{dev.install.title}</h2>
        <div class="flex justify-end">
          <button
            id="qj-dev-copy"
            type="button"
            data-copied={dev.install.copied}
            class="cursor-pointer px-1 py-1 text-[13.5px] font-semibold text-qj-ink transition hover:text-qj-accent">
            {dev.install.copy}
          </button>
        </div>
        <pre id="qj-dev-snippet" class="whitespace-pre-wrap break-all rounded border border-qj-line bg-qj-surface px-5 py-4 font-mono text-[13px] leading-[1.8] text-qj-ink-2">{dev.snippet}</pre>
        <ol class="flex flex-col gap-2.5 text-[15.5px] leading-[1.6] text-qj-ink-2">
          {
            dev.install.steps.map((step, i) => (
              <li class="flex gap-3">
                <span class="w-6 shrink-0 font-mono text-[12.5px] text-qj-ink-4">0{i + 1}</span>
                <span>{step}</span>
              </li>
            ))
          }
        </ol>
        <p class="text-[15.5px] leading-[1.62] text-qj-ink-2">{dev.install.frameworks}</p>
      </section>
      <section class="flex flex-col gap-4">
        <h2 class="font-display text-[26px] font-bold tracking-[-0.028em] text-qj-ink">{dev.settings.title}</h2>
        <p class="text-[15.5px] leading-[1.62] text-qj-ink-2">{dev.settings.intro}</p>
      </section>
    </div>
    </div>

    <div class="mx-auto mt-10 max-w-[900px]">
        <div class="overflow-x-auto">
          <table class="w-full min-w-[720px] border-collapse text-left text-[14px]">
            <thead>
              <tr class="border-b border-qj-line-3">
                <th scope="col" class="px-3 py-3 font-mono text-[11px] font-medium uppercase tracking-[0.08em] text-qj-ink-3"></th>
                <th scope="col" class="px-3 py-3 font-mono text-[11px] font-medium uppercase tracking-[0.08em] text-qj-ink-3">{dev.settings.columns.type}</th>
                <th scope="col" class="px-3 py-3 font-mono text-[11px] font-medium uppercase tracking-[0.08em] text-qj-ink-3">{dev.settings.columns.required}</th>
                <th scope="col" class="px-3 py-3 font-mono text-[11px] font-medium uppercase tracking-[0.08em] text-qj-ink-3">{dev.settings.columns.default}</th>
                <th scope="col" class="px-3 py-3 font-mono text-[11px] font-medium uppercase tracking-[0.08em] text-qj-ink-3">{dev.settings.columns.description}</th>
              </tr>
            </thead>
            <tbody>
              {
                dev.settings.rows.map((row) => (
                  <tr class="border-b border-qj-line-2 align-top">
                    <td class="px-3 py-3 font-semibold text-qj-ink">{row.name}</td>
                    <td class="px-3 py-3 leading-[1.5] text-qj-ink-2">{row.type}</td>
                    <td class="px-3 py-3 leading-[1.5] text-qj-ink-2">{row.required}</td>
                    <td class="px-3 py-3 leading-[1.5] text-qj-ink-2">{row.default}</td>
                    <td class="px-3 py-3 leading-[1.5] text-qj-ink-2">{row.description}</td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
    </div>

    <div class="mx-auto mt-6 max-w-[720px]">
      <div class="flex flex-col gap-14">
      <section class="flex flex-col gap-4">
        <p class="text-[14.5px] leading-[1.62] text-qj-ink-4">{dev.settings.siteNote}</p>
        <h3 class="pt-2 font-display text-[20px] font-bold tracking-[-0.02em] text-qj-ink">{dev.settings.examplesTitle}</h3>
        <dl class="flex flex-col gap-3 text-[15.5px] leading-[1.6]">
          {
            dev.settings.examples.map((example) => (
              <div class="flex flex-col gap-0.5 border-b border-qj-line-2 pb-3 last:border-none sm:flex-row sm:gap-6">
                <dt class="w-36 shrink-0 font-mono text-[13px] font-semibold text-qj-ink">{example.name}</dt>
                <dd class="text-qj-ink-2">{example.line}</dd>
              </div>
            ))
          }
        </dl>
        <h3 class="pt-2 font-display text-[20px] font-bold tracking-[-0.02em] text-qj-ink">{dev.settings.invalidTitle}</h3>
        <p class="text-[15.5px] leading-[1.62] text-qj-ink-2">{dev.settings.invalid}</p>
      </section>

      <section class="flex flex-col gap-4">
        <h2 class="font-display text-[26px] font-bold tracking-[-0.028em] text-qj-ink">{dev.performance.title}</h2>
        <p class="text-[15.5px] leading-[1.62] text-qj-ink-2">{dev.performance.text}</p>
      </section>

      <section class="flex flex-col gap-4">
        <h2 class="font-display text-[26px] font-bold tracking-[-0.028em] text-qj-ink">{dev.stepsBack.title}</h2>
        <p class="text-[15.5px] leading-[1.62] text-qj-ink-2">{dev.stepsBack.text}</p>
      </section>

      <section class="flex flex-col gap-4">
        <h2 class="font-display text-[26px] font-bold tracking-[-0.028em] text-qj-ink">{dev.methods.title}</h2>
        <dl class="flex flex-col gap-3 text-[15.5px] leading-[1.6]">
          {
            dev.methods.items.map((method) => (
              <div class="flex flex-col gap-0.5 border-b border-qj-line-2 pb-3 last:border-none sm:flex-row sm:gap-6">
                <dt class="w-32 shrink-0 font-semibold text-qj-ink">{method.name}</dt>
                <dd class="text-qj-ink-2">{method.line}</dd>
              </div>
            ))
          }
        </dl>
      </section>

      <section class="flex flex-col gap-4">
        <h2 class="font-display text-[26px] font-bold tracking-[-0.028em] text-qj-ink">{dev.goals.title}</h2>
        <p class="text-[15.5px] leading-[1.62] text-qj-ink-2">{dev.goals.text}</p>
      </section>

      <section class="flex flex-col gap-4">
        <h2 class="font-display text-[26px] font-bold tracking-[-0.028em] text-qj-ink">{dev.programmatic.title}</h2>
        <p class="text-[15.5px] leading-[1.62] text-qj-ink-2">{dev.programmatic.text}</p>
      </section>

      <div class="border-t border-qj-line pt-10">
        <button
          data-auth-mode="signup"
          data-dashboard-label={copy.nav.dashboard}
          type="button"
          class="cursor-pointer rounded-sm bg-qj-green px-6 py-3.5 text-center text-[15px] font-semibold text-white transition hover:bg-qj-green-press">
          {dev.cta}
        </button>
      </div>
    </div>
    </div>
  </Container>
</Layout>

<script>
  import { readSiteKey } from "@/lib/session";

  const snippet = document.getElementById("qj-dev-snippet");
  const copyButton = document.getElementById("qj-dev-copy");

  // The snippet ships with a placeholder site id; a signed-in visitor gets
  // their own key from localStorage, which the dashboard stored on sign-in.
  const siteKey = readSiteKey();
  if (snippet && siteKey !== "") {
    snippet.textContent = (snippet.textContent ?? "").replace(
      /"site":\s*"[^"]*"/,
      `"site": "${siteKey}"`,
    );
  }

  if (snippet && copyButton) {
    const label = copyButton.textContent ?? "";
    const copied = copyButton.dataset.copied ?? label;
    copyButton.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(snippet.textContent ?? "");
        copyButton.textContent = copied;
      } catch {
        return;
      }
      setTimeout(() => {
        copyButton.textContent = label;
      }, 2000);
    });
  }
</script>
