---
import { SUPPORTED_COUNTRIES, SUPPORTED_CURRENCIES } from "@quietjar/backend/currency";
import Container from "@/components/container.astro";
import { dictionary } from "@/i18n/t";
import DashboardLayout from "@/layouts/DashboardLayout.astro";

export { getStaticPaths } from "@/lib/locale-paths";

const copy = dictionary(Astro.currentLocale ?? "en");
const payout = copy.payout;

// Imported from the backend rather than mirrored, so a new country or currency
// is one edit. Both lists are plain constants with no runtime dependencies.
const regionNames = new Intl.DisplayNames(["en"], { type: "region" });
const countries = SUPPORTED_COUNTRIES.map((code) => ({
  value: code,
  label: regionNames.of(code) ?? code,
})).sort((a, b) => a.label.localeCompare(b.label));

const currencyNames = new Intl.DisplayNames(["en"], { type: "currency" });
const currencies = SUPPORTED_CURRENCIES.map((code) => ({
  value: code,
  label: `${currencyNames.of(code.toUpperCase()) ?? code} (${code.toUpperCase()})`,
})).sort((a, b) => a.label.localeCompare(b.label));

// Step one is ours; the rest are Stripe's, and only they carry a status badge.
const steps = [
  { key: "identity", copy: payout.steps.identity },
  { key: "localMethods", copy: payout.steps.localMethods },
  { key: "payouts", copy: payout.steps.payouts },
];

const inputClass =
  "w-full rounded-lg border border-gray-200 px-3 py-2 text-sm text-gray-800 focus:border-gray-600 focus:outline-hidden focus:ring-3 focus:ring-gray-100";
const fieldClass = `mt-2 ${inputClass}`;
const cardClass = "rounded-xl border border-gray-200 bg-white p-5";
const buttonClass =
  "rounded-lg bg-qj-green px-4 py-2.5 text-sm font-medium text-white transition hover:bg-qj-green-press focus:outline-hidden focus-visible:ring-3 focus-visible:ring-gray-200 disabled:pointer-events-none disabled:opacity-50";
const skeletonSteps = [1, 2, 3, 4];
const stepClass = "rounded-lg border border-gray-200 p-4";
const labelClass = "block text-sm font-medium text-gray-700";
const hintClass = "mt-1 text-xs text-gray-500";
---

<DashboardLayout title={payout.title}>
  <Container>
    <p class="text-sm text-gray-600">{payout.intro}</p>

    <div id="qj-payout" class="mt-5 max-w-2xl space-y-5" data-i18n={JSON.stringify(payout)}>
      <p
        id="qj-pay-banner"
        class="hidden rounded-lg border border-gray-200 bg-gray-50 px-4 py-3 text-sm text-gray-700"
      >
      </p>

      <section id="qj-balance" class={`${cardClass} hidden`}>
        <h2 class="text-base font-semibold text-gray-800">{payout.balance.title}</h2>
        <div class="mt-4 flex flex-wrap items-end justify-between gap-4">
          <div>
            <p class="text-sm text-gray-600">{payout.balance.available}</p>
            <p id="qj-balance-available" class="mt-1 text-3xl font-semibold text-gray-800"></p>
          </div>
          <button type="button" id="qj-balance-payout" disabled class={buttonClass}>
            {payout.balance.payOut}
          </button>
        </div>
        <p id="qj-balance-minimum" class="mt-3 hidden text-sm text-gray-600"></p>
        <p id="qj-balance-pending" class="mt-2 hidden text-xs text-gray-500"></p>
      </section>

      <section id="qj-pay-steps" class={cardClass} aria-busy="true">
        <h2 class="text-base font-semibold text-gray-800">{payout.stepsTitle}</h2>
        <div id="qj-pay-loading" class="mt-5 space-y-4" aria-hidden="true">
          {
            skeletonSteps.map(() => (
              <div class={`${stepClass} animate-pulse`}>
                <div class="flex items-start justify-between gap-3">
                  <div class="h-4 w-40 rounded-md bg-gray-200" />
                  <div class="h-6 w-16 rounded-full bg-gray-100" />
                </div>
                <div class="mt-2 h-3.5 w-3/4 rounded-md bg-gray-100" />
              </div>
            ))
          }
        </div>
        <ol id="qj-pay-list" class="mt-5 hidden space-y-4">
          <li class={stepClass} data-step="details">
            <div class="flex items-start justify-between gap-3">
              <h3 class="text-sm font-semibold text-gray-800">{payout.steps.details.title}</h3>
              <span class="hidden shrink-0 rounded-full px-3 py-1 text-xs font-medium" data-badge></span>
            </div>

            {/* The form and the summary are the same step in two states: open
                while the payment account does not exist, closed once it does. */}
            <div id="qj-details-form">
              <p class="mt-1 text-sm text-gray-600">{payout.steps.details.todo}</p>

              <div class="mt-4">
                <label for="qj-pay-country" class={labelClass}>{payout.country}</label>
                <p class={hintClass}>{payout.countryHint}</p>
                <select id="qj-pay-country" required class={fieldClass}>
                  <option value="">{payout.countryPlaceholder}</option>
                  {countries.map((country) => <option value={country.value}>{country.label}</option>)}
                </select>
              </div>

              <div class="mt-4">
                <label for="qj-pay-entity" class={labelClass}>{payout.accountType}</label>
                <select id="qj-pay-entity" required class={fieldClass}>
                  <option value="individual">{payout.accountTypeIndividual}</option>
                  <option value="company">{payout.accountTypeCompany}</option>
                </select>
              </div>

              <div class="mt-4">
                <label for="qj-currency" class={labelClass}>{payout.currency}</label>
                <p class={hintClass}>{payout.currencyHint}</p>
                <select id="qj-currency" class={fieldClass}>
                  {currencies.map((currency) => <option value={currency.value}>{currency.label}</option>)}
                </select>
              </div>

              <div class="mt-4">
                <p id="qj-site-urls-label" class={labelClass}>{payout.siteUrlLabel}</p>
                <p class={hintClass}>{payout.siteUrlHint}</p>
                <ul
                  id="qj-site-urls"
                  class="mt-2 space-y-2"
                  data-field-class={`${inputClass} aria-[invalid=true]:border-red-400`}
                >
                </ul>
                <button
                  type="button"
                  id="qj-site-add"
                  class="mt-2 text-sm text-qj-blue underline underline-offset-2"
                >
                  {payout.addSite}
                </button>
              </div>

              <p id="qj-site-status" class="mt-3 text-xs text-gray-500" role="status" aria-live="polite"></p>

              <button type="button" id="qj-pay-connect" disabled class={`${buttonClass} mt-4 w-full`}>
                {payout.connect}
              </button>
              <p id="qj-pay-gate" class="mt-2 text-center text-xs text-gray-500">
                {payout.detailsIncomplete}
              </p>
            </div>

            <div id="qj-details-summary" class="hidden">
              <p id="qj-details-line" class="mt-1 text-sm text-gray-600"></p>
              <button
                type="button"
                id="qj-details-edit"
                class="mt-2 text-sm text-qj-blue underline underline-offset-2"
              >
                {payout.edit}
              </button>
            </div>
          </li>

          {
            steps.map((step) => (
              <li class={stepClass} data-step={step.key}>
                <div class="flex items-start justify-between gap-3">
                  <h3 class="text-sm font-semibold text-gray-800">{step.copy.title}</h3>
                  <span class="hidden shrink-0 rounded-full px-3 py-1 text-xs font-medium" data-badge />
                </div>
                <p class="mt-1 text-sm text-gray-600" data-description />
                <p class="mt-2 hidden text-sm text-red-700" data-issue />
                <button type="button" class={`${buttonClass} mt-4 hidden`} data-action>
                  {step.copy.action}
                </button>
              </li>
            ))
          }
        </ol>
        <button type="button" id="qj-pay-dashboard" class="mt-5 hidden text-sm text-qj-blue underline underline-offset-2">
          {payout.openDashboard}
        </button>
      </section>
    </div>
  </Container>
</DashboardLayout>

<script>
  import { currencyForCountry } from "@quietjar/backend/currency";
  import { MAX_SITE_URLS, normalizeSiteUrls } from "@quietjar/backend/site-urls";
  import { api } from "@/lib/api";
  import { formatMoney } from "@/lib/money";
  import { rememberSiteKey } from "@/lib/session";
  type StepKey = "identity" | "localMethods" | "payouts";
  type StepState = "todo" | "pending" | "done" | "unavailable";
  type StepIssue = "verificationFailed" | "invalidInformation" | "needsAttention";
  type Onboarding = Record<StepKey, StepState> & {
    issues?: Partial<Record<StepKey, StepIssue>>;
  };

  type ConnectionBody = {
    connection?: { onboarding: Onboarding | null } | null;
    url?: string;
    error?: string;
  } | null;

  type BalanceBody = {
    available?: number;
    pending?: number;
    minimum?: number;
    currency?: string;
    amount?: number;
    error?: string;
  } | null;

  interface StepCopy {
    title: string;
    todo: string;
    pending: string;
    done: string;
    unavailable?: string;
    action: string;
  }

  interface Copy {
    balance: {
      pending: string;
      payOut: string;
      payingOut: string;
      belowMinimum: string;
      paidOut: string;
      errorBelowMinimum: string;
    };
    connect: string;
    connecting: string;
    edit: string;
    editHint: string;
    detailsIncomplete: string;
    siteUrlInvalid: string;
    removeSite: string;
    moreSites: string;
    saving: string;
    saved: string;
    saveFailed: string;
    state: Record<StepState, string>;
    issues: Record<StepIssue, string>;
    steps: Record<StepKey | "details", StepCopy>;
    bannerReturn: string;
    errorGeneric: string;
    errorNotConfigured: string;
    errorLocalMethodsUnavailable: string;
    errorSiteNotConfigured: string;
  }

  const root = document.getElementById("qj-payout");
  const stepsCard = document.getElementById("qj-pay-steps");

  void (async () => {
    if (!(root && stepsCard)) return;

    const copy = JSON.parse(root.dataset.i18n ?? "{}") as Copy;

    const banner = document.getElementById("qj-pay-banner");
    const countryField = document.getElementById("qj-pay-country") as HTMLSelectElement | null;
    const entityField = document.getElementById("qj-pay-entity") as HTMLSelectElement | null;
    const currencyField = document.getElementById("qj-currency") as HTMLSelectElement | null;
    const siteUrlListField = document.getElementById("qj-site-urls");
    const siteAddField = document.getElementById("qj-site-add");
    const siteStatusField = document.getElementById("qj-site-status");
    const connectField = document.getElementById("qj-pay-connect") as HTMLButtonElement | null;
    const gateHint = document.getElementById("qj-pay-gate");
    const detailsFormField = document.getElementById("qj-details-form");
    const detailsSummaryField = document.getElementById("qj-details-summary");
    const detailsLineField = document.getElementById("qj-details-line");
    const detailsEdit = document.getElementById("qj-details-edit");
    const dashboardButton = document.getElementById("qj-pay-dashboard") as HTMLButtonElement | null;
    const balanceCard = document.getElementById("qj-balance");
    const balanceAvailable = document.getElementById("qj-balance-available");
    const balanceMinimum = document.getElementById("qj-balance-minimum");
    const balancePending = document.getElementById("qj-balance-pending");
    const payoutButton = document.getElementById("qj-balance-payout") as HTMLButtonElement | null;

    if (
      !(
        countryField &&
        entityField &&
        currencyField &&
        siteUrlListField &&
        siteAddField &&
        siteStatusField &&
        connectField &&
        detailsFormField &&
        detailsSummaryField &&
        detailsLineField
      )
    ) {
      return;
    }

    // Re-bound inside the guard so the null checks above narrow them for the
    // helpers below, which are hoisted past the check.
    const countrySelect = countryField;
    const entitySelect = entityField;
    const currencySelect = currencyField;
    const siteUrlList = siteUrlListField;
    const siteAddButton = siteAddField;
    const siteStatus = siteStatusField;
    const connectButton = connectField;
    const detailsForm = detailsFormField;
    const detailsSummary = detailsSummaryField;
    const detailsLine = detailsLineField;

    const badgeStyles: Record<StepState, string> = {
      todo: "bg-gray-100 text-gray-700",
      pending: "bg-amber-100 text-amber-800",
      done: "bg-green-100 text-green-800",
      unavailable: "bg-gray-100 text-gray-500",
    };

    const show = (element: Element | null, visible: boolean) => {
      element?.classList.toggle("hidden", !visible);
    };

    const detailsItem = stepsCard.querySelector<HTMLElement>('[data-step="details"]');

    /** Mirrors the server: an account cannot be opened without all four. */
    let connected = false;
    // Sticky: autosave re-renders the step on every keystroke, and without this
    // the summary would snap shut over a creator part-way through an edit.
    let editing = false;
    const details = {
      country: "",
      entityType: "individual",
      currency: "eur",
      siteUrls: [] as string[],
    };

    function detailsComplete(): boolean {
      return details.country !== "" && details.currency !== "";
    }

    function restartIfConnectionReset(body: ConnectionBody): boolean {
      if (body?.error !== "connection_reset") return false;
      window.location.reload();
      return true;
    }

    function hideBanner(): void {
      show(banner, false);
    }

    function showBanner(text: string, isError: boolean): void {
      if (!banner) return;
      banner.textContent = text;
      banner.className = isError
        ? "rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800"
        : "rounded-lg border border-green-200 bg-green-50 px-4 py-3 text-sm text-green-800";
    }

    function setBadge(item: HTMLElement | null, state: StepState): void {
      const badge = item?.querySelector<HTMLElement>("[data-badge]");
      if (!badge) return;
      badge.textContent = copy.state[state];
      badge.className = `shrink-0 rounded-full px-3 py-1 text-xs font-medium ${badgeStyles[state]}`;
    }

    /**
     * Step one is a form until the payment account exists and a summary after,
     * because Stripe freezes the country and business type at that point.
     */
    function renderDetails(): void {
      setBadge(detailsItem, connected ? "done" : "todo");
      show(detailsForm, !connected || editing);
      show(detailsSummary, connected && !editing);
      if (connected) {
        const country = countrySelect.querySelector<HTMLOptionElement>(
          `option[value="${details.country}"]`,
        );
        const [mainSite, ...otherSites] = details.siteUrls;
        const sites = mainSite
          ? [
              mainSite.replace(/^https?:\/\//, ""),
              otherSites.length > 0 ? copy.moreSites.replace("{count}", String(otherSites.length)) : "",
            ]
              .filter(Boolean)
              .join(" ")
          : "";
        detailsLine.textContent = [country?.textContent?.trim(), details.currency.toUpperCase(), sites]
          .filter(Boolean)
          .join(" · ");
      }
      const ready = detailsComplete();
      connectButton.disabled = !ready;
      // While editing the hint carries the frozen-fields explanation instead.
      if (gateHint && !editing) gateHint.hidden = ready;
    }

    async function saveDetails(): Promise<void> {
      siteStatus.textContent = copy.saving;
      const { data, error } = await api.api.sites.current.put({
        currency: details.currency,
        siteUrls: details.siteUrls,
        country: details.country === "" ? null : details.country,
        entityType: details.entityType,
      });
      const saved = error ? undefined : data?.site;
      if (!saved) {
        siteStatus.textContent = copy.saveFailed;
        return;
      }
      // The server stores bare origins, so show what it kept rather than what
      // was typed: that is what payments are checked against.
      showSavedSiteUrls(saved.siteUrls);
      siteStatus.textContent = copy.saved;
      renderDetails();
    }

    let saveTimer: ReturnType<typeof setTimeout> | undefined;
    function scheduleSave(): void {
      clearTimeout(saveTimer);
      saveTimer = setTimeout(() => {
        void saveDetails();
      }, 600);
    }

    countrySelect.addEventListener("change", () => {
      details.country = countrySelect.value;
      // Currency follows the country. Both stay editable, so a creator
      // collecting from an audience elsewhere can still change it back.
      if (details.country !== "") {
        details.currency = currencyForCountry(details.country);
        currencySelect.value = details.currency;
      }
      renderDetails();
      void saveDetails();
    });

    entitySelect.addEventListener("change", () => {
      details.entityType = entitySelect.value;
      void saveDetails();
    });

    currencySelect.addEventListener("change", () => {
      details.currency = currencySelect.value;
      void saveDetails();
    });

    function siteUrlInputs(): HTMLInputElement[] {
      return [...siteUrlList.querySelectorAll<HTMLInputElement>("input")];
    }

    /** Marks the first invalid row and returns false, so a half-typed address is never sent. */
    function readSiteUrls(): boolean {
      const inputs = siteUrlInputs();
      const result = normalizeSiteUrls(inputs.map((input) => input.value));
      for (const [index, input] of inputs.entries()) {
        input.setAttribute("aria-invalid", String(!result.ok && result.invalidIndex === index));
      }
      siteStatus.textContent = result.ok ? "" : copy.siteUrlInvalid;
      if (!result.ok) return false;
      details.siteUrls = inputs.map((input) => input.value.trim()).filter((value) => value !== "");
      return true;
    }

    function syncSiteAdd(): void {
      siteAddButton.hidden = siteUrlInputs().length >= MAX_SITE_URLS;
    }

    function addSiteUrlRow(value: string): HTMLInputElement {
      const row = document.createElement("li");
      row.className = "flex items-center gap-2";

      const input = document.createElement("input");
      input.type = "text";
      input.inputMode = "url";
      input.spellcheck = false;
      input.placeholder = "example.com";
      input.value = value;
      input.className = siteUrlList.dataset.fieldClass ?? "";
      input.setAttribute("aria-labelledby", "qj-site-urls-label");
      input.addEventListener("input", () => {
        if (!readSiteUrls()) return;
        renderDetails();
        scheduleSave();
      });

      const remove = document.createElement("button");
      remove.type = "button";
      remove.className =
        "inline-flex size-8 shrink-0 items-center justify-center rounded-full text-gray-800 hover:bg-gray-100 focus:outline-hidden focus-visible:ring-3 focus-visible:ring-gray-100";
      remove.setAttribute("aria-label", copy.removeSite);
      const icon = document.createElement("span");
      icon.ariaHidden = "true";
      icon.className = "text-xl leading-none";
      icon.textContent = "\u00d7";
      remove.append(icon);
      remove.addEventListener("click", () => {
        row.remove();
        if (siteUrlInputs().length === 0) addSiteUrlRow("");
        syncSiteAdd();
        if (!readSiteUrls()) return;
        renderDetails();
        clearTimeout(saveTimer);
        void saveDetails();
      });

      row.append(input, remove);
      siteUrlList.append(row);
      syncSiteAdd();
      return input;
    }

    function renderSiteUrls(siteUrls: string[]): void {
      siteUrlList.replaceChildren();
      for (const siteUrl of siteUrls.length > 0 ? siteUrls : [""]) addSiteUrlRow(siteUrl);
    }

    /**
     * Rewrites the rows in place when every filled row survived, so the one
     * being typed in keeps focus. Merged duplicates change the count, and only
     * then is the list rebuilt.
     */
    function showSavedSiteUrls(siteUrls: string[]): void {
      details.siteUrls = siteUrls;
      const filled = siteUrlInputs().filter((input) => input.value.trim() !== "");
      if (filled.length !== siteUrls.length) {
        renderSiteUrls(siteUrls);
        return;
      }
      for (const [index, input] of filled.entries()) input.value = siteUrls[index];
    }

    siteAddButton.addEventListener("click", () => {
      addSiteUrlRow("").focus();
    });

    detailsEdit?.addEventListener("click", () => {
      editing = true;
      // Frozen on the Stripe account, so they are shown but not changeable.
      countrySelect.disabled = true;
      entitySelect.disabled = true;
      connectButton.hidden = true;
      renderDetails();
      if (gateHint) {
        gateHint.hidden = false;
        gateHint.textContent = copy.editHint;
      }
    });

    // Steps re-render on every status refresh; the balance only needs one read.
    let balanceRequested = false;

    function renderSteps(status: Onboarding | null): void {
      show(document.getElementById("qj-pay-loading"), false);
      show(document.getElementById("qj-pay-list"), true);
      stepsCard?.setAttribute("aria-busy", "false");
      const onboarding = status ?? { identity: "todo", localMethods: "todo", payouts: "todo", issues: {} };

      for (const key of ["identity", "localMethods", "payouts"] as StepKey[]) {
        const item = stepsCard?.querySelector<HTMLElement>(`[data-step="${key}"]`);
        if (!item) continue;
        const state = onboarding[key];
        const stepCopy = copy.steps[key];

        setBadge(item, state);

        const description = item.querySelector<HTMLElement>("[data-description]");
        if (description) {
          description.textContent =
            state === "unavailable" ? (stepCopy.unavailable ?? "") : stepCopy[state];
        }

        const issue = onboarding.issues?.[key];
        const issueLine = item.querySelector<HTMLElement>("[data-issue]");
        if (issueLine) {
          issueLine.textContent = issue ? copy.issues[issue] : "";
          show(issueLine, Boolean(issue));
        }

        // Shown but inert until the payment account exists: every one of these
        // calls /onboarding-link, which has nothing to link to before then.
        const action = item.querySelector<HTMLButtonElement>("[data-action]");
        show(action, state === "todo");
        if (action) action.disabled = !connected;
      }

      show(dashboardButton, onboarding.identity === "done");
      if (onboarding.payouts === "done" && !balanceRequested) {
        balanceRequested = true;
        void loadBalance();
      }
    }

    async function loadBalance(): Promise<void> {
      const { data, error } = await api.api.stripe.balance.get();
      const body = data as BalanceBody;
      if (restartIfConnectionReset(body)) return;
      if (error || body?.available === undefined || !body.currency) return;
      renderBalance(body.available, body.pending ?? 0, body.minimum ?? 0, body.currency);
    }

    function renderBalance(available: number, pending: number, minimum: number, currency: string) {
      if (!(balanceAvailable && balanceMinimum && balancePending && payoutButton)) return;
      const money = (minor: number) => formatMoney(minor, currency);
      balanceAvailable.textContent = money(available);
      const missing = minimum - available;
      payoutButton.disabled = missing > 0;
      balanceMinimum.textContent = copy.balance.belowMinimum
        .replace("{missing}", money(missing))
        .replace("{minimum}", money(minimum));
      show(balanceMinimum, missing > 0);
      balancePending.textContent = copy.balance.pending.replace("{amount}", money(pending));
      show(balancePending, pending > 0);
      show(balanceCard, true);
    }

    async function redirectToStep(step: StepKey, button: HTMLButtonElement): Promise<void> {
      button.disabled = true;
      try {
        const { data, error } = await api.api.stripe["onboarding-link"].post({ step });
        const body = data as ConnectionBody;
        if (restartIfConnectionReset(body)) return;
        if (error || !body?.url) {
          const message =
            body?.error === "local_methods_unavailable"
              ? copy.errorLocalMethodsUnavailable
              : copy.errorGeneric;
          showBanner(message, true);
          button.disabled = false;
          return;
        }
        window.location.href = body.url;
      } catch {
        showBanner(copy.errorGeneric, true);
        button.disabled = false;
      }
    }

    stepsCard.addEventListener("click", (event) => {
      const button = (event.target as HTMLElement).closest<HTMLButtonElement>("[data-action]");
      const step = button?.closest<HTMLElement>("[data-step]")?.dataset.step as StepKey | undefined;
      if (button && step) void redirectToStep(step, button);
    });

    dashboardButton?.addEventListener("click", async () => {
      dashboardButton.disabled = true;
      const { data, error } = await api.api.stripe["login-link"].post();
      const body = data as ConnectionBody;
      dashboardButton.disabled = false;
      if (restartIfConnectionReset(body)) return;
      if (error || !body?.url) {
        showBanner(copy.errorGeneric, true);
        return;
      }
      window.open(body.url, "_blank", "noopener,noreferrer");
    });

    payoutButton?.addEventListener("click", async () => {
      payoutButton.disabled = true;
      payoutButton.textContent = copy.balance.payingOut;
      try {
        const { data, error } = await api.api.stripe.payout.post();
        const body = data as BalanceBody;
        if (restartIfConnectionReset(body)) return;
        if (error || body?.amount === undefined || !body.currency) {
          const message =
            body?.error === "below_minimum" ? copy.balance.errorBelowMinimum : copy.errorGeneric;
          showBanner(message, true);
          return;
        }
        showBanner(copy.balance.paidOut.replace("{amount}", formatMoney(body.amount, body.currency)), false);
      } catch {
        showBanner(copy.errorGeneric, true);
      } finally {
        payoutButton.textContent = copy.balance.payOut;
        await loadBalance();
      }
    });

    connectButton.addEventListener("click", async () => {
      connectButton.disabled = true;
      connectButton.textContent = copy.connecting;
      try {
        const { data, error } = await api.api.stripe.connect.post();
        const body = data as ConnectionBody;
        if (restartIfConnectionReset(body)) return;
        if (error || !body?.url) {
          const message =
            body?.error === "stripe_not_configured"
              ? copy.errorNotConfigured
              : body?.error === "site_not_configured"
                ? copy.errorSiteNotConfigured
                : copy.errorGeneric;
          showBanner(message, true);
          return;
        }
        window.location.href = body.url;
      } finally {
        connectButton.textContent = copy.connect;
        renderDetails();
      }
    });

    const site = (await api.api.sites.current.get()).data?.site;
    if (site) {
      rememberSiteKey(site.publicKey);
      details.country = site.country ?? "";
      details.entityType = site.entityType ?? "individual";
      details.currency = site.currency;
      details.siteUrls = site.siteUrls;
      connected = site.connected;
      countrySelect.value = details.country;
      entitySelect.value = details.entityType;
      currencySelect.value = details.currency;
    }
    renderSiteUrls(details.siteUrls);
    renderDetails();

    /**
     * Account links are single use and expire within minutes, so Stripe sends
     * anyone who reloads or backs out to the refresh URL. Mint a fresh link for
     * the same step and send them straight back in.
     */
    const params = new URLSearchParams(window.location.search);
    const callback = params.get("stripe");
    const refreshStep = params.get("step") as StepKey | null;
    if (callback) history.replaceState(null, "", window.location.pathname);
    if (callback === "refresh" && refreshStep) {
      const { data } = await api.api.stripe["onboarding-link"].post({ step: refreshStep });
      const body = data as ConnectionBody;
      if (body?.url) {
        window.location.href = body.url;
        return;
      }
      showBanner(copy.errorGeneric, true);
    } else if (callback === "return") {
      showBanner(copy.bannerReturn, false);
    }

    const { data, error } = await api.api.stripe.connection.get();
    const body = (error ? null : (data as ConnectionBody)) ?? null;
    const connection = body?.connection ?? null;
    if (!connection) {
      renderSteps(null);
      return;
    }

    async function refreshSteps(): Promise<boolean> {
      const { data, error } = await api.api.stripe["refresh-status"].post();
      const body = data as ConnectionBody;
      if (restartIfConnectionReset(body)) return false;
      if (error || !body?.connection) {
        showBanner(copy.errorGeneric, true);
        return false;
      }
      renderSteps(body.connection.onboarding);
      return true;
    }

    renderSteps(connection.onboarding);
    if (!(await refreshSteps())) return;

    // Verification usually lands a moment after the redirect, so the state we
    // read on arrival is often already stale. Checking once more means the
    // creator does not have to work out that a reload is needed.
    if (callback === "return") {
      setTimeout(() => {
        void refreshSteps().then((ok) => {
          if (ok) hideBanner();
        });
      }, 5000);
    }
  })();
</script>
