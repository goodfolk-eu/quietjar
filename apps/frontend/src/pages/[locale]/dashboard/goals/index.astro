---
import Container from "@/components/container.astro";
import { dictionary } from "@/i18n/t";
import DashboardLayout from "@/layouts/DashboardLayout.astro";

export { getStaticPaths } from "@/lib/locale-paths";

const copy = dictionary(Astro.currentLocale ?? "en");
const goals = copy.goals;

const fieldClass =
  "mt-2 w-full rounded-lg border border-gray-200 px-3 py-2 text-sm text-gray-800 focus:border-gray-600 focus:outline-hidden focus:ring-3 focus:ring-gray-100";
const cardClass = "rounded-xl border border-gray-200 bg-white p-5";
const buttonClass =
  "rounded-lg bg-qj-green px-4 py-2.5 text-sm font-medium text-white transition hover:bg-qj-green-press focus:outline-hidden focus-visible:ring-3 focus-visible:ring-gray-200 disabled:pointer-events-none disabled:opacity-50";
const labelClass = "block text-sm font-medium text-gray-700";
const hintClass = "mt-1 text-xs text-gray-500";
---

<DashboardLayout title={goals.title}>
  <Container>
    <p class="text-sm text-gray-600">{goals.intro}</p>

    <div id="qj-goals" class="mt-5 max-w-2xl space-y-5" data-i18n={JSON.stringify(goals)}>
      <p
        id="qj-goals-notice"
        class="hidden rounded-lg border border-gray-200 bg-gray-50 px-4 py-3 text-sm text-gray-700"
      >
      </p>

      <section class={cardClass}>
        <div class="flex items-center justify-between gap-3">
          <h2 class="text-base font-semibold text-gray-800">{goals.title}</h2>
          <button id="qj-goal-add" type="button" class={buttonClass}>{goals.add}</button>
        </div>

        <p id="qj-goals-empty" class="mt-4 hidden text-sm text-gray-600">{goals.empty}</p>
        <ul id="qj-goals-list" class="mt-4 space-y-3"></ul>
      </section>
    </div>

    <div
      id="qj-goal-modal"
      class="hs-overlay pointer-events-none fixed start-0 top-0 z-80 hidden size-full overflow-y-auto overflow-x-hidden"
      role="dialog"
      tabindex="-1"
      aria-labelledby="qj-goal-modal-label"
    >
      <div
        class="m-3 mt-0 opacity-0 transition-all ease-out hs-overlay-open:mt-7 hs-overlay-open:opacity-100 hs-overlay-open:duration-500 sm:mx-auto sm:w-full sm:max-w-lg"
      >
        <div class="pointer-events-auto flex flex-col rounded-xl border border-gray-200 bg-white shadow-2xs">
          <div class="flex items-center justify-between border-b border-gray-200 px-4 py-3">
            <h3 id="qj-goal-modal-label" class="font-semibold text-gray-800">{goals.dialogAdd}</h3>
            <button
              type="button"
              class="inline-flex size-8 items-center justify-center rounded-full text-gray-800 hover:bg-gray-100 focus:outline-hidden focus-visible:ring-3 focus-visible:ring-gray-100"
              aria-label={goals.close}
              data-hs-overlay="#qj-goal-modal"
            >
              <span aria-hidden="true" class="text-xl leading-none">&times;</span>
            </button>
          </div>

          <div class="p-4">
            <div>
              <label for="qj-goal-name" class={labelClass}>{goals.name}</label>
              <p class={hintClass}>{goals.nameHint}</p>
              <input
                id="qj-goal-name"
                type="text"
                maxlength="80"
                placeholder={goals.namePlaceholder}
                class={fieldClass}
              />
            </div>

            <div class="mt-4">
              <label for="qj-goal-target" class={labelClass}>{goals.target}</label>
              <p class={hintClass}>{goals.targetHint}</p>
              <div class="mt-2 flex items-center gap-2">
                <span id="qj-goal-currency" class="text-sm font-medium text-gray-500"></span>
                <input
                  id="qj-goal-target"
                  type="number"
                  min="1"
                  max="1000000"
                  step="1"
                  class="w-full rounded-lg border border-gray-200 px-3 py-2 text-sm text-gray-800 focus:border-gray-600 focus:outline-hidden focus:ring-3 focus:ring-gray-100"
                />
              </div>
            </div>

            <div class="mt-4">
              <label for="qj-goal-window" class={labelClass}>{goals.window}</label>
              <p class={hintClass}>{goals.windowHint}</p>
              <select id="qj-goal-window" class={fieldClass}>
                <option value="monthly">{goals.windows.monthly}</option>
                <option value="lifetime">{goals.windows.lifetime}</option>
              </select>
            </div>

            <p id="qj-goal-error" class="mt-4 hidden text-sm text-red-700"></p>
          </div>

          <div class="flex items-center justify-end gap-2 border-t border-gray-200 px-4 py-3">
            <button
              type="button"
              class="rounded-lg border border-gray-200 px-4 py-2.5 text-sm font-medium text-gray-800 transition hover:bg-gray-50 focus:outline-hidden focus-visible:ring-3 focus-visible:ring-gray-100"
              data-hs-overlay="#qj-goal-modal"
            >
              {goals.cancel}
            </button>
            <button id="qj-goal-save" type="button" class={buttonClass}>{goals.save}</button>
          </div>
        </div>
      </div>
    </div>
  </Container>
</DashboardLayout>

<script>
  import "preline/plugins/overlay";
  import { api } from "@/lib/api";
  import { formatMoney } from "@/lib/money";

  // The plugin build carries no ESM export; it installs itself on window.
  type HSOverlayStatic = typeof import("preline/plugins/overlay").default;
  const overlay = (window as unknown as { HSOverlay?: HSOverlayStatic }).HSOverlay;

  interface Goal {
    id: string;
    name: string;
    target: number;
    window: "monthly" | "lifetime";
    raised: number;
  }

  const root = document.getElementById("qj-goals");
  const list = document.getElementById("qj-goals-list");
  const empty = document.getElementById("qj-goals-empty");
  const notice = document.getElementById("qj-goals-notice");
  const addButton = document.getElementById("qj-goal-add") as HTMLButtonElement | null;
  const modalLabel = document.getElementById("qj-goal-modal-label");
  const nameInput = document.getElementById("qj-goal-name") as HTMLInputElement | null;
  const targetInput = document.getElementById("qj-goal-target") as HTMLInputElement | null;
  const windowSelect = document.getElementById("qj-goal-window") as HTMLSelectElement | null;
  const currencyLabel = document.getElementById("qj-goal-currency");
  const errorEl = document.getElementById("qj-goal-error");
  const saveButton = document.getElementById("qj-goal-save") as HTMLButtonElement | null;

  if (
    root &&
    list &&
    empty &&
    notice &&
    addButton &&
    modalLabel &&
    nameInput &&
    targetInput &&
    windowSelect &&
    currencyLabel &&
    errorEl &&
    saveButton
  ) {
    // Re-bound inside the guard so the null checks above narrow them for the
    // helpers below, which are hoisted past the check.
    const listEl = list;
    const emptyEl = empty;
    const noticeEl = notice;
    const errorLine = errorEl;
    const addEl = addButton;
    const titleEl = modalLabel;
    const nameEl = nameInput;
    const targetEl = targetInput;
    const windowEl = windowSelect;
    const currencyEl = currencyLabel;
    const saveEl = saveButton;
    const copy = JSON.parse(root.dataset.i18n ?? "{}") as {
      edit: string;
      remove: string;
      limitReached: string;
      noSite: string;
      raised: string;
      reached: string;
      windows: { monthly: string; lifetime: string };
      dialogAdd: string;
      dialogEdit: string;
      removeConfirm: string;
      saveFailed: string;
      loadFailed: string;
    };

    const MAX_GOALS = 20;
    let currency = "eur";
    let goals: Goal[] = [];
    /** Null while adding; the goal being changed while editing. */
    let editingId: string | null = null;

    function showNotice(text: string): void {
      noticeEl.textContent = text;
      noticeEl.classList.remove("hidden");
    }

    function hideNotice(): void {
      noticeEl.classList.add("hidden");
    }

    function progressLine(goal: Goal): string {
      const raised = formatMoney(goal.raised, currency);
      if (goal.raised >= goal.target) return `${copy.reached}, ${raised}`;
      return `${raised} of ${formatMoney(goal.target, currency)} ${copy.raised}`;
    }

    function row(goal: Goal): HTMLLIElement {
      const item = document.createElement("li");
      item.className = "rounded-lg border border-gray-200 p-4";

      const head = document.createElement("div");
      head.className = "flex items-start justify-between gap-3";

      const heading = document.createElement("div");
      const name = document.createElement("div");
      name.className = "text-sm font-semibold text-gray-800";
      name.textContent = goal.name;
      const meta = document.createElement("div");
      meta.className = "mt-0.5 text-xs text-gray-500";
      meta.textContent = copy.windows[goal.window];
      heading.append(name, meta);

      const actions = document.createElement("div");
      actions.className = "flex shrink-0 gap-2";
      const edit = document.createElement("button");
      edit.type = "button";
      edit.className =
        "rounded-lg border border-gray-200 px-3 py-1.5 text-xs font-medium text-gray-800 transition hover:bg-gray-50 focus:outline-hidden focus-visible:ring-3 focus-visible:ring-gray-100";
      edit.textContent = copy.edit;
      edit.addEventListener("click", () => openDialog(goal));
      const remove = document.createElement("button");
      remove.type = "button";
      remove.className =
        "rounded-lg border border-gray-200 px-3 py-1.5 text-xs font-medium text-red-700 transition hover:bg-red-50 focus:outline-hidden focus-visible:ring-3 focus-visible:ring-red-100";
      remove.textContent = copy.remove;
      remove.addEventListener("click", () => void archive(goal));
      actions.append(edit, remove);

      head.append(heading, actions);

      const track = document.createElement("div");
      track.className = "mt-3 h-2 overflow-hidden rounded-full bg-gray-100";
      const fill = document.createElement("div");
      const ratio = goal.target > 0 ? Math.min(1, goal.raised / goal.target) : 0;
      fill.className = "h-full rounded-full bg-qj-green";
      fill.style.width = `${ratio * 100}%`;
      track.append(fill);

      const line = document.createElement("div");
      line.className = "mt-2 text-xs text-gray-600";
      line.textContent = progressLine(goal);

      item.append(head, track, line);
      return item;
    }

    function render(): void {
      listEl.replaceChildren(...goals.map(row));
      emptyEl.classList.toggle("hidden", goals.length > 0);
      addEl.disabled = goals.length >= MAX_GOALS;
      if (goals.length >= MAX_GOALS) showNotice(copy.limitReached);
    }

    function openDialog(goal: Goal | null): void {
      editingId = goal?.id ?? null;
      titleEl.textContent = goal ? copy.dialogEdit : copy.dialogAdd;
      nameEl.value = goal?.name ?? "";
      targetEl.value = goal ? String(goal.target / 100) : "";
      windowEl.value = goal?.window ?? "monthly";
      errorLine.classList.add("hidden");
      overlay?.open("#qj-goal-modal");
    }

    function closeDialog(): void {
      overlay?.close("#qj-goal-modal");
    }

    async function load(): Promise<void> {
      const { data, error } = await api.api.goals.get();
      const loaded = error ? undefined : data;
      if (!loaded?.goals) {
        // A creator who has not been through the payout page yet has no
        // site row, and so nothing to hang a goal off.
        showNotice(error?.status === 404 ? copy.noSite : copy.loadFailed);
        return;
      }
      hideNotice();
      currency = loaded.currency ?? currency;
      currencyEl.textContent = currency.toUpperCase();
      goals = loaded.goals;
      render();
    }

    async function save(): Promise<void> {
      const body = {
        name: nameEl.value,
        target: Number(targetEl.value),
        window: windowEl.value,
      };
      saveEl.disabled = true;
      const { error } = editingId
        ? await api.api.goals({ id: editingId }).put(body)
        : await api.api.goals.post(body);
      saveEl.disabled = false;
      if (error) {
        errorLine.textContent = copy.saveFailed;
        errorLine.classList.remove("hidden");
        return;
      }
      closeDialog();
      await load();
    }

    async function archive(goal: Goal): Promise<void> {
      if (!window.confirm(copy.removeConfirm)) return;
      const { error } = await api.api.goals({ id: goal.id }).delete();
      if (error) {
        showNotice(copy.saveFailed);
        return;
      }
      await load();
    }

    addButton.addEventListener("click", () => openDialog(null));
    saveButton.addEventListener("click", () => void save());

    void load();
  }
</script>
