---
import {
  DEFAULT_ACTION_LABEL,
  DEFAULT_CLOSE_ENABLED,
  DEFAULT_COLOR,
  DEFAULT_CORNER,
  DEFAULT_FONT,
  DEFAULT_HEADLINE,
  FONT_PRESETS,
  ICON_LIBRARY,
  ICON_PRESETS,
  PIGGY_ICON,
} from "@quietjar/widget/config";
import Container from "@/components/container.astro";
import { dictionary } from "@/i18n/t";
import DashboardLayout from "@/layouts/DashboardLayout.astro";

export { getStaticPaths } from "@/lib/locale-paths";

const copy = dictionary(Astro.currentLocale ?? "en");
const widget = copy.widget;

// The snippet is pasted into a live site, so it points at the deployed bundle
// rather than the origin serving the dashboard, which is localhost in dev.
const widgetSrc = import.meta.env.PUBLIC_WIDGET_URL ?? "https://quietjar.com/js/latest/quietjar.js";

// Laid out as a 3-column grid, so the order matches the on-page positions.
const corners = [
  { value: "top-left", label: widget.corners.topLeft, dot: "top-1 start-1" },
  { value: "top-center", label: widget.corners.topCenter, dot: "top-1 left-1/2 -translate-x-1/2" },
  { value: "top-right", label: widget.corners.topRight, dot: "top-1 end-1" },
  { value: "bottom-left", label: widget.corners.bottomLeft, dot: "bottom-1 start-1" },
  {
    value: "bottom-center",
    label: widget.corners.bottomCenter,
    dot: "bottom-1 left-1/2 -translate-x-1/2",
  },
  { value: "bottom-right", label: widget.corners.bottomRight, dot: "bottom-1 end-1" },
];

// The swatch colour is a utility class rather than a style attribute so it
// survives the site's style-src policy, which has no unsafe-inline.
const presetColors = [
  { hex: "#0f172a", swatch: "bg-[#0f172a]" },
  { hex: "#e11d48", swatch: "bg-[#e11d48]" },
  { hex: "#f59e0b", swatch: "bg-[#f59e0b]" },
  { hex: "#059669", swatch: "bg-[#059669]" },
  { hex: "#0284c7", swatch: "bg-[#0284c7]" },
  { hex: "#7c3aed", swatch: "bg-[#7c3aed]" },
];

const fieldClass =
  "mt-2 w-full rounded-lg border border-gray-200 px-3 py-2 text-sm text-gray-800 focus:border-gray-600 focus:outline-hidden focus:ring-3 focus:ring-gray-100";
const cardClass = "rounded-xl border border-gray-200 bg-white p-5";
---

<DashboardLayout title={widget.title}>
  <Container>
    <p class="text-sm text-gray-600">{widget.intro}</p>

    <div
      id="qj-widget-settings"
      class="mt-5 grid gap-6 lg:grid-cols-5"
      data-widget-src={widgetSrc}
      data-i18n={JSON.stringify({
        copy: widget.copy,
        copied: widget.copied,
        copyFailed: widget.copyFailed,
      })}
    >
      <section class={`lg:col-span-2 ${cardClass}`}>
        <h2 class="text-base font-semibold text-gray-800">{widget.settings}</h2>

        <fieldset class="mt-5">
          <legend class="text-sm font-medium text-gray-700">{widget.position}</legend>
          <p class="mt-1 text-xs text-gray-500">{widget.positionHint}</p>
          <div class="mt-3 grid grid-cols-3 gap-3">
            {
              corners.map((corner) => (
                <button
                  type="button"
                  data-corner={corner.value}
                  aria-pressed={corner.value === DEFAULT_CORNER ? "true" : "false"}
                  aria-label={corner.label}
                  class="group rounded-lg border-2 border-gray-200 p-2 transition hover:border-gray-300 focus:outline-hidden focus-visible:ring-3 focus-visible:ring-gray-100 aria-pressed:border-gray-800"
                >
                  <span class="relative block h-12 w-full rounded-sm bg-gray-100">
                    <span
                      class:list={[
                        "absolute size-3 rounded-full bg-gray-300 transition group-aria-pressed:bg-gray-800",
                        corner.dot,
                      ]}
                    />
                  </span>
                </button>
              ))
            }
          </div>
        </fieldset>

        <fieldset class="mt-6">
          <legend class="text-sm font-medium text-gray-700">{widget.color}</legend>
          <p class="mt-1 text-xs text-gray-500">{widget.colorHint}</p>
          <div class="mt-3 flex flex-wrap gap-2">
            {
              presetColors.map((preset) => (
                <button
                  type="button"
                  data-color={preset.hex}
                  aria-pressed={preset.hex === DEFAULT_COLOR ? "true" : "false"}
                  aria-label={preset.hex}
                  class:list={[
                    "size-8 rounded-full ring-offset-2 transition focus:outline-hidden focus-visible:ring-3 focus-visible:ring-gray-200 aria-pressed:ring-2 aria-pressed:ring-gray-800",
                    preset.swatch,
                  ]}
                />
              ))
            }
          </div>
          <div class="mt-3 flex items-end gap-3">
            <div>
              <label for="qj-color-picker" class="block text-xs text-gray-500">{widget.customColor}</label>
              <input
                id="qj-color-picker"
                type="color"
                value={DEFAULT_COLOR}
                class="mt-2 h-10 w-14 cursor-pointer rounded-lg border border-gray-200 bg-white p-1"
              />
            </div>
            <div class="flex-1">
              <label for="qj-color-hex" class="block text-xs text-gray-500">{widget.hexValue}</label>
              <input
                id="qj-color-hex"
                type="text"
                spellcheck="false"
                value={DEFAULT_COLOR}
                class={`${fieldClass} font-mono`}
              />
            </div>
          </div>
        </fieldset>

        <div class="mt-6">
          <label for="qj-headline" class="block text-sm font-medium text-gray-700">{widget.headline}</label>
          <p class="mt-1 text-xs text-gray-500">{widget.headlineHint}</p>
          <div class="relative">
            <input
              id="qj-headline"
              type="text"
              value={DEFAULT_HEADLINE}
              class={`${fieldClass} block pe-9`}
            />
            <button
              id="qj-headline-clear"
              type="button"
              aria-label={widget.clearHeadline}
              class="absolute end-2.5 top-1/2 flex size-6 -translate-y-1/2 items-center justify-center rounded-full text-gray-400 transition hover:bg-gray-100 hover:text-gray-600 focus:outline-hidden focus-visible:ring-3 focus-visible:ring-gray-100"
            >
              <svg
                class="size-3.5"
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M6 18 18 6M6 6l12 12"></path>
              </svg>
            </button>
          </div>
        </div>

        <div class="mt-6">
          <label for="qj-body" class="block text-sm font-medium text-gray-700">{widget.body}</label>
          <p class="mt-1 text-xs text-gray-500">{widget.bodyHint}</p>
          <textarea id="qj-body" rows="3" class={`${fieldClass} resize-y`}></textarea>
        </div>

        <div class="mt-6">
          <label for="qj-action" class="block text-sm font-medium text-gray-700">{widget.actionLabel}</label>
          <p class="mt-1 text-xs text-gray-500">{widget.actionLabelHint}</p>
          <input
            id="qj-action"
            type="text"
            value={DEFAULT_ACTION_LABEL}
            class={fieldClass}
          />
        </div>

        <button
          type="button"
          data-hs-collapse="#qj-advanced"
          aria-expanded="false"
          class="hs-collapse-toggle mt-6 flex w-full items-center justify-between rounded-lg border border-gray-200 px-4 py-2.5 text-sm font-medium text-gray-700 transition hover:bg-gray-50 focus:outline-hidden focus-visible:ring-3 focus-visible:ring-gray-100"
        >
          {widget.advanced}
          <svg
            class="size-4 shrink-0 text-gray-400 transition-transform duration-200 hs-collapse-open:rotate-180"
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="m6 9 6 6 6-6"></path>
          </svg>
        </button>

        <div id="qj-advanced" class="hs-collapse hidden">
          <fieldset class="mt-6">
            <legend class="text-sm font-medium text-gray-700">{widget.font}</legend>
            <p class="mt-1 text-xs text-gray-500">{widget.fontHint}</p>
            <select id="qj-font" class={fieldClass}>
              {
                FONT_PRESETS.map((font) => (
                  <option value={font} selected={font === DEFAULT_FONT}>
                    {widget.fonts[font]}
                  </option>
                ))
              }
              <option value="inherit">{widget.fonts.inherit}</option>
            </select>
          </fieldset>

          <fieldset class="mt-6">
            <legend class="text-sm font-medium text-gray-700">{widget.icon}</legend>
            <p class="mt-1 text-xs text-gray-500">{widget.iconHint}</p>
            <div class="mt-3 flex flex-wrap gap-2">
              <button
                type="button"
                data-icon={PIGGY_ICON}
                aria-pressed="true"
                aria-label={widget.iconPiggy}
                class="flex size-9 items-center justify-center rounded-lg border-2 border-gray-200 transition hover:border-gray-300 focus:outline-hidden focus-visible:ring-3 focus-visible:ring-gray-100 aria-pressed:border-gray-800"
              >
                <svg class="size-5" viewBox="45 13 150 150" aria-hidden="true">
                  <defs>
                    <mask id="qj-editor-piggy-mask" maskUnits="userSpaceOnUse" x="0" y="0" width="240" height="180">
                      <clipPath id="qj-editor-piggy-clip"><rect x="56.9" y="44.4" width="126.3" height="99.2" rx="47.6"></rect></clipPath>
                      <g fill="#fff" stroke="#fff" stroke-width="6" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M68.5 64.2 L45.3 56.9 L70.6 81.1 Z"></path>
                        <path d="M78.4 121.2 L99.5 121.2 L87.5 157.1 L77.2 157.1 Z"></path>
                        <path d="M140.5 121.2 L161.6 121.2 L162.8 157.1 L152.5 157.1 Z"></path>
                        <path d="M193.3 80.6 L174.3 79 L163.5 131.5 L193.3 104.6 Z"></path>
                        <path d="M140.7 33.3 L194.2 55.8 L138.1 73.2 Z"></path>
                        <rect x="59.9" y="47.4" width="120.3" height="93.2" rx="44.6"></rect>
                        <path d="M116.5 44.9 L147.6 17.8 L138.9 91 Z"></path>
                      </g>
                      <g clip-path="url(#qj-editor-piggy-clip)">
                        <path d="M116.5 44.9 L147.6 17.8 L138.9 91 Z" fill="#000" stroke="#000" stroke-width="6" stroke-linejoin="round"></path>
                        <path d="M113.6 44.3 L127.1 35.7 L122.6 57.5 Z" fill="#000"></path>
                      </g>
                      <circle cx="160.5" cy="80.5" r="7.2" fill="#000"></circle>
                    </mask>
                  </defs>
                  <rect x="0" y="0" width="240" height="180" fill="currentColor" mask="url(#qj-editor-piggy-mask)"></rect>
                </svg>
              </button>
              {
                ICON_PRESETS.map((icon) => (
                  <button
                    type="button"
                    data-icon={icon}
                    aria-pressed="false"
                    aria-label={icon}
                    class="size-9 rounded-lg border-2 border-gray-200 text-lg leading-none transition hover:border-gray-300 focus:outline-hidden focus-visible:ring-3 focus-visible:ring-gray-100 aria-pressed:border-gray-800"
                  >
                    {icon}
                  </button>
                ))
              }
              <button
                type="button"
                data-icon=""
                aria-pressed="false"
                aria-label={widget.iconNone}
                class="flex size-9 items-center justify-center rounded-lg border-2 border-gray-200 text-gray-400 transition hover:border-gray-300 focus:outline-hidden focus-visible:ring-3 focus-visible:ring-gray-100 aria-pressed:border-gray-800"
              >
                <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <circle cx="12" cy="12" r="9"></circle>
                  <path d="M5.8 5.8l12.4 12.4" stroke-linecap="round"></path>
                </svg>
              </button>
            </div>
            <div class="mt-3 flex items-end gap-3">
              <div>
                <label for="qj-icon-custom" class="block text-xs text-gray-500">{widget.customIcon}</label>
                <input
                  id="qj-icon-custom"
                  type="text"
                  maxlength="8"
                  value=""
                  class={`${fieldClass} w-20 text-center`}
                />
              </div>

              <div class="hs-dropdown [--placement:bottom-left] relative inline-flex">
                <button
                  id="qj-icon-browse"
                  type="button"
                  aria-haspopup="menu"
                  aria-expanded="false"
                  class="rounded-lg border border-gray-200 px-3 py-2 text-sm text-gray-700 transition hover:bg-gray-50 focus:outline-hidden focus-visible:ring-3 focus-visible:ring-gray-100"
                >
                  {widget.browseIcons}
                </button>

                <div
                  class="hs-dropdown-menu duration z-50 hidden w-72 rounded-lg border border-gray-200 bg-white p-2 opacity-0 shadow-md transition-[opacity,margin] hs-dropdown-open:opacity-100"
                  role="menu"
                  aria-orientation="horizontal"
                  aria-labelledby="qj-icon-browse"
                >
                  <div class="grid grid-cols-8 gap-1">
                    {
                      ICON_LIBRARY.map((icon) => (
                        <button
                          type="button"
                          role="menuitem"
                          data-icon={icon}
                          aria-pressed="false"
                          aria-label={icon}
                          class="size-8 rounded-md text-lg leading-none transition hover:bg-gray-100 focus:outline-hidden focus-visible:ring-3 focus-visible:ring-gray-100 aria-pressed:bg-gray-800 aria-pressed:text-white"
                        >
                          {icon}
                        </button>
                      ))
                    }
                </div>
              </div>
            </div>
          </div>
          </fieldset>

          <div class="mt-6">
            <label for="qj-close" class="flex items-center gap-2.5 text-sm font-medium text-gray-700">
              <input
                id="qj-close"
                type="checkbox"
                checked={DEFAULT_CLOSE_ENABLED}
                class="size-4 accent-gray-800"
              />
              {widget.closeEnabled}
            </label>
            <p class="mt-1 text-xs text-gray-500">{widget.closeEnabledHint}</p>
          </div>
        </div>

      </section>

      <section class={`self-start lg:sticky lg:top-20 lg:col-span-3 ${cardClass}`}>
        <h2 class="text-base font-semibold text-gray-800">{widget.preview}</h2>
        <p class="mt-1 text-xs text-gray-500">{widget.previewHint}</p>

        <div class="mt-4 overflow-hidden rounded-xl border border-gray-200 shadow-2xs">
          <div class="flex items-center gap-2 border-b border-gray-200 bg-gray-50 px-3 py-2">
            <span class="size-2.5 rounded-full bg-gray-300"></span>
            <span class="size-2.5 rounded-full bg-gray-300"></span>
            <span class="size-2.5 rounded-full bg-gray-300"></span>
            <span class="ms-2 rounded-full bg-white px-3 py-0.5 text-xs text-gray-400">{widget.previewUrl}</span>
          </div>
          <div class="qj-preview-viewport relative overflow-hidden bg-white">
            <div id="qj-preview" class="qj-preview-page absolute start-0 top-0 bg-white p-8">
              <div class="h-5 w-2/5 rounded-full bg-gray-200"></div>
              <div class="mt-6 space-y-3">
                <div class="h-3 w-full rounded-full bg-gray-100"></div>
                <div class="h-3 w-11/12 rounded-full bg-gray-100"></div>
                <div class="h-3 w-4/5 rounded-full bg-gray-100"></div>
              </div>
              <div class="mt-8 grid grid-cols-3 gap-4">
                <div class="h-20 rounded-lg bg-gray-100"></div>
                <div class="h-20 rounded-lg bg-gray-100"></div>
                <div class="h-20 rounded-lg bg-gray-100"></div>
              </div>
            </div>
          </div>
        </div>

        <div class="group relative mt-4">
          <button
            id="qj-generate"
            type="button"
            data-hs-overlay="#qj-embed-modal"
            disabled
            aria-describedby="qj-generate-hint"
            class="w-full rounded-lg bg-qj-green px-4 py-2.5 text-sm font-medium text-white transition hover:bg-qj-green-press focus:outline-hidden focus-visible:ring-3 focus-visible:ring-gray-200 disabled:pointer-events-none disabled:opacity-50"
          >
            {widget.generate}
          </button>
          {/* disabled:pointer-events-none on the button lets the hover fall
              through to this wrapper, which is what drives the tooltip. */}
          <span
            id="qj-generate-hint"
            role="tooltip"
            class="pointer-events-none absolute bottom-full left-1/2 z-10 mb-2 w-64 -translate-x-1/2 rounded-lg bg-gray-900 px-3 py-2 text-center text-xs text-white opacity-0 transition group-hover:opacity-100"
          >
            {widget.generateHint}
          </span>
        </div>
      </section>
    </div>

    <div
      id="qj-embed-modal"
      class="hs-overlay pointer-events-none fixed start-0 top-0 z-80 hidden size-full overflow-y-auto overflow-x-hidden"
      role="dialog"
      tabindex="-1"
      aria-labelledby="qj-embed-modal-label"
    >
      <div
        class="m-3 mt-0 opacity-0 transition-all ease-out hs-overlay-open:mt-7 hs-overlay-open:opacity-100 hs-overlay-open:duration-500 sm:mx-auto sm:w-full sm:max-w-2xl"
      >
        <div class="pointer-events-auto flex flex-col rounded-xl border border-gray-200 bg-white shadow-2xs">
          <div class="flex items-center justify-between border-b border-gray-200 px-4 py-3">
            <h3 id="qj-embed-modal-label" class="font-semibold text-gray-800">{widget.embedTitle}</h3>
            <button
              type="button"
              class="inline-flex size-8 items-center justify-center rounded-full text-gray-800 hover:bg-gray-100 focus:outline-hidden focus-visible:ring-3 focus-visible:ring-gray-100"
              aria-label={widget.close}
              data-hs-overlay="#qj-embed-modal"
            >
              <span aria-hidden="true" class="text-xl leading-none">&times;</span>
            </button>
          </div>
          <div class="overflow-y-auto p-4">
            <p class="text-sm text-gray-600">{widget.embedIntro}</p>
            <pre
              class="mt-3 whitespace-pre-wrap break-all rounded-lg bg-gray-900 p-4 text-xs leading-relaxed text-gray-100"><code id="qj-snippet"></code></pre>
          </div>
          <div class="flex items-center justify-end border-t border-gray-200 px-4 py-3">
            <button
              type="button"
              id="qj-copy"
              class="rounded-lg bg-gray-800 px-4 py-2 text-sm font-medium text-white transition hover:bg-gray-900 focus:outline-hidden focus-visible:ring-3 focus-visible:ring-gray-200"
            >
              {widget.copy}
            </button>
          </div>
        </div>
      </div>
    </div>
  </Container>
</DashboardLayout>

<style>
  .qj-preview-viewport {
    aspect-ratio: 16 / 10;
  }

  /* Scaling the mock page down keeps the widget's 56px button in proportion,
     and the transform also makes this element the containing block for the
     button's position: fixed, so it stays inside the frame. */
  .qj-preview-page {
    width: 125%;
    height: 125%;
    transform: scale(0.8);
    transform-origin: top left;
  }
</style>

<script>
  import "preline/plugins/collapse";
  import { API_ORIGIN, api } from "@/lib/api";
  import { mountWidget } from "@quietjar/widget/embed";
  import type { Corner, FontChoice } from "@quietjar/widget/config";
  import {
    DEFAULT_ACTION_LABEL,
    DEFAULT_CLOSE_ENABLED,
    DEFAULT_COLOR,
    DEFAULT_CORNER,
    DEFAULT_FONT,
    DEFAULT_HEADLINE,
    DEFAULT_ICON,
    PIGGY_ICON,
    resolveConfig,
  } from "@quietjar/widget/config";

  const root = document.getElementById("qj-widget-settings");
  const preview = document.getElementById("qj-preview");
  const headlineInput = document.getElementById("qj-headline") as HTMLInputElement | null;
  const headlineClear = document.getElementById("qj-headline-clear") as HTMLButtonElement | null;
  const bodyInput = document.getElementById("qj-body") as HTMLTextAreaElement | null;
  const actionInput = document.getElementById("qj-action") as HTMLInputElement | null;
  const iconInput = document.getElementById("qj-icon-custom") as HTMLInputElement | null;
  const colorPicker = document.getElementById("qj-color-picker") as HTMLInputElement | null;
  const hexInput = document.getElementById("qj-color-hex") as HTMLInputElement | null;
  const fontSelect = document.getElementById("qj-font") as HTMLSelectElement | null;
  const closeToggle = document.getElementById("qj-close") as HTMLInputElement | null;
  const snippetEl = document.getElementById("qj-snippet");
  const copyButton = document.getElementById("qj-copy");
  const generateEl = document.getElementById("qj-generate") as HTMLButtonElement | null;
  const generateHintEl = document.getElementById("qj-generate-hint");

  if (
    root &&
    preview &&
    headlineInput &&
    headlineClear &&
    bodyInput &&
    actionInput &&
    iconInput &&
    colorPicker &&
    hexInput &&
    fontSelect &&
    closeToggle &&
    snippetEl &&
    copyButton &&
    generateEl &&
    generateHintEl
  ) {
    // Re-bound inside the guard so the null checks above narrow them for the
    // helpers below, which are hoisted past the check.
    const generateButton = generateEl;
    const generateHint = generateHintEl;
    const previewPage = preview;
    const labels = JSON.parse(root.dataset.i18n ?? "{}") as {
      copy: string;
      copied: string;
      copyFailed: string;
    };
    const widgetSrc = root.dataset.widgetSrc ?? "";

    const site = { publicKey: "", currency: "eur", siteUrl: "" };
    // The snippet is only worth handing out once the widget can actually take
    // money, which needs both a site address and a verified Stripe identity.
    let identityDone = false;

    const state = {
      headline: DEFAULT_HEADLINE,
      body: "",
      actionLabel: DEFAULT_ACTION_LABEL,
      icon: DEFAULT_ICON,
      color: DEFAULT_COLOR,
      font: DEFAULT_FONT as FontChoice,
      corner: DEFAULT_CORNER as Corner,
      closeEnabled: DEFAULT_CLOSE_ENABLED,
    };

    const cornerButtons = root.querySelectorAll<HTMLButtonElement>("[data-corner]");
    const iconButtons = root.querySelectorAll<HTMLButtonElement>("[data-icon]");
    const swatches = root.querySelectorAll<HTMLButtonElement>("[data-color]");

    const resolved = () =>
      resolveConfig({
        // The preview talks to the same API base the dashboard does, so a
        // session it opens belongs to this site rather than the widget's
        // production default. The currency comes along because the amounts on
        // offer are bounded per currency, and the backend charges in the
        // site's own one regardless of what the preview shows.
        site: site.publicKey,
        currency: site.currency,
        api: API_ORIGIN,
        labels: {
          headline: state.headline,
          body: state.body,
          action: state.actionLabel,
          icon: state.icon,
        },
        style: { color: state.color, font: state.font },
        close: { enabled: state.closeEnabled },
        position: { corner: state.corner },
      });

    function snippet(): string {
      const config = resolved();
      // Escaping "<" keeps a headline containing a closing script tag from
      // breaking out of the snippet on the site owner's page.
      const json = JSON.stringify({
        site: site.publicKey,
        currency: site.currency,
        labels: {
          headline: config.headline,
          body: config.body,
          action: config.actionLabel,
          icon: config.icon,
        },
        style: { color: config.color, font: config.font },
        close: { enabled: config.closeEnabled },
        position: { corner: config.corner },
      }).replace(/</g, "\\u003c");
      return `<script>window.QuietJar = ${json};<\/script>\n<script src="${widgetSrc}" async><\/script>`;
    }

    function syncGenerate(): void {
      const ready = site.publicKey !== "" && site.siteUrl !== "" && identityDone;
      generateButton.disabled = !ready;
      generateHint.hidden = ready;
    }

    async function loadSite(): Promise<void> {
      const { data, error } = await api.api.sites.current.get();
      const loaded = error ? undefined : data?.site;
      if (!loaded) return;
      site.publicKey = loaded.publicKey;
      site.currency = loaded.currency;
      site.siteUrl = loaded.siteUrl ?? "";
      syncGenerate();
      render();
    }

    function render(): void {
      preview?.querySelector("[data-quietjar-host]")?.remove();
      const config = resolved();
      // The mock page is scaled and clipped, so the host is inserted into it
      // and the panel is placed against that frame instead of the browser
      // viewport the panel cannot reach.
      mountWidget(config, { viewport: previewPage, target: previewPage });
      if (snippetEl) snippetEl.textContent = snippet();

      for (const button of cornerButtons) {
        button.setAttribute("aria-pressed", String(button.dataset.corner === config.corner));
      }
      for (const swatch of swatches) {
        const match = swatch.dataset.color?.toLowerCase() === config.color.toLowerCase();
        swatch.setAttribute("aria-pressed", String(match));
      }
      for (const button of iconButtons) {
        button.setAttribute("aria-pressed", String(button.dataset.icon === config.icon));
      }
    }

    function setColor(value: string, syncInputs: boolean): void {
      state.color = value;
      const color = resolved().color;
      // <input type="color"> only accepts 6-digit hex, so shorthand and alpha
      // values from the text field are left for the text field alone.
      if (colorPicker && /^#[0-9a-f]{6}$/i.test(color)) colorPicker.value = color;
      if (syncInputs && hexInput) hexInput.value = value;
      render();
    }

    function setIcon(value: string, syncInput: boolean): void {
      state.icon = value;
      if (syncInput && iconInput) iconInput.value = value === PIGGY_ICON || value === "" ? "" : value;
      render();
    }

    for (const button of iconButtons) {
      button.addEventListener("click", () => setIcon(button.dataset.icon ?? DEFAULT_ICON, true));
    }

    iconInput.addEventListener("input", () => setIcon(iconInput.value, false));

    headlineInput.addEventListener("input", () => {
      state.headline = headlineInput.value;
      headlineClear.hidden = headlineInput.value === "";
      render();
    });

    headlineClear.addEventListener("click", () => {
      state.headline = "";
      headlineInput.value = "";
      headlineClear.hidden = true;
      render();
    });

    bodyInput.addEventListener("input", () => {
      state.body = bodyInput.value;
      render();
    });

    actionInput.addEventListener("input", () => {
      state.actionLabel = actionInput.value;
      render();
    });

    colorPicker.addEventListener("input", () => setColor(colorPicker.value, true));
    hexInput.addEventListener("input", () => setColor(hexInput.value.trim(), false));

    fontSelect.addEventListener("change", () => {
      state.font = fontSelect.value as FontChoice;
      render();
    });

    closeToggle.addEventListener("change", () => {
      state.closeEnabled = closeToggle.checked;
      render();
    });

    for (const swatch of swatches) {
      swatch.addEventListener("click", () => setColor(swatch.dataset.color ?? DEFAULT_COLOR, true));
    }

    for (const button of cornerButtons) {
      button.addEventListener("click", () => {
        state.corner = button.dataset.corner as Corner;
        render();
      });
    }

    async function loadPaymentsStatus(): Promise<void> {
      const { data, error } = await api.api.stripe.connection.get();
      if (error) return;
      const body = data as { connection?: { onboarding?: { identity?: string } | null } | null };
      identityDone = body?.connection?.onboarding?.identity === "done";
      syncGenerate();
    }

    void loadSite();
    void loadPaymentsStatus();

    let resetLabel: ReturnType<typeof setTimeout> | undefined;
    copyButton.addEventListener("click", async () => {
      clearTimeout(resetLabel);
      try {
        await navigator.clipboard.writeText(snippet());
        copyButton.textContent = labels.copied;
      } catch {
        copyButton.textContent = labels.copyFailed;
      }
      resetLabel = setTimeout(() => {
        copyButton.textContent = labels.copy;
      }, 2000);
    });

    render();
  }
</script>
