---
import Faq from "@/components/faq.astro";
import { dictionary } from "@/i18n/t";
import Layout from "@/layouts/Layout.astro";
import {
  breakdown,
  formatEuro,
  MAX_AMOUNT,
  MIN_AMOUNT,
  PRESET_AMOUNTS,
  QUIETJAR_RATE,
} from "@/lib/fees";
import { localizedPath } from "@/lib/links";

export { getStaticPaths } from "@/lib/locale-paths";

const copy = dictionary(Astro.currentLocale ?? "en");
const page = copy.pricingPage;
const comparePath = localizedPath("/compare/", Astro.currentLocale ?? "en");

// The point where the floor hands over to the percentage, so stepping either
// way from it shows the other half of the rule.
const defaultAmount = 10;
const initial = breakdown(defaultAmount);
const quietjarPercent = `${QUIETJAR_RATE * 100}%`;
const initialFeeLabel = initial.atMinimum ? page.example.minimumLabel : quietjarPercent;

const sectionPad = "px-10 max-[1000px]:px-6 max-[560px]:px-5";
---

<Layout title={page.meta.title} description={page.meta.description} faq={page.faq.items}>
  <!-- 1. The number, styled as a proper hero: a subtly shaded band behind the
       header (matching the homepage hero), then a white bar with quick facts. -->
  <div class="hero-wrap bg-qj-paper">
    <div class="hero-top">
      <div class="hero-shade"></div>
      <section class="relative">
        <div class:list={["relative mx-auto grid max-w-[1180px] grid-cols-1 items-center gap-10 pt-[clamp(56px,6.5vw,96px)] pb-[clamp(64px,7.5vw,104px)] lg:grid-cols-[minmax(0,0.85fr)_minmax(0,1.15fr)] lg:gap-16", sectionPad]}>
          <div class="flex flex-col gap-1">
            <span class="text-[13.5px] font-semibold tracking-[-0.005em] text-qj-accent">{page.hero.eyebrow}</span>
            <p class="font-display text-[clamp(112px,15vw,220px)] font-bold leading-[0.82] tracking-[-0.05em] text-qj-ink">
              {page.hero.number}
            </p>
            <p class="mt-2 font-mono text-[13px] uppercase tracking-[0.1em] text-qj-body">{page.hero.minimum}</p>
          </div>
          <div class="flex flex-col gap-6">
            <h1 class="max-w-[22ch] text-balance font-display text-[clamp(28px,3.2vw,42px)] font-bold leading-[1.12] tracking-[-0.028em] text-qj-ink">
              {page.hero.heading}
            </h1>
            <p class="max-w-[48ch] text-pretty text-[17.5px] leading-[1.68] text-qj-body">{page.hero.sub}</p>
          </div>
        </div>
      </section>
    </div>

    <div class="bg-white">
      <div class:list={["mx-auto max-w-[1180px] pt-[26px] pb-[28px]", sectionPad]}>
        <div class="flex flex-wrap gap-x-12 gap-y-3.5">
          {
            page.hero.trustBar.map((item) => (
              <p class="flex items-center gap-2 text-[14.5px] text-qj-body">
                <span class="text-qj-accent" aria-hidden="true">✓</span>
                {item}
              </p>
            ))
          }
        </div>
      </div>
    </div>
  </div>

  <style>
    .hero-wrap {
      position: relative;
    }

    .hero-top {
      position: relative;
      overflow: hidden;
      margin-top: -88px;
      padding-top: 88px;
    }

    .hero-shade {
      position: absolute;
      inset: 0;
      background: linear-gradient(
        102deg,
        rgba(20, 32, 28, 0) 40%,
        rgba(20, 32, 28, 0.035) 70%,
        rgba(20, 32, 28, 0.075) 100%
      );
    }
  </style>

  <!-- 2. What you keep -->
  <section id="example" class:list={["mx-auto max-w-[1180px] pt-[clamp(64px,8vw,112px)] pb-[clamp(64px,8vw,112px)]", sectionPad]}>
    <div class="max-w-[640px]">
      <h2 class="text-balance font-display text-[clamp(28px,3.4vw,44px)] font-bold leading-[1.05] tracking-[-0.028em] text-qj-ink">
        {page.example.title}
      </h2>
      <p class="mt-4 max-w-[44ch] text-pretty text-[17px] leading-[1.62] text-qj-body">{page.example.intro}</p>
    </div>

    <div
      class="mt-12 grid grid-cols-1 items-stretch gap-6 md:grid-cols-2 md:gap-8 lg:mt-14"
      data-qj-calc
      data-min={MIN_AMOUNT}
      data-max={MAX_AMOUNT}
      data-default-amount={defaultAmount}
      data-minimum-label={page.example.minimumLabel}>
      <!-- The instrument: the amount, in one bordered card with a left accent
           stripe, facing the answer panel beside it. -->
      <div class="flex h-full flex-col gap-7 rounded-lg border border-qj-line-card border-l-[3px] border-l-qj-accent bg-white p-7 sm:p-8">
        <div class="flex flex-col gap-3">
          <span id="qj-amount-label" class="font-mono text-[11.5px] uppercase tracking-[0.1em] text-qj-body">{page.example.amountLabel}</span>
          <div class="grid grid-cols-5 gap-2" role="group" aria-labelledby="qj-amount-label">
            {
              PRESET_AMOUNTS.map((amount) => (
                <button
                  type="button"
                  data-preset={amount}
                  aria-pressed={amount === defaultAmount ? "true" : "false"}
                  class="cursor-pointer rounded-sm border border-qj-line-card bg-qj-paper px-2 py-2.5 text-center text-[14.5px] font-medium text-qj-ink transition hover:border-qj-accent aria-pressed:border-qj-accent aria-pressed:bg-qj-accent aria-pressed:text-white">
                  €{amount}
                </button>
              ))
            }
          </div>
          <label class="flex items-center gap-2 rounded-sm border border-qj-line-card bg-qj-paper px-3 py-2.5 text-[14.5px] text-qj-ink focus-within:border-qj-accent">
            <span class="sr-only">{page.example.customLabel}</span>
            <span aria-hidden="true" class="text-qj-body">€</span>
            <input
              data-custom
              type="number"
              inputmode="decimal"
              min={MIN_AMOUNT}
              max={MAX_AMOUNT}
              step="0.01"
              placeholder={page.example.customLabel}
              class="w-full bg-transparent py-0.5 text-[14.5px] text-qj-ink outline-hidden placeholder:text-qj-body/70"
            />
          </label>
        </div>

      </div>

      <!-- The answer: the figure that matters, first and biggest, with the two
           lines that get to it underneath. The rate label flips to "minimum"
           below EUR 10, where the floor is what actually binds. -->
      <div class="flex h-full flex-col justify-center gap-6 rounded-lg bg-qj-field p-8 text-white sm:p-9" aria-live="polite">
        <div>
          <span class="font-mono text-[11.5px] uppercase tracking-[0.1em] text-qj-field-mint">{page.example.rows.receive}</span>
          <p class="mt-2 font-display text-[clamp(44px,6vw,64px)] font-bold leading-none tracking-[-0.03em] tabular-nums" data-out="net">
            {formatEuro(initial.net)}
          </p>
        </div>

        <dl class="flex flex-col border-t border-white/15 pt-5 text-[14.5px]">
          <div class="flex items-baseline justify-between gap-6 py-2">
            <dt class="text-white/72">{page.example.rows.pays}</dt>
            <dd class="font-mono tabular-nums" data-out="amount">{formatEuro(initial.amount)}</dd>
          </div>
          <div class="flex items-baseline justify-between gap-6 py-2">
            <dt class="text-white/72">
              {page.example.rows.quietjar}
              <span class="ml-1.5 font-mono text-[12px] text-qj-field-mint" data-out="rate">{initialFeeLabel}</span>
            </dt>
            <dd class="font-mono tabular-nums">−<span data-out="quietjar">{formatEuro(initial.quietjar)}</span></dd>
          </div>
        </dl>
      </div>
    </div>

    <noscript>
      <p class="mt-8 text-[15px] leading-[1.6] text-qj-body">{page.example.noscriptIntro}</p>
      <div class="overflow-x-auto">
        <table class="mt-3 w-full min-w-[420px] border-collapse text-left text-[14px]">
          <thead>
            <tr class="border-b border-qj-line-3">
              <th scope="col" class="px-3 py-3 font-mono text-[11px] font-medium uppercase tracking-[0.08em] text-qj-body">{page.example.rows.pays}</th>
              <th scope="col" class="px-3 py-3 font-mono text-[11px] font-medium uppercase tracking-[0.08em] text-qj-body">{page.example.rows.quietjar}</th>
              <th scope="col" class="px-3 py-3 font-mono text-[11px] font-medium uppercase tracking-[0.08em] text-qj-body">{page.example.rows.receive}</th>
            </tr>
          </thead>
          <tbody>
            {PRESET_AMOUNTS.map((amount) => (
              <tr class="border-b border-qj-line-2">
                <td class="px-3 py-3 font-semibold text-qj-ink">{formatEuro(amount)}</td>
                <td class="px-3 py-3 tabular-nums text-qj-body">{formatEuro(breakdown(amount).quietjar)}</td>
                <td class="px-3 py-3 tabular-nums text-qj-body">{formatEuro(breakdown(amount).net)}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </noscript>

    <!-- What supporters can pay with, inside the same block: it is the other
         half of the same promise, that the method never changes the answer. -->
    <div class="mt-[clamp(40px,5vw,64px)] flex flex-col gap-5 border-t border-qj-line-soft pt-[clamp(32px,4vw,48px)]">
      <div class="max-w-[640px]">
        <h3 class="text-balance font-display text-[clamp(20px,2.2vw,26px)] font-bold leading-[1.15] tracking-[-0.022em] text-qj-ink">
          {page.methods.title}
        </h3>
        <p class="mt-2.5 max-w-[52ch] text-pretty text-[15.5px] leading-[1.62] text-qj-body">{page.methods.text}</p>
      </div>
      <ul class="flex flex-wrap gap-2.5">
        {
          page.methods.items.map((item) => (
            <li class="rounded-sm border border-qj-line-card bg-white px-3.5 py-2 text-[14px] font-medium text-qj-ink">
              {item}
            </li>
          ))
        }
      </ul>
      <p class="max-w-[60ch] text-[13.5px] leading-[1.6] text-qj-body">{page.methods.note}</p>
    </div>
  </section>

  <!-- 3. Why it is worth it -->
  <section class:list={["mx-auto grid max-w-[1180px] grid-cols-1 items-start gap-[56px] border-t border-qj-line pt-[clamp(64px,8vw,112px)] pb-[clamp(64px,8vw,112px)] lg:grid-cols-[minmax(0,0.7fr)_minmax(0,1fr)] lg:gap-[72px]", sectionPad]}>
    <h2 class="text-balance font-display text-[clamp(28px,3.4vw,44px)] font-bold leading-[1.05] tracking-[-0.028em] text-qj-ink lg:sticky lg:top-[104px]">
      {page.why.title}
    </h2>
    <dl class="flex flex-col">
      {
        page.why.items.map((item) => (
          <div class="flex flex-col gap-1.5 border-t border-qj-line-soft py-6 first:border-t-0 first:pt-0 last:pb-0">
            <dt class="font-display text-[19px] font-bold tracking-[-0.022em] text-qj-ink">{item.lead}</dt>
            <dd class="max-w-[56ch] text-pretty text-[15.5px] leading-[1.62] text-qj-body">{item.text}</dd>
          </div>
        ))
      }
    </dl>
  </section>

  <!-- 4. Payouts -->
  <section class:list={["mx-auto grid max-w-[1180px] grid-cols-1 items-start gap-[24px] border-t border-qj-line pt-[clamp(56px,7vw,96px)] pb-[clamp(56px,7vw,96px)] lg:grid-cols-[minmax(0,0.7fr)_minmax(0,1fr)] lg:gap-[72px]", sectionPad]}>
    <h2 class="text-balance font-display text-[clamp(28px,3.4vw,44px)] font-bold leading-[1.05] tracking-[-0.028em] text-qj-ink">
      {page.payouts.title}
    </h2>
    <p class="max-w-[56ch] text-pretty text-[17px] leading-[1.62] text-qj-body">{page.payouts.text}</p>
  </section>

  <!-- 5. Questions -->
  <Faq
    title={page.faq.title}
    items={page.faq.items}
    gridClass={`mx-auto grid max-w-[1180px] grid-cols-1 items-start gap-[56px] border-t border-qj-line pt-[clamp(64px,8vw,112px)] pb-[clamp(64px,8vw,112px)] lg:grid-cols-[minmax(0,0.7fr)_minmax(0,1fr)] lg:gap-[72px] ${sectionPad}`}
    titleClass="text-balance font-display text-[clamp(28px,3.4vw,44px)] font-bold leading-[1.05] tracking-[-0.028em] text-qj-ink lg:sticky lg:top-[104px]"
  />

  <!-- 6. Closing -->
  <section class="bg-qj-field">
    <div class:list={["mx-auto flex max-w-[1180px] flex-col items-start gap-[22px] py-[clamp(64px,8vw,112px)]", sectionPad]}>
      <p class="max-w-[24ch] text-balance font-display text-[clamp(28px,3.6vw,44px)] font-bold leading-[1.05] tracking-[-0.028em] text-white">
        {page.closing.text}
      </p>
      <div class="mt-1.5 flex flex-col items-start gap-3.5 sm:flex-row sm:items-center">
        <button
          type="button"
          data-auth-mode="signup"
          data-dashboard-label={copy.nav.dashboard}
          class="cursor-pointer rounded-sm bg-white px-6 py-3.5 text-center text-[15px] font-semibold text-qj-field transition hover:bg-qj-paper">
          {page.closing.cta}
        </button>
        <a href={comparePath} class="rounded-sm px-1 py-3.5 text-center text-[15px] font-semibold text-qj-field-mint transition hover:text-white">
          {page.closing.secondary} →
        </a>
      </div>
    </div>
  </section>
</Layout>

<script>
import { breakdown, clampAmount, formatEuro, QUIETJAR_RATE } from "../../../lib/fees.ts";

const root = document.querySelector<HTMLElement>("[data-qj-calc]");

if (root) {
  const presets = Array.from(root.querySelectorAll<HTMLButtonElement>("[data-preset]"));
  const custom = root.querySelector<HTMLInputElement>("[data-custom]");
  // Some values (the rate label, in particular) are shown in more than one
  // place in the redesigned layout, so every [data-out] match gets updated,
  // not just the first.
  const out = (name: string) => Array.from(root.querySelectorAll<HTMLElement>(`[data-out="${name}"]`));

  const minimumLabel = root.dataset.minimumLabel ?? "minimum";
  const percentLabel = `${QUIETJAR_RATE * 100}%`;
  let amount = Number(root.dataset.defaultAmount ?? 10);

  function render() {
    const result = breakdown(amount);
    const set = (name: string, value: string) => {
      for (const el of out(name)) el.textContent = value;
    };
    set("amount", formatEuro(result.amount));
    set("quietjar", formatEuro(result.quietjar));
    set("net", formatEuro(result.net));
    set("rate", result.atMinimum ? minimumLabel : percentLabel);
    presets.forEach((btn) => {
      btn.setAttribute("aria-pressed", String(Number(btn.dataset.preset) === result.amount));
    });
  }

  presets.forEach((btn) => {
    btn.addEventListener("click", () => {
      amount = Number(btn.dataset.preset);
      if (custom) custom.value = "";
      render();
    });
  });

  custom?.addEventListener("input", () => {
    if (custom.value === "") return;
    amount = clampAmount(Number(custom.value));
    render();
  });

  custom?.addEventListener("blur", () => {
    if (custom.value === "") return;
    const clamped = clampAmount(Number(custom.value));
    custom.value = String(clamped);
    amount = clamped;
    render();
  });

  render();
}

</script>
