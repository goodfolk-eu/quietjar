---
import Cta from "@/components/cta.astro";
import MockGoal from "@/components/featurespage/mock-goal.astro";
import MockPayments from "@/components/featurespage/mock-payments.astro";
import MockReadme from "@/components/featurespage/mock-readme.astro";
import MockSettings from "@/components/featurespage/mock-settings.astro";
import MockSetup from "@/components/featurespage/mock-setup.astro";
import PerfBand from "@/components/featurespage/perf-band.astro";
import Section from "@/components/featurespage/section.astro";
import Tile from "@/components/featurespage/tile.astro";
import HeroBand from "@/components/heroband.astro";
import { dictionary } from "@/i18n/t";
import Layout from "@/layouts/Layout.astro";
import { localizedPath } from "@/lib/links";

export { getStaticPaths } from "@/lib/locale-paths";

const locale = Astro.currentLocale ?? "en";
const copy = dictionary(locale);
const fp = copy.featuresPage;
const pricingHref = localizedPath(fp.cta.secondaryHref, locale);
---

<Layout
  title="QuietJar features - Goals that end, fast checkout, full control"
  description="Goals that hide the button once they are met, a static widget that loads in 40 ms, Apple Pay and local methods on your site, dynamic images, and full configurability. No tracking.">
  <HeroBand trustBar={fp.hero.trustBar}>
    <div class="relative mx-auto flex max-w-[1180px] flex-col gap-[22px] px-10 pt-[clamp(56px,6.5vw,96px)] pb-[clamp(64px,7.5vw,104px)]">
      <span class="text-[13.5px] font-semibold tracking-[-0.005em] text-qj-accent">{fp.hero.eyebrow}</span>
      <h1 class="max-w-[720px] text-balance font-display text-[clamp(36px,4.6vw,58px)] font-bold leading-[1.07] tracking-[-0.028em] text-qj-ink">
        {fp.hero.title}
      </h1>
      <p class="max-w-[52ch] text-pretty text-[17.5px] leading-[1.68] text-qj-body">{fp.hero.sub}</p>
      <div class="mt-2 flex flex-wrap items-center gap-5">
        <button
          data-auth-mode="signup"
          data-dashboard-label={copy.nav.dashboard}
          type="button"
          class="cursor-pointer rounded-sm bg-qj-accent px-[26px] py-[15px] text-center text-[15px] font-semibold text-white transition hover:bg-qj-accent-alt">
          {fp.hero.ctaPrimary}
        </button>
      </div>
    </div>
  </HeroBand>

  <Section
    eyebrow={fp.goals.eyebrow}
    title={fp.goals.title}
    description={fp.goals.description}
    bullets={fp.goals.bullets}
    reverse
    noTopBorder>
    <MockGoal slot="visual" />
  </Section>

  <Section eyebrow={fp.setup.eyebrow} title={fp.setup.title} description={fp.setup.description} bullets={fp.setup.bullets}>
    <MockSetup slot="visual" />
  </Section>

  <PerfBand />

  <Section eyebrow={fp.payments.eyebrow} title={fp.payments.title} description={fp.payments.description}>
    <MockPayments slot="visual" />
  </Section>

  <section>
    <div class="mx-auto grid max-w-[1180px] grid-cols-1 gap-[72px] border-t border-qj-line px-10 pt-[clamp(72px,9vw,120px)] pb-[clamp(72px,9vw,120px)] md:grid-cols-2 md:gap-12">
      <Tile eyebrow={fp.image.eyebrow} title={fp.image.title} description={fp.image.description}>
        <MockReadme />
      </Tile>
      <Tile eyebrow={fp.configurable.eyebrow} title={fp.configurable.title} description={fp.configurable.description}>
        <MockSettings />
      </Tile>
    </div>
  </section>


  <Cta
    title={fp.cta.title}
    description={fp.cta.description}
    primary={fp.cta.primary}
    secondary={fp.cta.secondary}
    secondaryHref={pricingHref}
  />
</Layout>
