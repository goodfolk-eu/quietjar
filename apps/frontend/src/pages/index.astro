---
import Craft from "@/components/craft.astro";
import Cta from "@/components/cta.astro";
import Faq from "@/components/faq.astro";
import Features from "@/components/features.astro";
import Hero from "@/components/hero.astro";
import Polite from "@/components/polite.astro";
import Pricing from "@/components/pricing.astro";
import { dictionary } from "@/i18n/t";
import Layout from "@/layouts/Layout.astro";
import { localizedPath } from "@/lib/links";

const locale = Astro.currentLocale ?? "en";
const copy = dictionary(locale);
---

<Layout
  title="QuietJar - A donation button that goes quiet once the goal is met"
  description="Set a goal for a real cost. Your supporters cover it in two taps, right on your site, and the button steps aside until you need it again."
  faq={copy.faq.items}
  floatingWidget={false}>
  <Hero />
  <Features />
  <Polite />
  <Craft />
  <Pricing />
  <Faq eyebrow={copy.faq.eyebrow} title={copy.faq.title} items={copy.faq.items} />
  <Cta secondary={copy.cta.secondary} secondaryHref={localizedPath(copy.cta.secondaryHref, locale)} />
</Layout>
