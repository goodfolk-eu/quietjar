---
import { DEFAULT_COLOR, DEFAULT_CORNER, DEFAULT_HEADLINE } from "@quietjar/widget/config";
import Container from "@/components/container.astro";
import { dictionary } from "@/i18n/t";
import DashboardLayout from "@/layouts/DashboardLayout.astro";

const copy = dictionary(Astro.currentLocale ?? "en");
const widget = copy.widget;

// The snippet is pasted into a live site, so it points at the deployed bundle
// rather than the origin serving the dashboard, which is localhost in dev.
const widgetSrc = import.meta.env.PUBLIC_WIDGET_URL ?? "https://quietjar.com/js/latest/widget.js";

// Laid out as a 3-column grid, so the order matches the on-page positions.
const corners = [
  { value: "top-left", label: widget.corners.topLeft, dot: "top-1 start-1" },
  { value: "top-center", label: widget.corners.topCenter, dot: "top-1 left-1/2 -translate-x-1/2" },
  { value: "top-right", label: widget.corners.topRight, dot: "top-1 end-1" },
  { value: "bottom-left", label: widget.corners.bottomLeft, dot: "bottom-1 start-1" },
  {
    value: "bottom-center",
    label: widget.corners.bottomCenter,
    dot: "bottom-1 left-1/2 -translate-x-1/2",
  },
  { value: "bottom-right", label: widget.corners.bottomRight, dot: "bottom-1 end-1" },
];

// The swatch colour is a utility class rather than a style attribute so it
// survives the site's style-src policy, which has no unsafe-inline.
const presetColors = [
  { hex: "#0f172a", swatch: "bg-[#0f172a]" },
  { hex: "#e11d48", swatch: "bg-[#e11d48]" },
  { hex: "#f59e0b", swatch: "bg-[#f59e0b]" },
  { hex: "#059669", swatch: "bg-[#059669]" },
  { hex: "#0284c7", swatch: "bg-[#0284c7]" },
  { hex: "#7c3aed", swatch: "bg-[#7c3aed]" },
];

const fieldClass =
  "mt-2 w-full rounded-lg border border-gray-200 px-3 py-2 text-sm text-gray-800 focus:border-gray-600 focus:outline-hidden focus:ring-3 focus:ring-gray-100";
const cardClass = "rounded-xl border border-gray-200 bg-white p-5";
---

<DashboardLayout title={widget.title}>
  <Container>
    <p class="text-sm text-gray-600">{widget.intro}</p>

    <div
      id="qj-widget-settings"
      class="mt-5 grid gap-6 lg:grid-cols-5"
      data-widget-src={widgetSrc}
      data-i18n={JSON.stringify({ copy: widget.copy, copied: widget.copied, copyFailed: widget.copyFailed })}
    >
      <section class={`lg:col-span-2 ${cardClass}`}>
        <h2 class="text-base font-semibold text-gray-800">{widget.settings}</h2>

        <fieldset class="mt-5">
          <legend class="text-sm font-medium text-gray-700">{widget.position}</legend>
          <p class="mt-1 text-xs text-gray-500">{widget.positionHint}</p>
          <div class="mt-3 grid grid-cols-3 gap-3">
            {
              corners.map((corner) => (
                <button
                  type="button"
                  data-corner={corner.value}
                  aria-pressed={corner.value === DEFAULT_CORNER ? "true" : "false"}
                  aria-label={corner.label}
                  class="group rounded-lg border-2 border-gray-200 p-2 transition hover:border-gray-300 focus:outline-hidden focus-visible:ring-3 focus-visible:ring-gray-100 aria-pressed:border-gray-800"
                >
                  <span class="relative block h-12 w-full rounded-sm bg-gray-100">
                    <span
                      class:list={[
                        "absolute size-3 rounded-full bg-gray-300 transition group-aria-pressed:bg-gray-800",
                        corner.dot,
                      ]}
                    />
                  </span>
                </button>
              ))
            }
          </div>
        </fieldset>

        <fieldset class="mt-6">
          <legend class="text-sm font-medium text-gray-700">{widget.color}</legend>
          <p class="mt-1 text-xs text-gray-500">{widget.colorHint}</p>
          <div class="mt-3 flex flex-wrap gap-2">
            {
              presetColors.map((preset) => (
                <button
                  type="button"
                  data-color={preset.hex}
                  aria-pressed={preset.hex === DEFAULT_COLOR ? "true" : "false"}
                  aria-label={preset.hex}
                  class:list={[
                    "size-8 rounded-full ring-offset-2 transition focus:outline-hidden focus-visible:ring-3 focus-visible:ring-gray-200 aria-pressed:ring-2 aria-pressed:ring-gray-800",
                    preset.swatch,
                  ]}
                />
              ))
            }
          </div>
          <div class="mt-3 flex items-end gap-3">
            <div>
              <label for="qj-color-picker" class="block text-xs text-gray-500">{widget.customColor}</label>
              <input
                id="qj-color-picker"
                type="color"
                value={DEFAULT_COLOR}
                class="mt-2 h-10 w-14 cursor-pointer rounded-lg border border-gray-200 bg-white p-1"
              />
            </div>
            <div class="flex-1">
              <label for="qj-color-hex" class="block text-xs text-gray-500">{widget.hexValue}</label>
              <input
                id="qj-color-hex"
                type="text"
                spellcheck="false"
                value={DEFAULT_COLOR}
                class={`${fieldClass} font-mono`}
              />
            </div>
          </div>
        </fieldset>

        <div class="mt-6">
          <label for="qj-headline" class="block text-sm font-medium text-gray-700">{widget.headline}</label>
          <p class="mt-1 text-xs text-gray-500">{widget.headlineHint}</p>
          <input
            id="qj-headline"
            type="text"
            value={DEFAULT_HEADLINE}
            class={fieldClass}
          />
        </div>

        <button
          type="button"
          data-hs-overlay="#qj-embed-modal"
          class="mt-6 w-full rounded-lg bg-gray-800 px-4 py-2.5 text-sm font-medium text-white transition hover:bg-gray-900 focus:outline-hidden focus-visible:ring-3 focus-visible:ring-gray-200"
        >
          {widget.generate}
        </button>
      </section>

      <section class={`lg:col-span-3 ${cardClass}`}>
        <h2 class="text-base font-semibold text-gray-800">{widget.preview}</h2>
        <p class="mt-1 text-xs text-gray-500">{widget.previewHint}</p>

        <div class="mt-4 overflow-hidden rounded-xl border border-gray-200 shadow-2xs">
          <div class="flex items-center gap-2 border-b border-gray-200 bg-gray-50 px-3 py-2">
            <span class="size-2.5 rounded-full bg-gray-300"></span>
            <span class="size-2.5 rounded-full bg-gray-300"></span>
            <span class="size-2.5 rounded-full bg-gray-300"></span>
            <span class="ms-2 rounded-full bg-white px-3 py-0.5 text-xs text-gray-400">{widget.previewUrl}</span>
          </div>
          <div class="qj-preview-viewport relative overflow-hidden bg-white">
            <div id="qj-preview" class="qj-preview-page absolute start-0 top-0 bg-white p-8" inert>
              <div class="h-5 w-2/5 rounded-full bg-gray-200"></div>
              <div class="mt-6 space-y-3">
                <div class="h-3 w-full rounded-full bg-gray-100"></div>
                <div class="h-3 w-11/12 rounded-full bg-gray-100"></div>
                <div class="h-3 w-4/5 rounded-full bg-gray-100"></div>
              </div>
              <div class="mt-8 grid grid-cols-3 gap-4">
                <div class="h-20 rounded-lg bg-gray-100"></div>
                <div class="h-20 rounded-lg bg-gray-100"></div>
                <div class="h-20 rounded-lg bg-gray-100"></div>
              </div>
            </div>
          </div>
        </div>
      </section>
    </div>

    <div
      id="qj-embed-modal"
      class="hs-overlay pointer-events-none fixed start-0 top-0 z-80 hidden size-full overflow-y-auto overflow-x-hidden"
      role="dialog"
      tabindex="-1"
      aria-labelledby="qj-embed-modal-label"
    >
      <div
        class="m-3 mt-0 opacity-0 transition-all ease-out hs-overlay-open:mt-7 hs-overlay-open:opacity-100 hs-overlay-open:duration-500 sm:mx-auto sm:w-full sm:max-w-2xl"
      >
        <div class="pointer-events-auto flex flex-col rounded-xl border border-gray-200 bg-white shadow-2xs">
          <div class="flex items-center justify-between border-b border-gray-200 px-4 py-3">
            <h3 id="qj-embed-modal-label" class="font-semibold text-gray-800">{widget.embedTitle}</h3>
            <button
              type="button"
              class="inline-flex size-8 items-center justify-center rounded-full text-gray-800 hover:bg-gray-100 focus:outline-hidden focus-visible:ring-3 focus-visible:ring-gray-100"
              aria-label={widget.close}
              data-hs-overlay="#qj-embed-modal"
            >
              <span aria-hidden="true" class="text-xl leading-none">&times;</span>
            </button>
          </div>
          <div class="overflow-y-auto p-4">
            <p class="text-sm text-gray-600">{widget.embedIntro}</p>
            <pre
              class="mt-3 whitespace-pre-wrap break-all rounded-lg bg-gray-900 p-4 text-xs leading-relaxed text-gray-100"><code id="qj-snippet"></code></pre>
          </div>
          <div class="flex items-center justify-end border-t border-gray-200 px-4 py-3">
            <button
              type="button"
              id="qj-copy"
              class="rounded-lg bg-gray-800 px-4 py-2 text-sm font-medium text-white transition hover:bg-gray-900 focus:outline-hidden focus-visible:ring-3 focus-visible:ring-gray-200"
            >
              {widget.copy}
            </button>
          </div>
        </div>
      </div>
    </div>
  </Container>
</DashboardLayout>

<style>
  .qj-preview-viewport {
    aspect-ratio: 16 / 10;
  }

  /* Scaling the mock page down keeps the widget's 56px button in proportion,
     and the transform also makes this element the containing block for the
     button's position: fixed, so it stays inside the frame. */
  .qj-preview-page {
    width: 125%;
    height: 125%;
    transform: scale(0.8);
    transform-origin: top left;
  }
</style>

<script>
  import { mountWidget } from "@quietjar/widget/embed";
  import type { Corner } from "@quietjar/widget/config";
  import { DEFAULT_COLOR, DEFAULT_CORNER, DEFAULT_HEADLINE, resolveConfig } from "@quietjar/widget/config";

  const root = document.getElementById("qj-widget-settings");
  const preview = document.getElementById("qj-preview");
  const headlineInput = document.getElementById("qj-headline") as HTMLInputElement | null;
  const colorPicker = document.getElementById("qj-color-picker") as HTMLInputElement | null;
  const hexInput = document.getElementById("qj-color-hex") as HTMLInputElement | null;
  const snippetEl = document.getElementById("qj-snippet");
  const copyButton = document.getElementById("qj-copy");

  if (root && preview && headlineInput && colorPicker && hexInput && snippetEl && copyButton) {
    const labels = JSON.parse(root.dataset.i18n ?? "{}") as {
      copy: string;
      copied: string;
      copyFailed: string;
    };
    const widgetSrc = root.dataset.widgetSrc ?? "";

    const state = {
      headline: DEFAULT_HEADLINE,
      color: DEFAULT_COLOR,
      corner: DEFAULT_CORNER as Corner,
    };

    const cornerButtons = root.querySelectorAll<HTMLButtonElement>("[data-corner]");
    const swatches = root.querySelectorAll<HTMLButtonElement>("[data-color]");

    const resolved = () =>
      resolveConfig({
        labels: { headline: state.headline },
        style: { color: state.color },
        position: { corner: state.corner },
        mount: { target: preview },
      });

    function snippet(): string {
      const config = resolved();
      // Escaping "<" keeps a headline containing a closing script tag from
      // breaking out of the snippet on the site owner's page.
      const json = JSON.stringify({
        labels: { headline: config.headline },
        style: { color: config.color },
        position: { corner: config.corner },
      }).replace(/</g, "\\u003c");
      return `<script>window.QuietJar = ${json};<\/script>\n<script src="${widgetSrc}" async><\/script>`;
    }

    function render(): void {
      preview?.querySelector("[data-quietjar-host]")?.remove();
      const config = resolved();
      mountWidget(config);

      if (snippetEl) snippetEl.textContent = snippet();

      for (const button of cornerButtons) {
        button.setAttribute("aria-pressed", String(button.dataset.corner === config.corner));
      }
      for (const swatch of swatches) {
        const match = swatch.dataset.color?.toLowerCase() === config.color.toLowerCase();
        swatch.setAttribute("aria-pressed", String(match));
      }
    }

    function setColor(value: string, syncInputs: boolean): void {
      state.color = value;
      const color = resolved().color;
      // <input type="color"> only accepts 6-digit hex, so shorthand and alpha
      // values from the text field are left for the text field alone.
      if (colorPicker && /^#[0-9a-f]{6}$/i.test(color)) colorPicker.value = color;
      if (syncInputs && hexInput) hexInput.value = value;
      render();
    }

    headlineInput.addEventListener("input", () => {
      state.headline = headlineInput.value;
      render();
    });

    colorPicker.addEventListener("input", () => setColor(colorPicker.value, true));
    hexInput.addEventListener("input", () => setColor(hexInput.value.trim(), false));

    for (const swatch of swatches) {
      swatch.addEventListener("click", () => setColor(swatch.dataset.color ?? DEFAULT_COLOR, true));
    }

    for (const button of cornerButtons) {
      button.addEventListener("click", () => {
        state.corner = button.dataset.corner as Corner;
        render();
      });
    }

    let resetLabel: ReturnType<typeof setTimeout> | undefined;
    copyButton.addEventListener("click", async () => {
      clearTimeout(resetLabel);
      try {
        await navigator.clipboard.writeText(snippet());
        copyButton.textContent = labels.copied;
      } catch {
        copyButton.textContent = labels.copyFailed;
      }
      resetLabel = setTimeout(() => {
        copyButton.textContent = labels.copy;
      }, 2000);
    });

    render();
  }
</script>
