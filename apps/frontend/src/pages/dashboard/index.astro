---
import Container from "@/components/container.astro";
import DashboardLayout from "@/layouts/DashboardLayout.astro";
---

<DashboardLayout title="Dashboard">
  <Container>
    <main class="py-10">
      <div class="flex items-center justify-between">
        <h1 class="text-4xl lg:text-5xl font-bold lg:tracking-tight">Dashboard</h1>
        <button
          id="qj-sign-out"
          type="button"
          class="rounded-sm px-4 py-2 border-2 border-black text-black hover:bg-black hover:text-white transition cursor-pointer">Sign out</button>
      </div>

      Nothing here yet, check back soon!
    </main>
  </Container>
</DashboardLayout>

<script>
import { authClient } from "@/lib/api.ts";
import { api } from "@/lib/api.ts";

const loading = document.getElementById("qj-dash-loading")!;
const dataWrap = document.getElementById("qj-dash-data")!;
const sessionPre = document.getElementById("qj-session")!;
const mePre = document.getElementById("qj-me")!;
const signOut = document.getElementById("qj-sign-out") as HTMLButtonElement;

const { data: session } = await authClient.getSession();
if (!session?.user) {
  window.location.replace("/");
  throw new Error("redirecting");
}

const me = await api.api.me.get();

sessionPre.textContent = JSON.stringify(session, null, 2);
mePre.textContent = JSON.stringify({
  status: me.status,
  user: me.data?.user ?? null,
}, null, 2);

loading.classList.add("hidden");
dataWrap.classList.remove("hidden");

signOut.addEventListener("click", async () => {
  await authClient.signOut();
  window.location.href = "/";
});

</script>
