---
import Container from "@/components/container.astro";
import Layout from "@/layouts/Layout.astro";
---

<Layout title="Dashboard">
  <Container>
    <main class="py-10">
      <div class="flex items-center justify-between">
        <h1 class="text-4xl lg:text-5xl font-bold lg:tracking-tight">Dashboard</h1>
        <button
          id="qj-sign-out"
          type="button"
          class="rounded-sm px-4 py-2 border-2 border-black text-black hover:bg-black hover:text-white transition cursor-pointer">Sign out</button>
      </div>
      <p class="mt-2 text-lg text-slate-600">
        Your BetterAuth session data (used to verify the auth wiring). This page is a
        placeholder — your notes will live here next.
      </p>

      <p id="qj-dash-loading" class="mt-8 text-slate-500">Loading your session…</p>

      <div id="qj-dash-data" class="hidden mt-8 grid md:grid-cols-2 gap-6">
        <div class="rounded-lg border bg-white p-6">
          <h2 class="font-semibold text-lg">authClient.getSession()</h2>
          <pre id="qj-session" class="mt-3 text-xs text-slate-700 overflow-auto bg-slate-50 p-3 rounded"></pre>
        </div>
        <div class="rounded-lg border bg-white p-6">
          <h2 class="font-semibold text-lg">Eden /api/me</h2>
          <pre id="qj-me" class="mt-3 text-xs text-slate-700 overflow-auto bg-slate-50 p-3 rounded"></pre>
        </div>
      </div>
    </main>
  </Container>
</Layout>

<script>
import { authClient } from "../../lib/api";
import { api } from "../../lib/api";

const loading = document.getElementById("qj-dash-loading")!;
const dataWrap = document.getElementById("qj-dash-data")!;
const sessionPre = document.getElementById("qj-session")!;
const mePre = document.getElementById("qj-me")!;
const signOut = document.getElementById("qj-sign-out") as HTMLButtonElement;

const { data: session } = await authClient.getSession();
if (!session?.user) {
  window.location.replace("/");
  throw new Error("redirecting");
}

const me = await api.api.me.get();

sessionPre.textContent = JSON.stringify(session, null, 2);
mePre.textContent = JSON.stringify({
  status: me.status,
  user: me.data?.user ?? null,
}, null, 2);

loading.classList.add("hidden");
dataWrap.classList.remove("hidden");

signOut.addEventListener("click", async () => {
  await authClient.signOut();
  window.location.href = "/";
});

</script>
