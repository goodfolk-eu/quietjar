---
import Container from "@/components/container.astro";
import { dictionary } from "@/i18n/t";
import DashboardLayout from "@/layouts/DashboardLayout.astro";

const copy = dictionary(Astro.currentLocale ?? "en");
const dashboard = copy.dashboard;
const home = copy.home;

const cardClass = "rounded-xl border border-gray-200 bg-white p-5";
const selectClass =
  "rounded-lg border border-gray-200 px-2.5 py-1.5 text-sm text-gray-700 focus:border-gray-600 focus:outline-hidden focus:ring-3 focus:ring-gray-100";
const buttonClass =
  "rounded-lg border border-gray-200 bg-white px-4 py-2 text-sm font-medium text-gray-800 transition hover:bg-gray-50 focus:outline-hidden focus-visible:ring-3 focus-visible:ring-gray-200";
---

<DashboardLayout title={dashboard.title}>
  <Container>
    <div
      id="qj-home"
      class="max-w-2xl space-y-5"
      data-i18n={JSON.stringify({
        anonymous: home.anonymous,
        noMessage: home.noMessage,
        empty: home.empty,
        error: home.error,
      })}
    >
      <section class={cardClass}>
        <div class="flex items-center justify-between gap-3">
          <h2 class="text-base font-semibold text-gray-800">{home.earningsTitle}</h2>
          <select id="qj-home-period" class={selectClass} aria-label={home.earningsTitle}>
            <option value="30d" selected>{home.period30}</option>
            <option value="90d">{home.period90}</option>
            <option value="all">{home.periodAll}</option>
          </select>
        </div>
        <p id="qj-home-earnings" class="mt-3 text-3xl font-semibold tracking-tight text-gray-900 tabular-nums">
          &hellip;
        </p>
        <p class="mt-1 text-xs text-gray-500">{home.earningsHint}</p>
      </section>

      <section class={cardClass}>
        <h2 class="text-base font-semibold text-gray-800">{home.recentTitle}</h2>
        <p id="qj-home-empty" class="mt-3 text-sm text-gray-600">{home.empty}</p>
        <ul id="qj-home-list" class="mt-3 divide-y divide-gray-100"></ul>
        <button type="button" id="qj-home-more" class={`${buttonClass} mt-4 hidden`}>
          {home.loadMore}
        </button>
      </section>
    </div>
  </Container>
</DashboardLayout>

<script>
  import { api } from "@/lib/api";

  type Period = "30d" | "90d" | "all";

  interface Copy {
    anonymous: string;
    empty: string;
    error: string;
    noMessage: string;
  }

  interface RecentDonation {
    amount: number;
    currency: string;
    createdAt: number;
    email: string | null;
    name: string | null;
    message: string | null;
  }

  const root = document.getElementById("qj-home");

  void (async () => {
    if (!root) return;

    const copy = JSON.parse(root.dataset.i18n ?? "{}") as Copy;

    const periodSelect = document.getElementById("qj-home-period") as HTMLSelectElement | null;
    const earnings = document.getElementById("qj-home-earnings");
    const list = document.getElementById("qj-home-list");
    const empty = document.getElementById("qj-home-empty");
    const more = document.getElementById("qj-home-more");

    if (!(periodSelect && earnings && list && empty && more)) return;

    let offset = 0;

    function money(minor: number, currency: string): string {
      try {
        return new Intl.NumberFormat(undefined, {
          style: "currency",
          currency: currency.toUpperCase(),
        }).format(minor / 100);
      } catch {
        return `${currency.toUpperCase()} ${(minor / 100).toFixed(2)}`;
      }
    }

    /** "14:32" for today, "Sep 8" this year, "Aug 12, 2026" before that. */
    function date(ms: number): string {
      const at = new Date(ms);
      const now = new Date();
      const sameDay =
        at.getFullYear() === now.getFullYear() &&
        at.getMonth() === now.getMonth() &&
        at.getDate() === now.getDate();
      const options: Intl.DateTimeFormatOptions = sameDay
        ? { hour: "2-digit", minute: "2-digit" }
        : at.getFullYear() === now.getFullYear()
          ? { day: "numeric", month: "short" }
          : { day: "numeric", month: "short", year: "numeric" };
      return new Intl.DateTimeFormat(undefined, options).format(at);
    }

    function row(donation: RecentDonation): HTMLLIElement {
      const item = document.createElement("li");
      item.className = "py-3 first:pt-0 last:pb-0";

      const top = document.createElement("div");
      top.className = "flex items-baseline justify-between gap-3";
      const name = document.createElement("span");
      name.className = "text-sm font-medium text-gray-800";
      name.textContent = donation.name ?? copy.anonymous;
      const amount = document.createElement("span");
      amount.className = "text-sm font-medium text-gray-800 tabular-nums";
      amount.textContent = money(donation.amount, donation.currency);
      top.append(name, amount);

      const message = document.createElement("p");
      message.className = "mt-0.5 text-sm text-gray-600";
      if (donation.message === null) {
        const fallback = document.createElement("em");
        fallback.textContent = copy.noMessage;
        message.append(fallback);
      } else {
        message.textContent = donation.message;
      }

      const meta = document.createElement("p");
      meta.className = "mt-0.5 text-xs text-gray-500";
      meta.textContent = [donation.email, date(donation.createdAt)].filter(Boolean).join(" · ");

      item.append(top, message, meta);
      return item;
    }

    const loadEarnings = async (): Promise<void> => {
      const { data, error } = await api.api.donations.earnings.get({
        query: { period: periodSelect.value as Period },
      });
      // Elysia's inferred type unions the error returns with the success body.
      const body = data as { net: number; currency: string } | undefined;
      if (error || !body) {
        earnings.textContent = "–";
        return;
      }
      earnings.textContent = money(body.net, body.currency);
    };

    const loadRecent = async (): Promise<void> => {
      const { data, error } = await api.api.donations.recent.get({
        query: offset === 0 ? {} : { offset },
      });
      const body = data as { donations: RecentDonation[]; hasMore: boolean } | undefined;
      if (error || !body) {
        empty.textContent = copy.error;
        empty.hidden = false;
        more.hidden = true;
        return;
      }
      for (const donation of body.donations) list.append(row(donation));
      offset += body.donations.length;
      more.hidden = !body.hasMore;
      if (list.children.length === 0) {
        empty.textContent = copy.empty;
        empty.hidden = false;
      } else {
        empty.hidden = true;
      }
    };

    periodSelect.addEventListener("change", () => void loadEarnings());
    more.addEventListener("click", () => void loadRecent());

    await Promise.all([loadEarnings(), loadRecent()]);
  })();
</script>
