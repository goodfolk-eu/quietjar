---
import Container from "@/components/container.astro";
import { dictionary } from "@/i18n/t";
import DashboardLayout from "@/layouts/DashboardLayout.astro";

const copy = dictionary(Astro.currentLocale ?? "en");
const payments = copy.payments;

const countries = [
  { value: "AT", label: "Austria" },
  { value: "BE", label: "Belgium" },
  { value: "CH", label: "Switzerland" },
  { value: "DE", label: "Germany" },
  { value: "DK", label: "Denmark" },
  { value: "ES", label: "Spain" },
  { value: "FI", label: "Finland" },
  { value: "FR", label: "France" },
  { value: "GB", label: "United Kingdom" },
  { value: "IE", label: "Ireland" },
  { value: "IT", label: "Italy" },
  { value: "LU", label: "Luxembourg" },
  { value: "NL", label: "Netherlands" },
  { value: "NO", label: "Norway" },
  { value: "PL", label: "Poland" },
  { value: "PT", label: "Portugal" },
  { value: "SE", label: "Sweden" },
];

// Mirrors SUPPORTED_CURRENCIES in the backend, which validates what is saved.
const currencies = [
  { value: "eur", label: "Euro (EUR)" },
  { value: "gbp", label: "British pound (GBP)" },
  { value: "chf", label: "Swiss franc (CHF)" },
  { value: "dkk", label: "Danish krone (DKK)" },
  { value: "nok", label: "Norwegian krone (NOK)" },
  { value: "pln", label: "Polish zloty (PLN)" },
  { value: "sek", label: "Swedish krona (SEK)" },
];

const steps = [
  { key: "identity", copy: payments.steps.identity },
  { key: "ideal", copy: payments.steps.ideal },
  { key: "payouts", copy: payments.steps.payouts },
];

const fieldClass =
  "mt-2 w-full rounded-lg border border-gray-200 px-3 py-2 text-sm text-gray-800 focus:border-gray-600 focus:outline-hidden focus:ring-3 focus:ring-gray-100";
const cardClass = "rounded-xl border border-gray-200 bg-white p-5";
const buttonClass =
  "rounded-lg bg-gray-800 px-4 py-2.5 text-sm font-medium text-white transition hover:bg-gray-900 focus:outline-hidden focus-visible:ring-3 focus-visible:ring-gray-200 disabled:pointer-events-none disabled:opacity-50";
---

<DashboardLayout title={payments.title}>
  <Container>
    <p class="text-sm text-gray-600">{payments.intro}</p>

    <div id="qj-payments" class="mt-5 max-w-2xl space-y-5" data-i18n={JSON.stringify(payments)}>
      <p
        id="qj-pay-banner"
        class="hidden rounded-lg border border-gray-200 bg-gray-50 px-4 py-3 text-sm text-gray-700"
      >
      </p>

      <section class={cardClass}>
        <h2 class="text-base font-semibold text-gray-800">{payments.siteTitle}</h2>

        <div class="mt-5">
          <label for="qj-site-url" class="block text-sm font-medium text-gray-700">{payments.siteUrlLabel}</label>
          <p class="mt-1 text-xs text-gray-500">{payments.siteUrlHint}</p>
          <input
            id="qj-site-url"
            type="text"
            inputmode="url"
            spellcheck="false"
            placeholder="example.com"
            class={fieldClass}
          />
        </div>

        <div class="mt-6">
          <label for="qj-currency" class="block text-sm font-medium text-gray-700">{payments.currency}</label>
          <p class="mt-1 text-xs text-gray-500">{payments.currencyHint}</p>
          <select id="qj-currency" class={fieldClass}>
            {currencies.map((currency) => <option value={currency.value}>{currency.label}</option>)}
          </select>
        </div>

        <p id="qj-site-status" class="mt-3 text-xs text-gray-500" role="status" aria-live="polite"></p>
      </section>

      <section id="qj-pay-connect" class={`${cardClass} hidden`}>
        <h2 class="text-base font-semibold text-gray-800">{payments.connectTitle}</h2>
        <p class="mt-1 text-xs text-gray-500">{payments.connectIntro}</p>
        <form id="qj-pay-form" class="mt-5 space-y-4">
          <div>
            <label for="qj-pay-country" class="block text-sm font-medium text-gray-700">{payments.country}</label>
            <select id="qj-pay-country" required class={fieldClass}>
              <option value="">{payments.countryPlaceholder}</option>
              {countries.map((country) => <option value={country.value}>{country.label}</option>)}
            </select>
          </div>
          <div>
            <label for="qj-pay-entity" class="block text-sm font-medium text-gray-700">{payments.accountType}</label>
            <select id="qj-pay-entity" required class={fieldClass}>
              <option value="individual">{payments.accountTypeIndividual}</option>
              <option value="company">{payments.accountTypeCompany}</option>
            </select>
          </div>
          <button type="submit" disabled class={`${buttonClass} w-full`}>{payments.connect}</button>
          <p id="qj-pay-gate" class="text-center text-xs text-gray-500">{payments.connectNeedsSite}</p>
        </form>
      </section>

      <section id="qj-pay-steps" class={`${cardClass} hidden`}>
        <h2 class="text-base font-semibold text-gray-800">{payments.stepsTitle}</h2>
        <ol class="mt-5 space-y-4">
          {
            steps.map((step) => (
              <li class="rounded-lg border border-gray-200 p-4" data-step={step.key}>
                <div class="flex items-start justify-between gap-3">
                  <h3 class="text-sm font-semibold text-gray-800">{step.copy.title}</h3>
                  <span class="hidden shrink-0 rounded-full px-3 py-1 text-xs font-medium" data-badge />
                </div>
                <p class="mt-1 text-sm text-gray-600" data-description />
                <p class="mt-2 hidden text-sm text-red-700" data-issue />
                <button type="button" class={`${buttonClass} mt-4 hidden`} data-action>
                  {step.copy.action}
                </button>
              </li>
            ))
          }
        </ol>
        <button type="button" id="qj-pay-dashboard" class="mt-5 hidden text-sm text-qj-blue underline underline-offset-2">
          {payments.openDashboard}
        </button>
      </section>
    </div>
  </Container>
</DashboardLayout>

<script>
  import { api } from "@/lib/api";

  type StepKey = "identity" | "ideal" | "payouts";
  type StepState = "todo" | "pending" | "done" | "unavailable";
  type StepIssue = "verificationFailed" | "invalidInformation" | "needsAttention";
  type Onboarding = Record<StepKey, StepState> & {
    issues?: Partial<Record<StepKey, StepIssue>>;
  };

  type ConnectionBody = {
    connection?: { onboarding: Onboarding | null } | null;
    url?: string;
    error?: string;
  } | null;

  interface StepCopy {
    title: string;
    todo: string;
    pending: string;
    done: string;
    unavailable?: string;
    action: string;
  }

  interface Copy {
    connect: string;
    connecting: string;
    state: Record<StepState, string>;
    issues: Record<StepIssue, string>;
    steps: Record<StepKey, StepCopy>;
    bannerReturn: string;
    errorGeneric: string;
    errorNotConfigured: string;
    errorIdealUnavailable: string;
    siteUrlInvalid: string;
    saving: string;
    saved: string;
    saveFailed: string;
    errorSiteNotConfigured: string;
  }

  // The connected account is created with the site address and currency baked
  // in, so the Connect form stays locked until the site card has saved one.
  let siteConfigured = false;
  let syncConnectGate = (): void => {};

  const root = document.getElementById("qj-payments");
  const connectCard = document.getElementById("qj-pay-connect");
  const stepsCard = document.getElementById("qj-pay-steps");
  const siteUrlField = document.getElementById("qj-site-url") as HTMLInputElement | null;
  const currencyField = document.getElementById("qj-currency") as HTMLSelectElement | null;
  const siteStatusField = document.getElementById("qj-site-status");

  void (async () => {
    if (!(root && siteUrlField && currencyField && siteStatusField)) return;

    const copy = JSON.parse(root.dataset.i18n ?? "{}") as Copy;
    const siteUrlInput = siteUrlField;
    const currencySelect = currencyField;
    const siteStatus = siteStatusField;

    async function saveSite(): Promise<void> {
      siteStatus.textContent = copy.saving;
      const { data, error } = await api.api.sites.current.put({
        currency: currencySelect.value,
        siteUrl: siteUrlInput.value.trim() === "" ? null : siteUrlInput.value.trim(),
      });
      const saved = error ? undefined : data?.site;
      if (!saved) {
        siteStatus.textContent = copy.saveFailed;
        return;
      }
      // The server stores a bare origin, so show what it kept rather than what
      // was typed: that is what payments are checked against.
      siteUrlInput.value = saved.siteUrl ?? "";
      siteStatus.textContent = copy.saved;
      siteConfigured = saved.siteUrl !== null;
      syncConnectGate();
    }

    let saveTimer: ReturnType<typeof setTimeout> | undefined;
    siteUrlInput.addEventListener("input", () => {
      const value = siteUrlInput.value.trim();
      const usable = value === "" || value.includes(".");
      siteStatus.textContent = usable ? "" : copy.siteUrlInvalid;
      if (!usable) return;
      clearTimeout(saveTimer);
      saveTimer = setTimeout(() => {
        void saveSite();
      }, 600);
    });

    currencySelect.addEventListener("change", () => {
      void saveSite();
    });

    const { data, error } = await api.api.sites.current.get();
    const loaded = error ? undefined : data?.site;
    if (!loaded) return;
    currencySelect.value = loaded.currency;
    siteUrlInput.value = loaded.siteUrl ?? "";
    siteConfigured = loaded.siteUrl !== null;
    syncConnectGate();
  })();

  void (async () => {
    if (!(root && connectCard && stepsCard)) return;

    const copy = JSON.parse(root.dataset.i18n ?? "{}") as Copy;

    const banner = document.getElementById("qj-pay-banner");
    const form = document.getElementById("qj-pay-form") as HTMLFormElement | null;
    const countrySelect = document.getElementById("qj-pay-country") as HTMLSelectElement | null;
    const entitySelect = document.getElementById("qj-pay-entity") as HTMLSelectElement | null;
    const submitButton = form?.querySelector<HTMLButtonElement>("button[type=submit]") ?? null;
    const dashboardButton = document.getElementById("qj-pay-dashboard") as HTMLButtonElement | null;
    const gateHint = document.getElementById("qj-pay-gate") as HTMLElement | null;

    syncConnectGate = () => {
      if (submitButton) submitButton.disabled = !siteConfigured;
      if (gateHint) gateHint.hidden = siteConfigured;
    };
    syncConnectGate();

    const badgeStyles: Record<StepState, string> = {
      todo: "bg-gray-100 text-gray-700",
      pending: "bg-amber-100 text-amber-800",
      done: "bg-green-100 text-green-800",
      unavailable: "bg-gray-100 text-gray-500",
    };

    const show = (element: Element | null, visible: boolean) => {
      element?.classList.toggle("hidden", !visible);
    };

    function restartIfConnectionReset(body: ConnectionBody): boolean {
      if (body?.error !== "connection_reset") return false;
      window.location.reload();
      return true;
    }

    function hideBanner(): void {
      show(banner, false);
    }

    function showBanner(text: string, isError: boolean): void {
      if (!banner) return;
      banner.textContent = text;
      banner.className = isError
        ? "rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800"
        : "rounded-lg border border-green-200 bg-green-50 px-4 py-3 text-sm text-green-800";
    }

    const UNSTARTED: Onboarding = { identity: "todo", ideal: "todo", payouts: "todo", issues: {} };

    function renderSteps(status: Onboarding | null): void {
      show(connectCard, false);
      show(stepsCard, true);
      const onboarding = status ?? UNSTARTED;

      for (const key of ["identity", "ideal", "payouts"] as StepKey[]) {
        const item = stepsCard?.querySelector<HTMLElement>(`[data-step="${key}"]`);
        if (!item) continue;
        const state = onboarding[key];
        const stepCopy = copy.steps[key];

        const badge = item.querySelector<HTMLElement>("[data-badge]");
        if (badge) {
          badge.textContent = copy.state[state];
          badge.className = `shrink-0 rounded-full px-3 py-1 text-xs font-medium ${badgeStyles[state]}`;
        }

        const description = item.querySelector<HTMLElement>("[data-description]");
        if (description) {
          description.textContent =
            state === "unavailable" ? (stepCopy.unavailable ?? "") : stepCopy[state];
        }

        const issue = onboarding.issues?.[key];
        const issueLine = item.querySelector<HTMLElement>("[data-issue]");
        if (issueLine) {
          issueLine.textContent = issue ? copy.issues[issue] : "";
          show(issueLine, Boolean(issue));
        }

        show(item.querySelector("[data-action]"), state === "todo");
      }

      show(dashboardButton, onboarding.identity === "done");
    }

    async function redirectToStep(step: StepKey, button: HTMLButtonElement): Promise<void> {
      button.disabled = true;
      try {
        const { data, error } = await api.api.stripe["onboarding-link"].post({ step });
        const body = data as ConnectionBody;
        if (restartIfConnectionReset(body)) return;
        if (error || !body?.url) {
          const message =
            body?.error === "ideal_unavailable" ? copy.errorIdealUnavailable : copy.errorGeneric;
          showBanner(message, true);
          button.disabled = false;
          return;
        }
        window.location.href = body.url;
      } catch {
        showBanner(copy.errorGeneric, true);
        button.disabled = false;
      }
    }

    stepsCard.addEventListener("click", (event) => {
      const button = (event.target as HTMLElement).closest<HTMLButtonElement>("[data-action]");
      const step = button?.closest<HTMLElement>("[data-step]")?.dataset.step as StepKey | undefined;
      if (button && step) void redirectToStep(step, button);
    });

    dashboardButton?.addEventListener("click", async () => {
      dashboardButton.disabled = true;
      const { data, error } = await api.api.stripe["login-link"].post();
      const body = data as ConnectionBody;
      dashboardButton.disabled = false;
      if (restartIfConnectionReset(body)) return;
      if (error || !body?.url) {
        showBanner(copy.errorGeneric, true);
        return;
      }
      window.open(body.url, "_blank", "noopener,noreferrer");
    });

    form?.addEventListener("submit", async (event) => {
      event.preventDefault();
      if (!submitButton || !countrySelect || !entitySelect) return;
      submitButton.disabled = true;
      submitButton.textContent = copy.connecting;
      try {
        const { data, error } = await api.api.stripe.connect.post({
          country: countrySelect.value,
          entityType: entitySelect.value as "individual" | "company",
        });
        const body = data as ConnectionBody;
        if (restartIfConnectionReset(body)) return;
        if (error || !body?.url) {
          const message =
            body?.error === "stripe_not_configured"
              ? copy.errorNotConfigured
              : body?.error === "site_not_configured"
                ? copy.errorSiteNotConfigured
                : copy.errorGeneric;
          showBanner(message, true);
          return;
        }
        window.location.href = body.url;
      } finally {
        syncConnectGate();
        submitButton.textContent = copy.connect;
      }
    });

    /**
     * Account links are single use and expire within minutes, so Stripe sends
     * anyone who reloads or backs out to the refresh URL. Mint a fresh link for
     * the same step and send them straight back in.
     */
    const params = new URLSearchParams(window.location.search);
    const callback = params.get("stripe");
    const refreshStep = params.get("step") as StepKey | null;
    if (callback) history.replaceState(null, "", window.location.pathname);
    if (callback === "refresh" && refreshStep) {
      const { data } = await api.api.stripe["onboarding-link"].post({ step: refreshStep });
      const body = data as ConnectionBody;
      if (body?.url) {
        window.location.href = body.url;
        return;
      }
      showBanner(copy.errorGeneric, true);
    } else if (callback === "return") {
      showBanner(copy.bannerReturn, false);
    }

    const { data, error } = await api.api.stripe.connection.get();
    const body = (error ? null : (data as ConnectionBody)) ?? null;
    const connection = body?.connection ?? null;
    if (!connection) {
      show(connectCard, true);
      return;
    }

    async function refreshSteps(): Promise<boolean> {
      const { data, error } = await api.api.stripe["refresh-status"].post();
      const body = data as ConnectionBody;
      if (restartIfConnectionReset(body)) return false;
      if (error || !body?.connection) {
        showBanner(copy.errorGeneric, true);
        return false;
      }
      renderSteps(body.connection.onboarding);
      return true;
    }

    renderSteps(connection.onboarding);
    if (!(await refreshSteps())) return;

    // Verification usually lands a moment after the redirect, so the state we
    // read on arrival is often already stale. Checking once more means the
    // creator does not have to work out that a reload is needed.
    if (callback === "return") {
      setTimeout(() => {
        void refreshSteps().then((ok) => {
          if (ok) hideBanner();
        });
      }, 5000);
    }
  })();
</script>
