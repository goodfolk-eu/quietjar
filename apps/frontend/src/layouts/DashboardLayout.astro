---
import { locales } from "@/i18n/config";
import { dictionary } from "@/i18n/t";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const locale = Astro.currentLocale ?? "en";
const copy = dictionary(locale);

const { title = copy.meta.defaultTitle, description = copy.meta.defaultDescription } = Astro.props;

const makeTitle = title.includes("QuietJar") ? title : `${title} | QuietJar`;

// Strip any locale prefix and trailing slash so nav highlighting works for
// every locale and regardless of trailingSlash config.
const localePrefix = new RegExp(`^/(?:${locales.join("|")})(?=/|$)`);
const pathname = (Astro.url.pathname.replace(localePrefix, "") || "/").replace(/\/+$/, "") || "/";

const navLinkClass = (href: string, exact = false) => {
  const active = exact ? pathname === href : pathname === href || pathname.startsWith(`${href}/`);
  return [
    "w-full flex items-center gap-x-3.5 py-2 px-2.5 text-sm text-gray-800 rounded-lg focus:outline-hidden focus:bg-gray-100",
    active ? "bg-gray-100" : "hover:bg-gray-100",
  ].join(" ");
};
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="unless-robots-intent" content="noindex" />
    <title>{makeTitle}</title>
    <meta name="description" content={description} />
    <script is:inline defer src="https://umami.quietjar.com/script.js" data-website-id="e7abeb3d-2681-4acb-a227-e3d70ad4fda0"></script>
  </head>
  <body>
    <!-- ========== HEADER ========== -->
    <header
      class="sticky top-0 inset-x-0 flex flex-wrap md:justify-start md:flex-nowrap z-48 w-full bg-white border-b border-gray-200 text-sm py-2.5 lg:ps-65"
    >
      <nav class="px-4 sm:px-6 flex basis-full items-center w-full mx-auto">
        <div class="me-5 lg:me-0 lg:hidden flex items-center">
          <a
            class="flex-none rounded-md inline-block focus:outline-hidden focus:opacity-80"
            href="/"
            aria-label="QuietJar"
          >
            <img src="/brand/wordmark-green.svg" alt="QuietJar" width="245" height="54" class="h-8 w-auto" />
          </a>
        </div>

        <div class="w-full flex items-center justify-end ms-auto md:justify-between gap-x-1 md:gap-x-3">
          <div class="hidden md:block">
            {title}
          </div>

          <div class="flex flex-row items-center justify-end gap-1">
            <div class="hs-dropdown [--placement:bottom-right] relative inline-flex">
              <button
                id="hs-dropdown-account"
                type="button"
                class="size-9.5 inline-flex justify-center items-center gap-x-2 text-sm font-semibold rounded-full border border-transparent text-gray-800 focus:outline-hidden disabled:opacity-50 disabled:pointer-events-none"
                aria-haspopup="menu"
                aria-expanded="false"
                aria-label={copy.dashboard.dropdown}
              >
                <span
                  class="shrink-0 size-9.5 rounded-full bg-gray-100 border border-gray-200 inline-flex items-center justify-center text-gray-500"
                >
                  <svg
                    class="size-5"
                    xmlns="http://www.w3.org/2000/svg"
                    width="24"
                    height="24"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"></path>
                    <circle cx="12" cy="7" r="4"></circle>
                  </svg>
                </span>
              </button>

              <div
                class="hs-dropdown-menu transition-[opacity,margin] duration hs-dropdown-open:opacity-100 opacity-0 hidden min-w-60 bg-white border border-transparent shadow-md rounded-lg mt-2 after:h-4 after:absolute after:-bottom-4 after:start-0 after:w-full before:h-4 before:absolute before:-top-4 before:start-0 before:w-full"
                role="menu"
                aria-orientation="vertical"
                aria-labelledby="hs-dropdown-account"
              >
                <div class="py-3 px-5 bg-gray-100 rounded-t-lg">
                  <p class="text-sm text-gray-500">{copy.dashboard.signedInAs}</p>
                  <p id="qj-user-email" class="text-sm font-medium text-gray-800"></p>
                </div>
                <div class="p-1.5 space-y-0.5">
                  <button
                    type="button"
                    id="qj-sign-out"
                    class="flex w-full text-start items-center gap-x-3.5 py-2 px-3 rounded-lg text-sm text-gray-800 hover:bg-gray-100 disabled:opacity-50 disabled:pointer-events-none focus:outline-hidden focus:bg-gray-100"
                  >
                    <svg
                      class="shrink-0 size-4"
                      xmlns="http://www.w3.org/2000/svg"
                      width="24"
                      height="24"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
                      <polyline points="16 17 21 12 16 7"></polyline>
                      <line x1="21" x2="9" y1="12" y2="12"></line>
                    </svg>
                    {copy.dashboard.signOut}
                  </button>
                </div>
              </div>
            </div>
          </div>
        </div>
      </nav>
    </header>
    <!-- ========== END HEADER ========== -->

    <!-- ========== MAIN CONTENT ========== -->
    <!-- Breadcrumb -->
    <div class="sticky top-0 inset-x-0 z-20 bg-white border-y border-gray-200 px-4 sm:px-6 lg:px-8 lg:hidden">
      <div class="flex items-center py-2">
        <button
          type="button"
          class="size-8 flex justify-center items-center gap-x-2 bg-white border border-gray-200 text-gray-800 hover:text-gray-900 rounded-lg focus:outline-hidden focus:text-gray-800 disabled:opacity-50 disabled:pointer-events-none"
          aria-haspopup="dialog"
          aria-expanded="false"
          aria-controls="hs-application-sidebar"
          aria-label={copy.dashboard.toggleNavigation}
          data-hs-overlay="#hs-application-sidebar"
        >
          <span class="sr-only">{copy.dashboard.toggleNavigation}</span>
          <svg
            class="shrink-0 size-4"
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <rect width="18" height="18" x="3" y="3" rx="2"></rect>
            <path d="M15 3v18"></path>
            <path d="m8 9 3 3-3 3"></path>
          </svg>
        </button>
      </div>
    </div>
    <!-- End Breadcrumb -->

    <!-- Sidebar -->
    <div
      id="hs-application-sidebar"
      class="hs-overlay [--auto-close:lg] hs-overlay-open:translate-x-0 -translate-x-full transition-all duration-300 transform w-65 h-full hidden fixed inset-y-0 start-0 z-60 bg-white border-e border-gray-200 lg:block lg:translate-x-0 lg:end-auto lg:bottom-0"
      role="dialog"
      tabindex="-1"
      aria-label={copy.dashboard.sidebar}
    >
      <div class="relative flex flex-col h-full max-h-full">
        <div class="px-2 pt-4 flex items-center">
          <a
            class="flex-none rounded-xl inline-block focus:outline-hidden focus:opacity-80"
            href="/"
            aria-label="QuietJar"
          >
            <img src="/brand/lockup-blue-green.svg" alt="QuietJar" width="245" height="54" class="h-8 w-auto" />
          </a>
        </div>

        <div
          class="h-full overflow-y-auto [&::-webkit-scrollbar]:w-2 [&::-webkit-scrollbar-thumb]:rounded-none [&::-webkit-scrollbar-track]:bg-gray-100 [&::-webkit-scrollbar-thumb]:bg-gray-300"
        >
          <nav class="p-3 w-full flex flex-col flex-wrap">
            <ul class="flex flex-col space-y-1">
              <li>
                <a
                  class={navLinkClass("/dashboard", true)}
                  href="/dashboard"
                >
                  <svg
                    class="shrink-0 size-4"
                    xmlns="http://www.w3.org/2000/svg"
                    width="24"
                    height="24"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
                    <polyline points="9 22 9 12 15 12 15 22"></polyline>
                  </svg>
                  {copy.dashboard.title}
                </a>
              </li>

              <li>
                <a
                  class={navLinkClass("/dashboard/payments")}
                  href="/dashboard/payments"
                >
                  <svg
                    class="shrink-0 size-4"
                    xmlns="http://www.w3.org/2000/svg"
                    width="24"
                    height="24"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <rect width="20" height="14" x="2" y="5" rx="2"></rect>
                    <line x1="2" x2="22" y1="10" y2="10"></line>
                  </svg>
                  {copy.dashboard.payments}
                </a>
              </li>

              <li>
                <a
                  class={navLinkClass("/dashboard/widget")}
                  href="/dashboard/widget"
                >
                  <svg
                    class="shrink-0 size-4"
                    xmlns="http://www.w3.org/2000/svg"
                    width="24"
                    height="24"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <rect width="18" height="18" x="3" y="3" rx="2" ry="2"></rect>
                    <path d="M3 9h18"></path>
                    <path d="M9 21V9"></path>
                  </svg>
                  {copy.dashboard.widget}
                </a>
              </li>
            </ul>
          </nav>
        </div>
      </div>
    </div>
    <!-- End Sidebar -->

    <!-- Content -->
    <div class="w-full lg:ps-64">
      <div class="p-4 sm:p-6 space-y-4 sm:space-y-6">
        <slot />
      </div>
    </div>
    <!-- End Content -->

    <script>
      // Import only the Preline plugins this layout uses. Importing the "preline"
      // barrel pulls in every plugin (apexcharts, datatables, dropzone, ...) as one
      // pre-bundled, side-effectful chunk that cannot be tree-shaken (~376 kB).
      import "preline/plugins/overlay";
      import "preline/plugins/dropdown";
      import { authClient } from "@/lib/api.ts";

      const { data: session } = await authClient.getSession();
      if (!session?.user) {
        window.location.replace("/");
        throw new Error("redirecting");
      }

      const userEmail = document.getElementById("qj-user-email");
      if (userEmail) userEmail.textContent = session.user.email ?? "";

      const signOut = document.getElementById("qj-sign-out") as HTMLButtonElement | null;

      signOut?.addEventListener("click", async () => {
        await authClient.signOut();
        window.location.href = "/";
      });
    </script>
  </body>
</html>

<style is:global>
  img {
    content-visibility: auto;
  }
</style>
