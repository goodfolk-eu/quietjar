{
  "name": "quietjar",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "bun run dev:backend & bun run dev:frontend",
    "dev:backend": "bun --cwd apps/backend dev",
    "dev:frontend": "bun --cwd apps/frontend dev",
    "dev:widget": "bun --cwd apps/widget dev",
    "build": "bun run build:backend && bun run build:widget && bun run build:frontend",
    "build:backend": "bun --cwd apps/backend build",
    "build:widget": "bun --cwd apps/widget build",
    "build:frontend": "bun --cwd apps/frontend build",
    "deploy": "bun run deploy:backend && bun run deploy:frontend",
    "deploy:backend": "bun --cwd apps/backend deploy",
    "deploy:frontend": "bun --cwd apps/frontend deploy",
    "test": "bun run test:widget",
    "test:widget": "bun --cwd apps/widget test",
    "lint": "bunx --bun biome check .",
    "lint:fix": "bunx --bun biome check --write .",
    "format": "bunx --bun biome format --write .",
    "format:check": "bunx --bun biome format .",
    "prepare": "git rev-parse --git-dir >/dev/null 2>&1 && git config core.hooksPath scripts/hooks || true"
  },
  "overrides": {
    "@libsql/client": "0.8.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.10",
    "typescript": "^6.0.0"
  }
}
